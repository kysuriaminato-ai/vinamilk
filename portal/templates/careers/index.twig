<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ canonicalUrl }}">

  <!-- Multi-language Hreflang Tags -->
  <link rel="alternate" hreflang="vi-vn" href="{{ canonicalUrl }}">
  <link rel="alternate" hreflang="en" href="{{ canonicalUrl }}?lang=en">
  <link rel="alternate" hreflang="x-default" href="{{ canonicalUrl }}">

  <!-- Open Graph Meta Tags -->
  <meta property="og:site_name" content="Vinamilk Careers">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://hrm.vinamilk.com.vn/dist/assets/careers-og.webp">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="vi_VN">
  <meta property="og:locale:alternate" content="en_US">

  <!-- Twitter Card Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  <meta name="twitter:image" content="https://hrm.vinamilk.com.vn/dist/assets/careers-og.webp">

  <!-- Font Preload & Display Swap for Core Web Vitals (LCP < 2.5s) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Critical CSS Inlined for Fast First Contentful Paint -->
  <style>
    :root {
      --vnm-primary: #0033A0;
      --vnm-primary-dark: #00227A;
      --vnm-bg: #F8F9FA;
      --vnm-surface: #FFFFFF;
      --vnm-text-main: #1E293B;
      --vnm-text-muted: #64748B;
      --vnm-border: #E2E8F0;
      --vnm-success: #10B981;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Be Vietnam Pro', system-ui, sans-serif; background-color: var(--vnm-bg); color: var(--vnm-text-main); line-height: 1.6; }
    .skip-link { position: absolute; top: -40px; left: 0; background: var(--vnm-primary); color: white; padding: 8px 16px; z-index: 100; transition: top 0.2s; }
    .skip-link:focus { top: 0; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
    .hero-banner { background: linear-gradient(135deg, #00227A 0%, #0033A0 60%, #0284C7 100%); color: white; padding: 60px 0; }
    .job-card { background: var(--vnm-surface); border: 1px solid var(--vnm-border); border-radius: 12px; padding: 24px; transition: transform 0.2s, box-shadow 0.2s; margin-bottom: 16px; }
    .job-card:hover { transform: translateY(-3px); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
    .badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; }
    .badge-primary { background: #E0F2FE; color: #0369A1; }
    .badge-salary { background: #D1FAE5; color: #047857; font-variant-numeric: tabular-nums; font-weight: 700; }
    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 10px 20px; border-radius: 8px; font-weight: 600; text-decoration: none; cursor: pointer; border: none; font-size: 0.9375rem; }
    .btn-primary { background: var(--vnm-primary); color: white; }
    .btn-primary:hover { background: var(--vnm-primary-dark); }
    :focus-visible { outline: 3px solid var(--vnm-primary); outline-offset: 2px; }
  </style>

  <!-- Production Vite Bundles (Deferred) -->
  <link rel="stylesheet" href="{{ vite_asset('app.scss') }}" media="print" onload="this.media='all'">

  <!-- JSON-LD Schema.org Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Công Ty Cổ Phần Sữa Việt Nam (Vinamilk)",
    "url": "https://www.vinamilk.com.vn",
    "logo": "https://hrm.vinamilk.com.vn/dist/assets/vinamilk-logo.png",
    "sameAs": [
      "https://www.facebook.com/vinamilkofficial",
      "https://www.linkedin.com/company/vinamilk"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+84-28-5415-5555",
      "contactType": "recruitment",
      "areaServed": "VN",
      "availableLanguage": ["Vietnamese", "English"]
    }
  }
  </script>
</head>
<body>
  <!-- WCAG 2.2 AA Skip Link -->
  <a href="#main-content" class="skip-link">Chuyển đến nội dung chính</a>

  <!-- Header -->
  <header style="background: var(--vnm-surface); border-bottom: 1px solid var(--vnm-border); padding: 16px 0;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
      <a href="/tuyen-dung" style="display: flex; align-items: center; gap: 10px; text-decoration: none;" aria-label="Trang chủ Tuyển Dụng Vinamilk">
        <div style="width: 40px; height: 40px; background: var(--vnm-primary); color: white; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.5rem;">V</div>
        <div>
          <div style="font-weight: 700; font-size: 1.25rem; color: var(--vnm-primary); letter-spacing: 0.5px;">VINAMILK CAREERS</div>
          <div style="font-size: 0.6875rem; color: var(--vnm-text-muted);">Vươn Cao Việt Nam · Nơi Hội Tụ Nhân Tài</div>
        </div>
      </a>
      <nav aria-label="Điều hướng tuyển dụng">
        <a href="/login" class="btn" style="background: transparent; color: var(--vnm-primary); border: 1px solid var(--vnm-primary); padding: 8px 16px;">Đăng Nhập Nội Bộ</a>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero-banner">
    <div class="container" style="text-align: center;">
      <h1 style="font-size: 2.25rem; font-weight: 700; margin-bottom: 12px;">Đồng Hành Cùng Vinamilk — Kiến Tạo Tương Lai Dinh Dưỡng</h1>
      <p style="font-size: 1.125rem; opacity: 0.9; max-width: 720px; margin: 0 auto 24px;">
        Gia nhập đội ngũ hơn 10.000 cán bộ nhân viên với môi trường làm việc chuẩn quốc tế, chế độ đãi ngộ hàng đầu thị trường.
      </p>
    </div>
  </section>

  <!-- Main Content: Job List -->
  <main id="main-content" class="container" style="padding-top: 40px; padding-bottom: 60px;">
    <div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
      <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--vnm-text-main);">Vị Trí Đang Tuyển Dụng ({{ jobs | length }})</h2>
      <div style="font-size: 0.875rem; color: var(--vnm-text-muted);">Cập nhật liên tục từ Ban Quản Trị Nhân Sự</div>
    </div>

    <div>
      {% for j in jobs %}
        <article class="job-card" itemscope itemtype="https://schema.org/JobPosting">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
            <div style="flex: 1; min-width: 280px;">
              <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 6px;">
                <a href="/tuyen-dung/{{ j.slug }}-{{ j.id }}" style="color: var(--vnm-primary); text-decoration: none;" itemprop="title">
                  {{ j.title }}
                </a>
              </h3>
              <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; font-size: 0.875rem; color: var(--vnm-text-muted);">
                <span>🏢 {{ j.department }}</span>
                <span>📍 {{ j.city }}</span>
                <span>⏱️ {{ j.employmentType }}</span>
              </div>
            </div>

            <div style="text-align: right;">
              <span class="badge badge-salary" itemprop="baseSalary">{{ j.salaryDisplay }}</span>
              <div style="margin-top: 12px;">
                <a href="/tuyen-dung/{{ j.slug }}-{{ j.id }}" class="btn btn-primary" style="padding: 8px 16px; font-size: 0.875rem;">
                  Xem Chi Tiết & Ứng Tuyển
                </a>
              </div>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </main>

  <!-- Footer -->
  <footer style="background: var(--vnm-surface); border-top: 1px solid var(--vnm-border); padding: 40px 0; text-align: center; font-size: 0.875rem; color: var(--vnm-text-muted);">
    <div class="container">
      <p>Bản quyền © 2026 Tập Đoàn Vinamilk. Bảo lưu mọi quyền.</p>
      <p style="margin-top: 6px;">Trụ sở: Số 10 Tân Trào, Phường Tân Phú, Quận 7, TP. Hồ Chí Minh</p>
    </div>
  </footer>

  <!-- Telemetry: Web Vitals RUM Script -->
  <script defer src="/dist/js/telemetry.js"></script>
</body>
</html>