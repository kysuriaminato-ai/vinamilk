<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ canonicalUrl }}">

  <!-- Multi-language Hreflang Tags -->
  <link rel="alternate" hreflang="vi-vn" href="{{ canonicalUrl }}">
  <link rel="alternate" hreflang="en" href="{{ canonicalUrl }}?lang=en">
  <link rel="alternate" hreflang="x-default" href="{{ canonicalUrl }}">

  <!-- Open Graph Meta Tags -->
  <meta property="og:site_name" content="Vinamilk Careers">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:type" content="article">
  <meta property="og:image" content="https://hrm.vinamilk.com.vn/dist/assets/careers-og.webp">
  <meta property="og:locale" content="vi_VN">

  <!-- Twitter Card Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  <meta name="twitter:image" content="https://hrm.vinamilk.com.vn/dist/assets/careers-og.webp">

  <!-- Font Preload & Display Swap -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Critical Styles -->
  <style>
    :root {
      --vnm-primary: #0033A0;
      --vnm-primary-dark: #00227A;
      --vnm-bg: #F8F9FA;
      --vnm-surface: #FFFFFF;
      --vnm-text-main: #1E293B;
      --vnm-text-muted: #64748B;
      --vnm-border: #E2E8F0;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Be Vietnam Pro', system-ui, sans-serif; background-color: var(--vnm-bg); color: var(--vnm-text-main); line-height: 1.6; }
    .container { max-width: 1000px; margin: 0 auto; padding: 0 20px; }
    .breadcrumbs { display: flex; gap: 8px; font-size: 0.8125rem; color: var(--vnm-text-muted); padding: 16px 0; }
    .breadcrumbs a { color: var(--vnm-primary); text-decoration: none; }
    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; cursor: pointer; border: none; font-size: 1rem; }
    .btn-primary { background: var(--vnm-primary); color: white; }
    .btn-primary:hover { background: var(--vnm-primary-dark); }
    .job-section { margin-bottom: 24px; }
    .job-section h3 { font-size: 1.125rem; font-weight: 700; color: var(--vnm-primary); margin-bottom: 8px; }
    .job-section ul { padding-left: 20px; }
    .job-section li { margin-bottom: 6px; }
  </style>

  <!-- JSON-LD Schema.org JobPosting (Rich Results Test 100% Compliant) -->
  <script type="application/ld+json">
  {{ jsonLd | raw }}
  </script>

  <!-- JSON-LD BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Trang Chủ Tuyển Dụng",
        "item": "https://hrm.vinamilk.com.vn/tuyen-dung"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ job.title }}",
        "item": "{{ canonicalUrl }}"
      }
    ]
  }
  </script>
</head>
<body>
  <!-- Header -->
  <header style="background: var(--vnm-surface); border-bottom: 1px solid var(--vnm-border); padding: 16px 0;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
      <a href="/tuyen-dung" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
        <div style="width: 36px; height: 36px; background: var(--vnm-primary); color: white; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700;">V</div>
        <span style="font-weight: 700; font-size: 1.125rem; color: var(--vnm-primary);">VINAMILK CAREERS</span>
      </a>
      <a href="/tuyen-dung" style="font-size: 0.875rem; color: var(--vnm-primary); text-decoration: none; font-weight: 500;">← Xem tất cả vị trí</a>
    </div>
  </header>

  <!-- Main Container -->
  <main class="container" style="padding-top: 20px; padding-bottom: 60px;">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/tuyen-dung">Tuyển Dụng</a>
      <span>/</span>
      <span style="color: var(--vnm-text-muted);">{{ job.department }}</span>
      <span>/</span>
      <span style="color: var(--vnm-text-main); font-weight: 600;">{{ job.title }}</span>
    </nav>

    <!-- Job Header Card -->
    <div style="background: var(--vnm-surface); border: 1px solid var(--vnm-border); border-radius: 12px; padding: 32px; margin-bottom: 24px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px;">
        <div>
          <span style="display: inline-block; background: #E0F2FE; color: #0369A1; padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; margin-bottom: 8px;">
            Mã vị trí: {{ job.jobCode }}
          </span>
          <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--vnm-text-main); margin-bottom: 8px;">{{ job.title }}</h1>
          <div style="display: flex; gap: 16px; flex-wrap: wrap; font-size: 0.9375rem; color: var(--vnm-text-muted);">
            <span>🏢 {{ job.department }}</span>
            <span>📍 {{ job.workLocation }}</span>
            <span>📅 Hạn nộp: {{ job.validThrough | format_date }}</span>
          </div>
        </div>

        <div style="text-align: right;">
          <div style="font-size: 1.375rem; font-weight: 700; color: #047857; margin-bottom: 12px; font-variant-numeric: tabular-nums;">
            {{ job.salaryDisplay }}
          </div>
          <a href="#apply-form" class="btn btn-primary">Ứng Tuyển Ngay</a>
        </div>
      </div>
    </div>

    <!-- Job Content Details -->
    <div style="background: var(--vnm-surface); border: 1px solid var(--vnm-border); border-radius: 12px; padding: 32px;">
      <div class="job-section">
        <h3>Mô Tả Công Việc</h3>
        <div>{{ job.description | raw }}</div>
      </div>

      <div class="job-section">
        <h3>Yêu Cầu Tuyển Dụng</h3>
        <div>{{ job.requirements | raw }}</div>
      </div>

      <div class="job-section">
        <h3>Chế Độ Đãi Ngộ & Phúc Lợi</h3>
        <div>{{ job.benefits | raw }}</div>
      </div>

      <!-- Application Form (WCAG 2.2 AA Accessible) -->
      <div id="apply-form" style="border-top: 1px solid var(--vnm-border); padding-top: 32px; margin-top: 32px;">
        <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 16px;">Ứng Tuyển Trực Tuyến</h3>
        <form style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <label for="fullName" style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 4px;">Họ và tên *</label>
            <input type="text" id="fullName" name="fullName" required style="width: 100%; padding: 10px 14px; border: 1px solid var(--vnm-border); border-radius: 8px;">
          </div>
          <div>
            <label for="email" style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 4px;">Email liên hệ *</label>
            <input type="email" id="email" name="email" required style="width: 100%; padding: 10px 14px; border: 1px solid var(--vnm-border); border-radius: 8px;">
          </div>
          <div>
            <label for="phone" style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 4px;">Số điện thoại *</label>
            <input type="tel" id="phone" name="phone" required style="width: 100%; padding: 10px 14px; border: 1px solid var(--vnm-border); border-radius: 8px;">
          </div>
          <div>
            <label for="resume" style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 4px;">Tải lên CV (PDF, DOCX) *</label>
            <input type="file" id="resume" name="resume" accept=".pdf,.doc,.docx" required style="width: 100%; padding: 8px; border: 1px solid var(--vnm-border); border-radius: 8px;">
          </div>
          <div style="grid-column: span 2; margin-top: 8px;">
            <button type="button" class="btn btn-primary" style="width: 100%;" onclick="alert('Cảm ơn bạn đã ứng tuyển! Hồ sơ đã được chuyển đến Ban Tuyển Dụng Vinamilk.')">
              Nộp Hồ Sơ Ứng Tuyển
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</body>
</html>