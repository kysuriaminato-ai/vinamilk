{% extends "layouts/base.twig" %}
{% block title %}Cổng Nhân Viên (ESS) — Vinamilk HRM{% endblock %}
{% block breadcrumb %}Cổng Tự Phục Vụ Nhân Viên (ESS){% endblock %}

{% block content %}
<div style="max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px;">

  <!-- Mobile Employee Profile Card -->
  <div class="vnm-card" style="background: linear-gradient(135deg, var(--vnm-primary) 0%, #0284C7 100%); color: white; padding: 24px;">
    <div style="display: flex; align-items: center; gap: 16px;">
      <div style="width: 54px; height: 54px; border-radius: 50%; background: white; color: var(--vnm-primary); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700;">MT</div>
      <div>
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 2px;">Mai Thị Thu Trang</h2>
        <div style="font-size: 0.8125rem; opacity: 0.9;">Mã NV: VNM-00188 · Ban Quản Trị Nhân Sự</div>
      </div>
    </div>
  </div>

  <!-- GPS Check-In Action Card -->
  <div class="vnm-card" style="text-align: center; padding: 32px 20px;">
    <div style="width: 64px; height: 64px; background: #E0F2FE; color: var(--vnm-primary); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 4px;">Chấm Công Trực Tuyến GPS</h3>
    <p style="font-size: 0.8125rem; color: var(--vnm-text-muted); margin-bottom: 16px;">
      Vị trí hiện tại: <strong>Trụ sở chính Vinamilk, Q.7, TP.HCM</strong> (Khoảng cách: 25m - Hợp lệ)
    </p>
    <button class="btn btn-primary" style="width: 100%; max-width: 280px; padding: 12px; font-weight: 600; font-size: 1rem;">
      Ghi Nhận Chấm Công
    </button>
  </div>

  <!-- Quick Self-Service Links -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
    <a href="/attendance/matrix" class="vnm-card hover-lift" style="text-align: center; padding: 16px; text-decoration: none; color: var(--vnm-text-main);">
      <div style="font-size: 1.5rem; margin-bottom: 6px;">📅</div>
      <div style="font-weight: 600; font-size: 0.875rem;">Lịch Ca Của Tôi</div>
      <div style="font-size: 0.75rem; color: var(--vnm-text-muted);">Tuần này: 5 ca</div>
    </a>
    <a href="/payroll" class="vnm-card hover-lift" style="text-align: center; padding: 16px; text-decoration: none; color: var(--vnm-text-main);">
      <div style="font-size: 1.5rem; margin-bottom: 6px;">💵</div>
      <div style="font-weight: 600; font-size: 0.875rem;">Phiếu Lương Tháng</div>
      <div style="font-size: 0.75rem; color: var(--vnm-text-muted);">Tháng 09/2026</div>
    </a>
    <a href="/approvals" class="vnm-card hover-lift" style="text-align: center; padding: 16px; text-decoration: none; color: var(--vnm-text-main);">
      <div style="font-size: 1.5rem; margin-bottom: 6px;">📝</div>
      <div style="font-weight: 600; font-size: 0.875rem;">Đơn Từ Online</div>
      <div style="font-size: 0.75rem; color: var(--vnm-text-muted);">Nghỉ phép, đổi ca</div>
    </a>
    <a href="/kpi/kanban" class="vnm-card hover-lift" style="text-align: center; padding: 16px; text-decoration: none; color: var(--vnm-text-main);">
      <div style="font-size: 1.5rem; margin-bottom: 6px;">🎯</div>
      <div style="font-weight: 600; font-size: 0.875rem;">KPI Cá Nhân</div>
      <div style="font-size: 0.75rem; color: var(--vnm-text-muted);">Tiến độ 92%</div>
    </a>
  </div>

</div>
{% endblock %}