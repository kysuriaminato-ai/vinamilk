<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="view-transition" content="same-origin">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <meta name="theme-color" content="#0033A0">
  <link rel="manifest" href="/manifest.json">
  <title>{% block title %}Vinamilk HRM — Hệ Thống Quản Trị Doanh Nghiệp{% endblock %}</title>
  
  <!-- Typography: Be Vietnam Pro Font Preload & Swap -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Production Vite Bundles (Styles) -->
  <link rel="stylesheet" href="{{ vite_asset('app.scss') }}">

  <style>
    /* WCAG 2.2 AA Accessibility & Focus Ring */
    .skip-link {
      position: absolute;
      top: -50px;
      left: 10px;
      background: var(--vnm-primary);
      color: #FFFFFF;
      padding: 10px 20px;
      border-radius: var(--vnm-radius-md);
      z-index: 999;
      font-weight: 600;
      transition: top 0.2s ease;
      text-decoration: none;
    }
    .skip-link:focus {
      top: 10px;
      outline: 3px solid #F59E0B;
    }
    :focus-visible {
      outline: 3px solid var(--vnm-primary);
      outline-offset: 2px;
    }
  </style>

  {% block styles %}{% endblock %}
</head>
<body x-data="themeToggle()">
  <!-- Skip to Main Content Link (WCAG 2.2 AA) -->
  <a href="#main-content" class="skip-link">Chuyển đến nội dung chính (Skip to content)</a>

  <div class="app-wrapper" x-data="{ sidebarCollapsed: false }">
    
    <!-- Sidebar Thu Gọn Được -->
    <aside class="app-sidebar" :class="{ 'collapsed': sidebarCollapsed }" aria-label="Thanh điều hướng chính">
      <div style="height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid var(--vnm-border);">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 36px; height: 36px; background-color: var(--vnm-primary); color: white; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem;">V</div>
          <span class="sidebar-text" style="font-weight: 700; font-size: 1.125rem; color: var(--vnm-primary); letter-spacing: 0.5px;">VINAMILK</span>
        </div>
        <button type="button" @click="sidebarCollapsed = !sidebarCollapsed" style="background: none; border: none; cursor: pointer; color: var(--vnm-text-muted); padding: 4px;" aria-label="Thu gọn hoặc mở rộng thanh điều hướng">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
      </div>

      <nav style="flex: 1; padding: 16px 12px; display: flex; flex-direction: column; gap: 4px; overflow-y: auto;">
        <a href="/dashboard/executive" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/dashboard/executive' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span class="sidebar-text">Dashboard Điều Hành</span>
        </a>
        <a href="/dashboard/unit" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/dashboard/unit' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span class="sidebar-text">Dashboard Đơn Vị</span>
        </a>
        <a href="/employees" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/employees' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="sidebar-text">Hồ Sơ Nhân Sự</span>
        </a>
        <a href="/org" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/org' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <span class="sidebar-text">Cơ Cấu Tổ Chức</span>
        </a>
        <a href="/attendance/matrix" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/attendance/matrix' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span class="sidebar-text">Phân Ca & Chấm Công</span>
        </a>
        <a href="/approvals" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/approvals' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <span class="sidebar-text">Hộp Duyệt Chung</span>
        </a>
        <a href="/kpi/kanban" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/kpi/kanban' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
          <span class="sidebar-text">Quản Trị KPI</span>
        </a>
        <a href="/payroll" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/payroll' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <span class="sidebar-text">Kỳ Lương & Phiếu Lương</span>
        </a>
        <a href="/salary-review" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/salary-review' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <span class="sidebar-text">Xét Tăng Lương</span>
        </a>
        <a href="/analytics" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/analytics' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          <span class="sidebar-text">Vị Thế Thị Trường</span>
        </a>
        <a href="/settings" class="btn btn-outline" style="justify-content: flex-start; border: none; {% if current_path == '/settings' %}background-color: var(--vnm-primary-light); color: var(--vnm-primary); font-weight: 600;{% endif %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span class="sidebar-text">Cài Đặt Pháp Lý</span>
        </a>
      </nav>

      <div style="padding: 16px; border-top: 1px solid var(--vnm-border);">
        <a href="/self-service" class="btn btn-outline" style="width: 100%; justify-content: flex-start; border: 1px dashed var(--vnm-primary); color: var(--vnm-primary);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 18h.01"/><path d="M8 21h8a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2z"/></svg>
          <span class="sidebar-text">Cổng Nhân Viên (ESS)</span>
        </a>
      </div>
    </aside>

    <!-- Main Container -->
    <main class="app-main" id="main-content" role="main">
      <!-- Topbar -->
      <header class="app-topbar">
        <div style="display: flex; align-items: center; gap: 16px;">
          <!-- Scope Selector -->
          <div style="display: flex; align-items: center; gap: 8px; background: var(--vnm-bg); padding: 6px 12px; border-radius: var(--vnm-radius-md); border: 1px solid var(--vnm-border);" aria-label="Đơn vị hiện tại">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span style="font-size: 0.8125rem; font-weight: 600; color: var(--vnm-text-main);">{{ current_unit }}</span>
          </div>

          <!-- Ctrl+K Search Trigger -->
          <button type="button" @click="$dispatch('open-command-palette')" class="btn btn-outline" style="padding: 6px 12px; font-size: 0.8125rem; color: var(--vnm-text-muted);" aria-label="Mở hộp tìm kiếm nhanh (Ctrl+K)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Tìm kiếm...</span>
            <kbd style="background: var(--vnm-bg); padding: 2px 6px; border-radius: 4px; font-size: 0.75rem; border: 1px solid var(--vnm-border);">Ctrl+K</kbd>
          </button>
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
          <!-- Theme Toggle Button -->
          <button type="button" @click="toggle()" class="btn btn-outline" style="padding: 8px;" title="Chuyển chế độ sáng/tối" aria-label="Chuyển đổi giao diện sáng tối">
            <template x-if="theme === 'light'">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </template>
            <template x-if="theme === 'dark'">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </template>
          </button>

          <!-- User Menu -->
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--vnm-primary-light); color: var(--vnm-primary); display: flex; align-items: center; justify-content: center; font-weight: 600;" aria-label="Ảnh đại diện">MT</div>
            <div style="display: flex; flex-direction: column;">
              <span style="font-size: 0.8125rem; font-weight: 600;">Mai Thị Thu Trang</span>
              <span style="font-size: 0.6875rem; color: var(--vnm-text-muted);">CHRO · Executive</span>
            </div>
            <a href="/logout" class="btn btn-outline" style="padding: 6px 10px; font-size: 0.75rem; margin-left: 8px;">Đăng xuất</a>
          </div>
        </div>
      </header>

      <!-- Breadcrumbs -->
      <nav style="padding: 12px 24px; font-size: 0.8125rem; color: var(--vnm-text-muted); display: flex; align-items: center; gap: 6px;" aria-label="Thanh chỉ mục điều hướng">
        <a href="/dashboard/executive" style="color: var(--vnm-text-muted);">Trang chủ</a>
        <span aria-hidden="true">/</span>
        <span style="color: var(--vnm-text-main); font-weight: 500;">{% block breadcrumb %}Hệ Thống Quản Trị{% endblock %}</span>
      </nav>

      <!-- Page Content -->
      <div class="page-content">
        {% block content %}{% endblock %}
      </div>
    </main>

    <!-- Command Palette (Ctrl+K) -->
    <div x-data="commandPalette()" x-show="isOpen" @open-command-palette.window="isOpen = true" class="vnm-command-palette" style="display: none;" role="dialog" aria-modal="true" aria-label="Hộp lệnh tìm kiếm nhanh">
      <div class="command-box" @click.outside="isOpen = false">
        <input type="text" x-model="search" placeholder="Nhập tên chức năng hoặc màn hình cần tìm... (Esc để đóng)" autofocus aria-label="Nhập từ khóa tìm kiếm chức năng">
        <div style="max-height: 320px; overflow-y: auto; padding: 8px;">
          <template x-for="item in filteredItems()" :key="item.url">
            <a :href="item.url" style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-radius: var(--vnm-radius-md); text-decoration: none; color: var(--vnm-text-main);" class="hover-lift">
              <span x-text="item.title" style="font-weight: 500;"></span>
              <span class="vnm-badge badge-submitted" x-text="item.category"></span>
            </a>
          </template>
        </div>
      </div>
    </div>

    <!-- Mobile Bottom Navigation for ESS (< 768px) -->
    <nav class="mobile-bottom-nav" aria-label="Điều hướng nhanh trên điện thoại">
      <a href="/dashboard/executive" class="nav-item {% if current_path == '/dashboard/executive' %}active{% endif %}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        <span>Tổng quan</span>
      </a>
      <a href="/self-service" class="nav-item {% if current_path == '/self-service' %}active{% endif %}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Chấm công</span>
      </a>
      <a href="/attendance/matrix" class="nav-item {% if current_path == '/attendance/matrix' %}active{% endif %}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/></svg>
        <span>Lịch ca</span>
      </a>
      <a href="/approvals" class="nav-item {% if current_path == '/approvals' %}active{% endif %}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <span>Đơn từ</span>
      </a>
      <a href="/payroll" class="nav-item {% if current_path == '/payroll' %}active{% endif %}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <span>Phiếu lương</span>
      </a>
    </nav>

    <!-- Toast Notifications System -->
    <div x-data="toastManager()" class="vnm-toast-container" aria-live="polite">
      <template x-for="t in toasts" :key="t.id">
        <div class="vnm-toast" :class="'toast-' + t.type">
          <span x-text="t.message"></span>
        </div>
      </template>
    </div>

  </div>

  <!-- Production Vite Bundles (JS) -->
  <script type="module" src="{{ vite_asset('app.js') }}"></script>
  
  <!-- Register PWA Service Worker (No Payroll Cache) -->
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').then((reg) => {
          console.log('[Vinamilk PWA] Service Worker registered successfully:', reg.scope);
        }).catch((err) => {
          console.warn('[Vinamilk PWA] Service Worker registration failed:', err);
        });
      });
    }
  </script>

  <!-- Telemetry: Web Vitals RUM Script -->
  <script defer src="/dist/js/telemetry.js"></script>

  {% block scripts %}{% endblock %}
</body>
</html>