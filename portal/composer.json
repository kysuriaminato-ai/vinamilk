{
  "name": "vinamilk/portal",
  "description": "Vinamilk HRM Enterprise Frontend Portal (PHP + Twig + HTMX + Alpine.js)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "twig/twig": "^3.8",
    "guzzlehttp/guzzle": "^7.8",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Portal\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {}
  }
}