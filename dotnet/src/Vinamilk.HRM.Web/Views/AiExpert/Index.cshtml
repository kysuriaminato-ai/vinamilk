@using Vinamilk.HRM.Application.Analytics
@model AiExpertOverviewDto
@{
    ViewData["Title"] = "AI HR Expert (RAG & Dự báo Nhân sự)";
    var policyAnswer = ViewBag.PolicyAnswer as AiPolicyAnswerDto;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-extrabold mb-1"><i class="ti ti-sparkles me-2 text-primary"></i>Chuyên gia AI Nhân sự (AI HR Expert)</h2>
        <p class="text-muted mb-0">Kiến trúc Provider hoán đổi (<code>@Model.ActiveProvider</code>) • RAG Chính sách nội bộ • Khớp Ứng viên • Dự báo Nghỉ việc</p>
    </div>
    <form asp-action="ScanAttrition" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary fw-semibold">
            <i class="ti ti-radar me-1"></i>Quét & Lưu Cảnh báo Nghỉ việc
        </button>
    </form>
</div>

@if (TempData["AiMessage"] is string aiMsg)
{
    <div class="alert alert-info alert-dismissible fade show">
        <i class="ti ti-info-circle me-2"></i>@aiMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <!-- RAG POLICY CHATBOT -->
    <div class="col-12 col-lg-6">
        <div class="vnm-card p-3 h-100">
            <h5 class="fw-bold mb-2"><i class="ti ti-message-chatbot me-2 text-primary"></i>Chatbot RAG Chính sách Nhân sự & BLLĐ 2019</h5>
            <p class="text-muted fs-7 mb-3">Hỏi về: Nghỉ phép năm, Tăng ca (OT), BHXH & Thuế TNCN, Thử việc 85%, Đánh giá KPI...</p>

            <form asp-action="AskPolicy" method="post" class="d-flex gap-2 mb-3">
                @Html.AntiForgeryToken()
                <input type="text" name="question" class="form-control" value="@policyAnswer?.Question"
                       placeholder="Ví dụ: Nghỉ phép năm được mấy ngày? Hoặc tỷ lệ đóng BHXH?" required />
                <button type="submit" class="btn btn-primary px-3"><i class="ti ti-send"></i></button>
            </form>

            <div class="d-flex flex-wrap gap-1 mb-3">
                @foreach (var sample in new[] { "Nghỉ phép năm được mấy ngày?", "Lương tăng ca OT tính thế nào?", "Tỷ lệ đóng BHXH và giảm trừ thuế TNCN?", "Lương thử việc tối thiểu bao nhiêu?" })
                {
                    <a href="@Url.Action("Index", new { question = sample })" class="badge bg-light text-dark text-decoration-none border py-1 px-2">@sample</a>
                }
            </div>

            @if (policyAnswer is not null)
            {
                <div class="p-3 rounded bg-light border">
                    <div class="fw-bold text-primary mb-2">Trả lời từ AI Expert:</div>
                    <div style="white-space: pre-line;">@policyAnswer.Answer</div>
                    @if (policyAnswer.Citations.Count > 0)
                    {
                        <hr />
                        <div class="fs-7 fw-bold text-muted mb-1">Nguồn trích dẫn (RAG Citations):</div>
                        @foreach (var c in policyAnswer.Citations)
                        {
                            <div class="fs-7 mb-1"><span class="badge bg-primary-subtle text-primary">@c.SourceCode</span> <strong>@c.Title</strong></div>
                        }
                    }
                </div>
            }
        </div>
    </div>

    <!-- CANDIDATE - JOB MATCHING -->
    <div class="col-12 col-lg-6">
        <div class="vnm-card p-3 h-100">
            <h5 class="fw-bold mb-3"><i class="ti ti-user-check me-2 text-success"></i>Gợi ý Khớp Ứng viên & Tin tuyển dụng</h5>
            @if (Model.CandidateMatches.Count == 0)
            {
                <div class="text-muted">Chưa có dữ liệu ứng viên / tin tuyển dụng đang mở.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Ứng viên</th><th>Vị trí phù hợp</th><th class="text-center">Điểm khớp</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.CandidateMatches)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@m.CandidateName</div>
                                        <div class="fs-7 text-muted">@m.MatchReason</div>
                                    </td>
                                    <td class="fs-7">@m.JobTitle</td>
                                    <td class="text-center">
                                        <span class="badge @(m.MatchScore >= 80 ? "bg-success" : "bg-primary") fs-7">@m.MatchScore%</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- ATTRITION RISK RADAR -->
<div class="vnm-card p-3 mb-4">
    <h5 class="fw-bold mb-3"><i class="ti ti-alert-triangle me-2 text-danger"></i>Radar Dự báo Nguy cơ Nghỉ việc (Attrition Risk)</h5>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Nhân sự</th><th>Đơn vị</th><th>Mức độ</th><th>Yếu tố rủi ro phát hiện</th><th>Khuyến nghị hành động</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.AttritionRisks)
                {
                    <tr>
                        <td class="fw-semibold">@r.EmployeeCode - @r.FullName</td>
                        <td>@r.UnitName</td>
                        <td>
                            <span class="badge @(r.RiskLevel == "Cao" ? "bg-danger" : r.RiskLevel == "Trung bình" ? "bg-warning text-dark" : "bg-info")">
                                @r.RiskLevel (@r.RiskScore%)
                            </span>
                        </td>
                        <td class="fs-7">@string.Join("; ", r.RiskFactors)</td>
                        <td class="fs-7 text-muted">@r.RecommendedAction</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

