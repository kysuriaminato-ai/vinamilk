<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Cổng thông tin tuyển dụng chính thức của Vinamilk.")" />
    <meta name="robots" content="index, follow" />
    @if (ViewData["CanonicalUrl"] is string canonical)
    {
        <link rel="canonical" href="@canonical" />
        <meta property="og:url" content="@canonical" />
    }
    <meta property="og:site_name" content="Vinamilk Careers" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Cơ hội nghề nghiệp tại Vinamilk.")" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"]" />
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "Cơ hội nghề nghiệp tại Vinamilk.")" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />

    @if (ViewData["JsonLd"] is string jsonLd && !string.IsNullOrWhiteSpace(jsonLd))
    {
        <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    }
    <style>
        body { font-family: 'Be Vietnam Pro', system-ui, sans-serif; background: #F8FAFC; color: #0F172A; }
        .vnm-pub-nav { background: #0213B0; }
    </style>
</head>
<body>
    <header class="vnm-pub-nav text-white py-3 shadow-sm">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <a href="/gioi-thieu" class="text-white text-decoration-none fw-extrabold fs-5">
                VINAMILK CAREERS
            </a>
            <nav aria-label="Menu công khai" class="d-flex gap-3 align-items-center">
                <a href="/gioi-thieu" class="text-white text-decoration-none fw-semibold">Giới thiệu</a>
                <a href="/tuyen-dung" class="text-white text-decoration-none fw-semibold">Tuyển dụng</a>
                <a href="/" class="btn btn-sm btn-light text-primary fw-bold">Cổng Nội bộ</a>
            </nav>
        </div>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-4 mt-5">
        <div class="container d-flex flex-wrap justify-content-between align-items-center text-muted small">
            <div>© @DateTime.Now.Year Công ty Cổ phần Sữa Việt Nam (Vinamilk). Bảo lưu mọi quyền.</div>
            <div class="d-flex gap-3">
                <a href="/sitemap.xml" class="text-muted text-decoration-none">Sitemap XML</a>
                <a href="/robots.txt" class="text-muted text-decoration-none">Robots.txt</a>
                <a href="/swagger" class="text-muted text-decoration-none">API Docs</a>
            </div>
        </div>
    </footer>
</body>
</html>

