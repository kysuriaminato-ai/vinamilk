@model IReadOnlyList<Vinamilk.HRM.Web.ViewComponents.SidebarMenuGroup>
@{
    var activeUrl = ViewBag.ActiveUrl as string;
}

<aside id="vnmSidebar" class="vnm-sidebar" aria-label="Menu điều hướng chính">
    <a href="/" class="vnm-sidebar-brand">
        <div class="vnm-brand-logo" title="Vinamilk HRM">VNM</div>
        <div class="vnm-brand-text">
            <div class="fw-bold fs-5 lh-1" style="letter-spacing:-0.02em;">VINAMILK</div>
            <div class="small text-white-50 mt-1">Quản lý nhân sự</div>
        </div>
    </a>

    <nav class="vnm-sidebar-nav">
        @foreach (var group in Model)
        {
            var groupActive = group.Items.Any(i => i.Url == activeUrl);
            var groupId = "vnm-grp-" + group.Key;
            <div class="vnm-nav-group @(groupActive ? "is-open has-active" : "")" data-group="@group.Key">
                <button type="button" class="vnm-nav-group-toggle"
                        aria-expanded="@(groupActive ? "true" : "false")" aria-controls="@groupId"
                        title="@group.GroupTitle">
                    <i class="ti @group.Icon vnm-nav-icon" aria-hidden="true"></i>
                    <span class="vnm-nav-label">@group.GroupTitle</span>
                    <i class="ti ti-chevron-down vnm-nav-chevron" aria-hidden="true"></i>
                </button>
                <div class="vnm-nav-group-items" id="@groupId">
                    @foreach (var item in group.Items)
                    {
                        var isActive = item.Url == activeUrl;
                        <a href="@item.Url"
                           class="vnm-nav-link @(isActive ? "active" : "")"
                           title="@item.Title"
                           aria-current="@(isActive ? "page" : null)"
                           target="@(item.OpenInNewTab ? "_blank" : null)"
                           rel="@(item.OpenInNewTab ? "noopener" : null)">
                            <i class="ti @item.Icon" aria-hidden="true"></i>
                            <span class="vnm-nav-label">@item.Title</span>
                            @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                            {
                                <span class="badge rounded-pill @(item.BadgeClass ?? "bg-danger") vnm-nav-badge">@item.BadgeText</span>
                            }
                            @if (item.OpenInNewTab)
                            {
                                <i class="ti ti-external-link vnm-nav-ext" aria-hidden="true"></i>
                            }
                        </a>
                    }
                </div>
            </div>
        }
    </nav>
</aside>

<script>
(function () {
    var KEY = 'vnm.sidebar.open';
    var saved = [];
    try { saved = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { }
    var groups = document.querySelectorAll('#vnmSidebar .vnm-nav-group');
    groups.forEach(function (g) {
        if (saved.indexOf(g.dataset.group) >= 0) setOpen(g, true);
        g.querySelector('.vnm-nav-group-toggle').addEventListener('click', function () {
            if (document.body.classList.contains('vnm-sidebar-collapsed')) {
                document.body.classList.remove('vnm-sidebar-collapsed');
                setOpen(g, true);
            } else {
                setOpen(g, !g.classList.contains('is-open'));
            }
            persist();
        });
    });
    function setOpen(g, open) {
        g.classList.toggle('is-open', open);
        g.querySelector('.vnm-nav-group-toggle').setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    function persist() {
        var open = [];
        groups.forEach(function (g) { if (g.classList.contains('is-open')) open.push(g.dataset.group); });
        try { localStorage.setItem(KEY, JSON.stringify(open)); } catch (e) { }
    }
})();
</script>
