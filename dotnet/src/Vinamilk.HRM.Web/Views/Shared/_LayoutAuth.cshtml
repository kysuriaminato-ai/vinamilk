<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vinamilk Enterprise HRM</title>
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('vnm_hrm_theme');
                if (saved === 'dark' || saved === 'light') {
                    document.documentElement.setAttribute('data-bs-theme', saved);
                }
            } catch (e) { }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/vinamilk-design-system.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" style="background: var(--vnm-bg-canvas);">
    <!-- Top floating controls -->
    <div class="position-fixed top-0 end-0 p-3 d-flex align-items-center gap-2" style="z-index: 1050;">
        <a href="/" class="btn btn-sm border rounded-pill px-3" style="background: var(--vnm-bg-surface);">
            <i class="ti ti-arrow-left me-1"></i>Về Dashboard
        </a>
        <button type="button"
                class="btn btn-icon border rounded-circle p-2"
                data-vnm-theme-toggle
                aria-label="Đổi giao diện Sáng / Tối"
                style="background: var(--vnm-bg-surface);">
            <i data-vnm-theme-icon class="ti ti-moon fs-5"></i>
        </button>
    </div>

    <main class="flex-grow-1 d-flex align-items-center justify-content-center p-3 p-md-4 vnm-page-enter">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/vinamilk-ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

