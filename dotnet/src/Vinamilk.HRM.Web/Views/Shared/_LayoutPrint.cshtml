<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bản In A4 Chuẩn Vinamilk HRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/vinamilk-design-system.css" asp-append-version="true" />
    <style>
        body {
            background: #334155;
            margin: 0;
            padding: 24px 0;
        }
        @@media print {
            body {
                background: #FFFFFF !important;
                padding: 0 !important;
            }
        }
    </style>
</head>
<body>
    <!-- Non-printable Action Bar -->
    <div class="vnm-no-print container mb-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between p-3 rounded-3 shadow text-white"
             style="background: #0213B0; max-width: 210mm; margin: 0 auto;">
            <div class="d-flex align-items-center gap-2">
                <i class="ti ti-printer fs-3"></i>
                <div>
                    <div class="fw-bold">Chế độ Xem trước Bản In Hành chính Chuẩn A4 (210mm × 297mm)</div>
                    <div class="fs-7 text-white-50">Chuẩn thể thức văn bản Nghị định 30/2020/NĐ-CP & Biểu mẫu Nhân sự Vinamilk</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0">
                <a href="/dev/styleguide" class="btn btn-sm btn-outline-light">
                    <i class="ti ti-arrow-left me-1"></i>Quay lại Styleguide
                </a>
                <button type="button" class="btn btn-sm btn-light fw-bold text-primary" onclick="window.print()">
                    <i class="ti ti-printer me-1"></i>In ngay / Xuất PDF (Ctrl+P)
                </button>
            </div>
        </div>
    </div>

    <!-- A4 Sheet Container -->
    <div class="vnm-print-sheet">
        @RenderBody()
    </div>
</body>
</html>

