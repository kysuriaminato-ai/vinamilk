<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] - Vinamilk Enterprise HRM (.NET 8)</title>

    <!-- Early Theme Initialization to prevent FOUC -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('vnm_hrm_theme');
                if (saved === 'dark' || saved === 'light') {
                    document.documentElement.setAttribute('data-bs-theme', saved);
                }
            } catch (e) { }
        })();
    </script>

    <!-- Google Fonts: Be Vietnam Pro & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 + Tabler Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />

    <!-- Flatpickr, TomSelect, NProgress, AOS CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nprogress@0.2.0/nprogress.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />

    <!-- Vinamilk HRM Custom Design System -->
    <link rel="stylesheet" href="~/css/vinamilk-design-system.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- WCAG 2.1 AA Skip Link -->
    <a href="#vnmMainContent" class="vnm-skip-link">Chuyển thẳng tới nội dung chính</a>

    <!-- Mobile Sidebar Backdrop -->
    <div id="vnmSidebarBackdrop" class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-none" style="z-index: 1035;"></div>

    <div class="vnm-app-shell">
        <!-- Permission-Aware Collapsible Sidebar -->
        @await Component.InvokeAsync("Sidebar")

        <div class="vnm-main-wrapper">
            <!-- Sticky Topbar -->
            <header class="vnm-topbar" role="banner">
                <div class="d-flex align-items-center gap-3">
                    <button type="button"
                            class="btn btn-icon border-0 rounded-circle p-2"
                            data-vnm-sidebar-collapse
                            aria-label="Thu gọn hoặc mở rộng thanh bên"
                            style="background: var(--vnm-bg-subtle);">
                        <i class="ti ti-layout-sidebar-left-collapse fs-4"></i>
                    </button>

                    <!-- Breadcrumb -->
                    <nav aria-label="Breadcrumb" class="d-none d-md-block">
                        <ol class="breadcrumb mb-0 fs-6">
                            <li class="breadcrumb-item">
                                <a href="/" class="text-decoration-none text-secondary">
                                    <i class="ti ti-home me-1"></i>Vinamilk HRM
                                </a>
                            </li>
                            @if (ViewData["BreadcrumbParent"] != null)
                            {
                                <li class="breadcrumb-item text-secondary">@ViewData["BreadcrumbParent"]</li>
                            }
                            <li class="breadcrumb-item active fw-semibold text-body" aria-current="page">
                                @(ViewData["Title"] ?? "Tổng quan")
                            </li>
                        </ol>
                    </nav>
                </div>

                <!-- Right Topbar Controls -->
                <div class="d-flex align-items-center gap-2">
                    <!-- Global Search Trigger (Ctrl+K) -->
                    <button type="button"
                            class="vnm-search-trigger"
                            data-vnm-open-search
                            aria-label="Tìm kiếm toàn cục (Ctrl+K)">
                        <i class="ti ti-search text-primary"></i>
                        <span class="d-none d-sm-inline">Tìm nhân viên, phòng ban, chức năng...</span>
                        <span class="d-inline d-sm-none">Tìm kiếm...</span>
                        <kbd class="vnm-kbd ms-auto d-none d-md-inline-block">Ctrl K</kbd>
                    </button>

                    <!-- Language Switcher (VI / EN) -->
                    <div class="dropdown">
                        <button class="btn btn-sm border-0 rounded-pill px-2 py-1 fw-semibold d-flex align-items-center gap-1"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-label="Chuyển đổi ngôn ngữ"
                                style="background: var(--vnm-bg-subtle);">
                            <span class="badge bg-danger rounded-circle p-1"></span>
                            <span id="vnmCurrentLangLabel">VI</span>
                            <i class="ti ti-chevron-down fs-7"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 fs-6">
                            <li>
                                <a class="dropdown-item d-flex align-items-center justify-content-between active"
                                   href="javascript:void(0)"
                                   onclick="document.getElementById('vnmCurrentLangLabel').textContent='VI'; VnmUI.toast('Đã chuyển ngôn ngữ: Tiếng Việt (vi-VN)', 'info');">
                                    <span>🇻🇳 Tiếng Việt (vi-VN)</span>
                                    <i class="ti ti-check text-primary"></i>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center justify-content-between"
                                   href="javascript:void(0)"
                                   onclick="document.getElementById('vnmCurrentLangLabel').textContent='EN'; VnmUI.toast('Language switched to English (en-US)', 'info');">
                                    <span>🇬🇧 English (en-US)</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Light / Dark Theme Switcher -->
                    <button type="button"
                            class="btn btn-icon border-0 rounded-circle p-2"
                            data-vnm-theme-toggle
                            aria-label="Chuyển đổi chế độ Sáng / Tối"
                            title="Chuyển đổi Light / Dark Mode"
                            style="background: var(--vnm-bg-subtle);">
                        <i data-vnm-theme-icon class="ti ti-moon fs-4"></i>
                    </button>

                    <!-- Notification Bell ViewComponent -->
                    @await Component.InvokeAsync("NotificationBell")

                    <!-- User Avatar Menu -->
                    <div class="dropdown ms-1">
                        <button class="btn border-0 p-1 d-flex align-items-center gap-2 rounded-pill"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="Menu tài khoản người dùng">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                                 style="width: 36px; height: 36px; background: linear-gradient(135deg, var(--vnm-primary), var(--vnm-info));">
                                MK
                            </div>
                            <div class="text-start d-none d-xl-block pe-1">
                                <div class="fw-bold fs-6 lh-1">Mai Kiều Liên</div>
                                <div class="text-muted fs-7 mt-1">SuperAdmin • CEO</div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 fs-6"
                            style="min-width: 240px; border-radius: var(--vnm-radius-md);">
                            <li class="px-3 py-2 border-bottom" style="border-color: var(--vnm-border-subtle) !important;">
                                <div class="fw-bold">Mai Kiều Liên</div>
                                <div class="text-muted fs-7 font-monospace">VNM-0001 • mkl@vinamilk.com.vn</div>
                                <span class="vnm-badge vnm-badge-success mt-1"><span class="vnm-badge-dot"></span>RBAC: 62/62 Quyền</span>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/dev/styleguide">
                                    <i class="ti ti-palette me-2 text-primary"></i>Design System & Styleguide
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/dev/styleguide/print-preview" target="_blank">
                                    <i class="ti ti-printer me-2 text-primary"></i>In thử Mẫu 2C / Quyết định A4
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="javascript:void(0)" data-vnm-theme-toggle>
                                    <i class="ti ti-contrast-2 me-2 text-primary"></i><span data-vnm-theme-label>Đổi giao diện Sáng/Tối</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item py-2 text-danger fw-semibold" href="/Auth/Login">
                                    <i class="ti ti-logout me-2"></i>Đăng xuất / Đổi phiên 2FA
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Page View with Smooth Enter Transition -->
            <main id="vnmMainContent" class="vnm-page-content vnm-page-enter" role="main">
                @RenderBody()
            </main>

            <!-- Enterprise Footer -->
            <footer class="px-4 py-3 border-top d-flex flex-wrap align-items-center justify-content-between text-secondary fs-7"
                    style="background: var(--vnm-bg-surface); border-color: var(--vnm-border-subtle) !important;">
                <div>
                    <strong>CÔNG TY CỔ PHẦN SỮA VIỆT NAM (VINAMILK)</strong> — Hệ thống Quản trị Nguồn Nhân lực Doanh nghiệp (.NET 8 Clean Architecture)
                </div>
                <div class="d-flex align-items-center gap-3 mt-2 mt-sm-0">
                    <a href="/dev/styleguide" class="text-decoration-none text-secondary hover-primary">Design System</a>
                    <a href="/swagger" target="_blank" class="text-decoration-none text-secondary hover-primary">OpenAPI v1</a>
                    <a href="/Error/Maintenance" class="text-decoration-none text-secondary hover-primary">Trạng thái Bảo trì</a>
                </div>
            </footer>
        </div>
    </div>

    <!-- Global Search Command Palette Modal (Ctrl+K) -->
    <div class="modal fade" id="vnmSearchModal" tabindex="-1" aria-labelledby="vnmSearchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: var(--vnm-radius-lg); overflow: hidden;">
                <div class="modal-header border-bottom p-3" style="background: var(--vnm-bg-surface);">
                    <i class="ti ti-search fs-3 text-primary me-2"></i>
                    <input type="text"
                           id="vnmGlobalSearchInput"
                           class="form-control border-0 shadow-none fs-5"
                           placeholder="Tìm kiếm Nhân viên (VNM-0001, tên...), Phòng ban, hoặc Chức năng..."
                           autocomplete="off"
                           aria-label="Nhập từ khóa tìm kiếm toàn cục" />
                    <button type="button" class="btn btn-sm btn-light border font-monospace" data-bs-dismiss="modal">ESC</button>
                </div>
                <div class="modal-body p-0" id="vnmGlobalSearchResults" style="max-height: 420px; overflow-y: auto; background: var(--vnm-bg-surface);">
                    <div class="p-3">
                        <div class="text-uppercase text-muted fw-bold fs-7 mb-2 px-2">Lối tắt điều hướng nhanh</div>
                        <a href="/" class="d-flex align-items-center justify-content-between p-2 rounded text-decoration-none text-body">
                            <span><i class="ti ti-layout-dashboard me-2 text-primary"></i>Bảng điều khiển Executive HRM</span>
                            <kbd class="vnm-kbd">G + D</kbd>
                        </a>
                        <a href="/dev/styleguide" class="d-flex align-items-center justify-content-between p-2 rounded text-decoration-none text-body">
                            <span><i class="ti ti-palette me-2 text-primary"></i>Vinamilk HRM Design System & Style Guide</span>
                            <kbd class="vnm-kbd">G + S</kbd>
                        </a>
                        <a href="/dev/styleguide/print-preview" target="_blank" class="d-flex align-items-center justify-content-between p-2 rounded text-decoration-none text-body">
                            <span><i class="ti ti-printer me-2 text-primary"></i>Xem mẫu in Quyết định nhân sự A4 chuẩn Quốc hiệu</span>
                            <kbd class="vnm-kbd">G + P</kbd>
                        </a>
                    </div>
                </div>
                <div class="modal-footer justify-content-between py-2 px-3 text-muted fs-7" style="background: var(--vnm-bg-subtle);">
                    <span><i class="ti ti-database me-1"></i>Dữ liệu trực tiếp từ SQL Server (55 NV • 32 Đơn vị)</span>
                    <span>Nhấn <kbd class="vnm-kbd">ESC</kbd> để đóng</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/nprogress@0.2.0/nprogress.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/vinamilk-ui.js" asp-append-version="true"></script>
    <script>
        (function () {
            if (typeof signalR === 'undefined') return;
            try {
                const conn = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/notifications')
                    .withAutomaticReconnect()
                    .build();

                conn.on('ReceiveNotification', function (data) {
                    if (window.VnmUI && window.VnmUI.toast) {
                        window.VnmUI.toast(data.title + ': ' + data.message, 'info');
                    }
                    const badge = document.getElementById('vnmRealtimeBellBadge');
                    if (badge) {
                        const current = parseInt(badge.textContent || '0', 10) || 0;
                        badge.textContent = (current + 1).toString();
                        badge.classList.remove('d-none');
                    }
                    const list = document.getElementById('vnmRealtimeNotificationList');
                    if (list) {
                        const item = document.createElement('a');
                        item.href = data.targetUrl || '/Workflows';
                        item.className = 'dropdown-item d-flex align-items-start gap-2 px-3 py-2 border-bottom text-wrap';
                        item.style.background = 'var(--vnm-primary-soft)';
                        item.innerHTML = '<div class="mt-1"><i class="ti ti-broadcast fs-4 text-primary"></i></div>' +
                            '<div class="flex-grow-1">' +
                            '<div class="fw-semibold fs-6 text-body">' + (data.title || 'Thông báo mới') + '</div>' +
                            '<div class="text-secondary fs-7 mt-1">' + (data.message || '') + '</div>' +
                            '<div class="text-muted fs-7 mt-1"><i class="ti ti-clock me-1"></i>Vừa xong (' + (data.timestamp || '') + ')</div>' +
                            '</div><span class="badge bg-primary rounded-circle p-1 mt-2"></span>';
                        list.prepend(item);
                    }
                });

                conn.on('WorkflowStatusUpdated', function (data) {
                    if (window.VnmUI && window.VnmUI.toast) {
                        window.VnmUI.toast(data.summaryMessage, 'success');
                    }
                });

                conn.start().catch(function () { });
            } catch (e) { }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
