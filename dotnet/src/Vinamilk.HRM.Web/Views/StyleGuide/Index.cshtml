<!-- 9. RESPONSIVE DATATABLE (DESKTOP TABLE -> MOBILE CARDS < 768PX) -->
<section id="section-datatable" class="vnm-card p-4 mb-2" data-aos="fade-up">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h2 class="fw-bold mb-1" style="font-size: var(--vnm-fs-lg);">
                <i class="ti ti-table text-primary me-2"></i>9. Responsive DataTable (Tự động chuyển thành Thẻ Card trên Mobile &lt; 768px)
            </h2>
            <p class="text-secondary fs-6 mb-0">
                Dữ liệu truy vấn trực tiếp từ SQL Server (<code>core.Employees</code>). Thu nhỏ trình duyệt xuống <code>&lt; 768px</code> để xem chế độ Mobile Card View.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-success" onclick="VnmUI.toast('Đang kết xuất tệp Excel (ClosedXML) chuẩn Vinamilk...', 'success')">
                <i class="ti ti-file-spreadsheet me-1"></i>Xuất Excel
            </button>
            <a href="/dev/styleguide/print-preview" target="_blank" class="btn btn-sm vnm-btn-primary">
                <i class="ti ti-printer me-1"></i>In Mẫu 2C / QĐ A4
            </a>
        </div>
    </div>

    <div class="vnm-table-wrapper">
        <table class="vnm-table vnm-table-mobile-cards">
            <thead>
                <tr>
                    <th>Mã NV</th>
                    <th>Họ và Tên</th>
                    <th>Đơn vị / Phòng ban</th>
                    <th>Chức danh</th>
                    <th>Email Công việc</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model)
                {
                    <tr>
                        <td data-label="Mã NV">
                            <span class="badge bg-primary-subtle text-primary font-monospace fw-bold">@emp.EmployeeCode</span>
                        </td>
                        <td data-label="Họ và Tên" class="fw-bold">@emp.FullName</td>
                        <td data-label="Đơn vị">@(emp.OrganizationUnit?.UnitName ?? "Trụ sở Chính")</td>
                        <td data-label="Chức danh">@(emp.Position?.PositionName ?? "Chuyên viên")</td>
                        <td data-label="Email" class="font-monospace fs-7">@emp.WorkEmail</td>
                        <td data-label="Trạng thái">
                            <vnm-status-badge status="active" text="Đang làm việc" />
                        </td>
                        <td data-label="Thao tác" class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        title="Sửa nhanh qua AJAX Modal"
                                        data-bs-toggle="modal"
                                        data-bs-target="#demoAjaxModal">
                                    <i class="ti ti-edit"></i>
                                </button>
                                <a href="/dev/styleguide/print-preview"
                                   target="_blank"
                                   class="btn btn-outline-secondary"
                                   title="In Quyết định A4">
                                    <i class="ti ti-printer"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- REUSABLE AJAX MODAL FORM DEMO -->
<div class="modal fade" id="demoAjaxModal" tabindex="-1" aria-labelledby="demoAjaxModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--vnm-radius-lg);">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="demoAjaxModalLabel">
                    <i class="ti ti-user-edit text-primary me-2"></i>Cập nhật Nhanh Hồ sơ Nhân sự (AJAX Modal)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form onsubmit="event.preventDefault(); bootstrap.Modal.getInstance(document.getElementById('demoAjaxModal')).hide(); VnmUI.toast('Đã lưu thay đổi qua AJAX và tăng RowVersion chống ghi đè!', 'success');">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã Nhân viên & Họ tên</label>
                        <input type="text" class="form-control font-monospace" value="VNM-0001 — Mai Kiều Liên" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Loại điều chỉnh</label>
                        <select class="form-select">
                            <option>Điều chỉnh Phụ cấp Trách nhiệm</option>
                            <option>Gia hạn Hợp đồng Lao động</option>
                            <option>Cập nhật Người phụ thuộc giảm trừ gia cảnh</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-semibold">Ghi chú Kiểm toán (Audit Reason) <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="2" required>Cập nhật theo Nghị quyết HĐQT Quý 4/2026.</textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn vnm-btn-primary">
                        <i class="ti ti-device-floppy me-1"></i>Lưu & Ghi AuditLog
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (!window.ApexCharts) return;

            const areaEl = document.querySelector('#styleguideMainChart');
            if (areaEl) {
                new ApexCharts(areaEl, {
                    chart: { type: 'area', height: 290, fontFamily: 'Be Vietnam Pro, sans-serif', toolbar: { show: false } },
                    colors: ['#0213B0', '#059669'],
                    dataLabels: { enabled: false },
                    stroke: { curve: 'smooth', width: 3 },
                    series: [
                        { name: 'Quỹ lương thực chi (Tỷ VNĐ)', data: [1.32, 1.36, 1.40, 1.42, 1.45, 1.48] },
                        { name: 'Điểm KPI trung bình toàn Công ty', data: [88, 90, 91, 93, 94, 96] }
                    ],
                    xaxis: { categories: ['Tháng 6', 'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11'] },
                    fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.35, opacityTo: 0.05 } }
                }).render();
            }

            const donutEl = document.querySelector('#styleguideDonutChart');
            if (donutEl) {
                new ApexCharts(donutEl, {
                    chart: { type: 'donut', height: 280, fontFamily: 'Be Vietnam Pro, sans-serif' },
                    colors: ['#0213B0', '#0284C7', '#059669', '#D97706', '#7C3AED'],
                    labels: ['Khối Sản xuất & Nhà máy', 'Khối Kinh doanh', 'Khối Trang trại', 'Khối CNTT & CĐS', 'Khối Quản trị & Tài chính'],
                    series: [24, 12, 8, 6, 5],
                    legend: { position: 'bottom' }
                }).render();
            }
        });
    </script>
}
