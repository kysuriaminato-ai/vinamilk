<!-- 7. INTERACTIVE CHARTS (APEXCHARTS) -->
<section id="section-charts" class="mb-4" data-aos="fade-up">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="vnm-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h3 class="fw-bold mb-0" style="font-size: var(--vnm-fs-md);">
                            <i class="ti ti-chart-area-line text-primary me-2"></i>7A. Biến động Nhân sự & Quỹ lương 6 Tháng gần nhất (ApexCharts)
                        </h3>
                    </div>
                    <span class="vnm-badge vnm-badge-info">Real-time Analytics</span>
                </div>
                <div id="styleguideMainChart" style="min-height: 290px;"></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="vnm-card p-4 h-100">
                <h3 class="fw-bold mb-3" style="font-size: var(--vnm-fs-md);">
