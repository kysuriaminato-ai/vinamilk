@section Scripts {
    <style>
        .shift-cell-selected {
            outline: 2px solid #0d6efd !important;
            background-color: rgba(13, 110, 253, 0.08) !important;
        }
    </style>
    <script>
        let draggedShiftPayload = null;
        let isSelectingCells = false;
        let dragSelectionMoved = false;
        let anchorCell = null;
        const selectedCellKeys = new Set();

        function cellKey(td) {
            return td.dataset.empId + '|' + td.dataset.date;
        }

        function refreshSelectionToolbar() {
            const bar = document.getElementById('bulkCellSelectionToolbar');
            const cnt = document.getElementById('selectedCellCount');
            if (!bar || !cnt) return;
            cnt.textContent = selectedCellKeys.size;
            bar.classList.toggle('d-none', selectedCellKeys.size === 0);
        }

        function clearCellSelection() {
            selectedCellKeys.clear();
            document.querySelectorAll('.shift-drop-zone.shift-cell-selected').forEach(el => el.classList.remove('shift-cell-selected'));
            refreshSelectionToolbar();
        }

        function toggleCellSelected(td, forceOn) {
            const k = cellKey(td);
            const on = forceOn !== undefined ? forceOn : !selectedCellKeys.has(k);
            if (on) {
                selectedCellKeys.add(k);
                td.classList.add('shift-cell-selected');
            } else {
                selectedCellKeys.delete(k);
                td.classList.remove('shift-cell-selected');
            }
            refreshSelectionToolbar();
        }

        function selectRangeToCell(targetTd) {
            if (!anchorCell) {
                toggleCellSelected(targetTd, true);
                return;
            }
            const rows = Array.from(document.querySelectorAll('#shiftRosterTable tbody tr'));
            const r1 = rows.indexOf(anchorCell.closest('tr'));
            const r2 = rows.indexOf(targetTd.closest('tr'));
            const c1 = Array.from(anchorCell.closest('tr').children).indexOf(anchorCell);
            const c2 = Array.from(targetTd.closest('tr').children).indexOf(targetTd);
            const rMin = Math.min(r1, r2), rMax = Math.max(r1, r2);
            const cMin = Math.min(c1, c2), cMax = Math.max(c1, c2);
            clearCellSelection();
            for (let r = rMin; r <= rMax; r++) {
                const tds = rows[r].children;
                for (let c = cMin; c <= cMax; c++) {
                    if (tds[c] && tds[c].classList.contains('shift-drop-zone')) {
                        toggleCellSelected(tds[c], true);
                    }
                }
            }
        }

        document.querySelectorAll('#shiftRosterTable .shift-drop-zone').forEach(td => {
            td.addEventListener('mousedown', ev => {
                if (ev.button !== 0) return;
                if (ev.shiftKey) {
                    ev.preventDefault();
                    if (!anchorCell) anchorCell = td;
                    selectRangeToCell(td);
                    return;
                }
                isSelectingCells = true;
                dragSelectionMoved = false;
                anchorCell = td;
            });
            td.addEventListener('mouseenter', () => {
                if (!isSelectingCells || !anchorCell) return;
                if (cellKey(td) !== cellKey(anchorCell)) {
                    dragSelectionMoved = true;
                    selectRangeToCell(td);
                }
            });
            td.addEventListener('click', ev => {
                if (ev.shiftKey || dragSelectionMoved) {
                    dragSelectionMoved = false;
                    return;
                }
                clearCellSelection();
                openCellShiftModal(td);
            });
        });

        document.addEventListener('mouseup', () => {
            isSelectingCells = false;
        });

        function toggleCellShiftSelect() {
            const action = document.querySelector('input[name="cellActionType"]:checked')?.value || 'Assign';
            const wrap = document.getElementById('cellShiftSelectWrap');
            if (wrap) wrap.classList.toggle('d-none', action !== 'Assign');
        }

        function openCellShiftModal(td) {
            document.getElementById('cellEmpId').value = td.dataset.empId;
            document.getElementById('cellWorkDate').value = td.dataset.date;
            document.getElementById('cellEmpLabel').textContent = `${td.dataset.empCode} — ${td.dataset.empName}`;
            document.getElementById('cellDateLabel').textContent = td.dataset.dateVi;
            document.getElementById('cellNotes').value = td.dataset.notes || '';

            const isOff = td.dataset.isOff === 'true';
            document.getElementById(isOff ? 'cellActionOff' : 'cellActionAssign').checked = true;
            const sel = document.getElementById('cellWorkShiftId');
            if (td.dataset.shiftId && sel.querySelector(`option[value="${td.dataset.shiftId}"]`)) {
                sel.value = td.dataset.shiftId;
            }
            toggleCellShiftSelect();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCellShift')).show();
        }

        function applyCellVisual(td, code, timeText, badgeClass, shiftId, isOff, notes, cellWarning) {
            const badge = td.querySelector('.shift-cell-badge');
            const codeLbl = td.querySelector('.shift-code-label');
            const timeLbl = td.querySelector('.shift-time-label');
            const warnLbl = td.querySelector('.shift-warn-label');
            if (badge && codeLbl && timeLbl) {
                badge.className = 'shift-cell-badge badge border w-100 py-2 ' + badgeClass + (cellWarning ? ' border-danger border-2' : '');
                codeLbl.textContent = code;
                timeLbl.textContent = timeText;
            }
            if (warnLbl) {
                warnLbl.classList.toggle('d-none', !cellWarning);
                warnLbl.title = cellWarning || '';
            }
            td.dataset.shiftId = shiftId || '';
            td.dataset.shiftCode = code;
            td.dataset.isOff = isOff ? 'true' : 'false';
            td.dataset.notes = notes || '';
        }

        async function saveCellShiftModal() {
            const empId = parseInt(document.getElementById('cellEmpId').value, 10);
            const workDate = document.getElementById('cellWorkDate').value;
            const action = document.querySelector('input[name="cellActionType"]:checked')?.value || 'Assign';
            const sel = document.getElementById('cellWorkShiftId');
            const opt = sel.options[sel.selectedIndex];
            const workShiftId = action === 'Assign' ? parseInt(sel.value, 10) : null;
            const isDayOff = action === 'Off';
            const notes = document.getElementById('cellNotes').value;

            const resp = await fetch('/Shifts/AssignCellAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ employeeId: empId, workDate, workShiftId, isDayOff, action, notes })
            });
            const json = await resp.json();
            if (!resp.ok || !json.success) {
                window.VnmUI?.toast(json.message || 'Không thể lưu lịch ca.', 'error');
                return;
            }

            const td = document.querySelector(`#shiftRosterTable .shift-drop-zone[data-emp-id="${empId}"][data-date="${workDate}"]`);
            if (td) {
                if (action === 'Delete') {
                    const isWeekend = [0, 6].includes(new Date(workDate + 'T00:00:00').getDay());
                    applyCellVisual(td, isWeekend ? 'OFF' : 'Mặc định', isWeekend ? 'Nghỉ' : 'Theo ca chuẩn', 'bg-light text-muted border-dashed', '', isWeekend, '', '');
                } else if (action === 'Off') {
                    applyCellVisual(td, 'OFF', 'Nghỉ', 'bg-secondary-subtle text-secondary border-secondary-subtle', '', true, notes, json.cellWarning);
                } else {
                    applyCellVisual(td, opt.dataset.code, opt.dataset.time, opt.dataset.badge, sel.value, false, notes, json.cellWarning);
                }
            }

            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCellShift')).hide();
            window.VnmUI?.toast(json.message || 'Đã cập nhật lịch phân ca!', 'success');
            if (json.warnings && json.warnings.length > 0) {
                window.VnmUI?.toast('Cảnh báo xếp ca: ' + json.warnings.map(w => w.message).slice(0, 2).join('; '), 'warning');
            }
        }

        async function applyBulkCellSelection() {
            const cells = Array.from(selectedCellKeys).map(k => {
                const [empId, workDate] = k.split('|');
                return { employeeId: parseInt(empId, 10), workDate };
            });
            if (cells.length === 0) return;

            const actionVal = document.getElementById('bulkCellShiftAction').value;
            const notes = document.getElementById('bulkCellNotes').value;
            let payload = { cells, workShiftId: null, isDayOff: false, deleteSchedule: false, notes };
            let visual = null;

            if (actionVal === 'delete') {
                payload.deleteSchedule = true;
            } else if (actionVal === 'off') {
                payload.isDayOff = true;
                visual = { code: 'OFF', time: 'Nghỉ', badge: 'bg-secondary-subtle text-secondary border-secondary-subtle', shiftId: '', isOff: true };
            } else if (actionVal.startsWith('assign:')) {
                const [, shiftId, code, time, badge] = actionVal.split(':');
                payload.workShiftId = parseInt(shiftId, 10);
                visual = { code, time, badge, shiftId, isOff: false };
            }

            const resp = await fetch('/Shifts/BulkAssignCellsAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const json = await resp.json();
            if (!resp.ok || !json.success) {
                window.VnmUI?.toast(json.message || 'Không thể áp dụng hàng loạt.', 'error');
                return;
            }

            cells.forEach(c => {
                const td = document.querySelector(`#shiftRosterTable .shift-drop-zone[data-emp-id="${c.employeeId}"][data-date="${c.workDate}"]`);
                if (!td) return;
                if (payload.deleteSchedule) {
                    applyCellVisual(td, 'Mặc định', 'Theo chính sách', 'bg-light text-muted border-dashed', '', false, '', '');
                } else if (visual) {
                    applyCellVisual(td, visual.code, visual.time, visual.badge, visual.shiftId, visual.isOff, notes, '');
                }
            });

            clearCellSelection();
            window.VnmUI?.toast(json.message || 'Đã cập nhật hàng loạt!', 'success');
            if (json.warnings && json.warnings.length > 0) {
                window.VnmUI?.toast('Cảnh báo xếp ca: ' + json.warnings.slice(0, 2).join('; '), 'warning');
            }
        }

        function onShiftDragStart(ev, shiftId, shiftCode, timeText, isDayOff, badgeClass) {
            draggedShiftPayload = {
                workShiftId: shiftId,
                shiftCode: shiftCode,
                timeText: timeText,
                isDayOff: isDayOff,
                badgeClass: badgeClass
            };
            ev.dataTransfer.effectAllowed = 'copy';
        }

        function onShiftDragOver(ev) {
            ev.preventDefault();
            ev.currentTarget.style.background = 'var(--vnm-primary-soft)';
        }

        function onShiftDragLeave(ev) {
            ev.currentTarget.style.background = '';
        }

        async function onShiftDrop(ev, employeeId, workDateStr) {
            ev.preventDefault();
            const td = ev.currentTarget;
            td.style.background = '';
            if (!draggedShiftPayload) return;

            try {
                const resp = await fetch('/Shifts/AssignCellAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        employeeId: employeeId,
                        workDate: workDateStr,
                        workShiftId: draggedShiftPayload.workShiftId,
                        isDayOff: draggedShiftPayload.isDayOff,
                        action: draggedShiftPayload.isDayOff ? 'Off' : 'Assign'
                    })
                });
                const json = await resp.json();
                if (!resp.ok || !json.success) {
                    window.VnmUI?.toast(json.message || 'Không thể lưu lịch phân ca.', 'error');
                    return;
                }
                applyCellVisual(
                    td,
                    draggedShiftPayload.shiftCode,
                    draggedShiftPayload.timeText,
                    draggedShiftPayload.badgeClass,
                    draggedShiftPayload.workShiftId,
                    draggedShiftPayload.isDayOff,
                    'Kéo-thả trực tiếp trên Lịch phân ca',
                    json.cellWarning);

                window.VnmUI?.toast(json.message || 'Đã cập nhật lịch phân ca!', 'success');
                if (json.warnings && json.warnings.length > 0) {
                    window.VnmUI?.toast('Cảnh báo xếp ca: ' + json.warnings.map(w => w.message).slice(0, 2).join('; '), 'warning');
                }
            } catch (err) {
                window.VnmUI?.toast('Lỗi khi lưu lịch phân ca.', 'error');
            }
        }
    </script>
}
