@model Vinamilk.HRM.Application.TimeAttendance.ShiftAndScheduleOverviewDto
@{
    ViewData["Title"] = "Quản lý Ca làm việc, Xếp ca Kéo-Thả & Ngày Lễ";
    ViewData["BreadcrumbParent"] = "Chấm công & Nghỉ phép (Phiên 6)";
    var prevWeek = Model.WeekStartDate.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStartDate.AddDays(7).ToString("yyyy-MM-dd");
    string activeTab = ViewBag.ActiveTab as string ?? "roster";
    int nextHolidayYear = Model.Holidays.Count == 0 ? Model.SelectedYear : Model.SelectedYear + 1;
    bool hasNationalDayBefore = Model.Holidays.Any(h => h.HolidayDate == new DateOnly(Model.SelectedYear, 9, 1));
    bool hasNationalDayAfter = Model.Holidays.Any(h => h.HolidayDate == new DateOnly(Model.SelectedYear, 9, 3));
    bool defaultNationalBefore = hasNationalDayBefore || !hasNationalDayAfter;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="ti ti-calendar-clock text-primary me-2"></i>Ca làm việc, Lịch Xếp ca Kéo-Thả (Shift Roster) & Ngày Lễ Tết
        </h2>
        <p class="text-secondary mb-0">
            Kéo thẻ Ca làm việc thả trực tiếp vào ô lịch nhân viên • Phân ca xoay vòng Nhà máy 3 ca • Cấu hình Ngày Lễ hưởng lương 300%
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalBulkSchedule">
            <i class="ti ti-calendar-plus me-1"></i>Phân ca Hàng loạt
        </button>
        <button type="button" class="btn btn-outline-warning text-dark" data-bs-toggle="modal" data-bs-target="#modalGenerateHolidaysYear">
            <i class="ti ti-calendar-cog me-1"></i>Sinh lịch lễ năm N
        </button>
        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalSaveHoliday">
            <i class="ti ti-confetti me-1"></i>Thêm Ngày Lễ
        </button>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalSaveShift">
            <i class="ti ti-plus me-1"></i>Thiết lập Ca mới
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-3">
        <i class="ti ti-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3">
        <i class="ti ti-alert-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm mb-3">
        <i class="ti ti-alert-circle me-2"></i>@TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="vnm-card p-3 h-100 border-start border-4 border-primary">
            <div class="text-secondary fs-7 text-uppercase fw-semibold">Tổng số Ca làm việc chuẩn</div>
            <div class="fs-2 fw-bold text-primary mt-1">@Model.WorkShifts.Count</div>
            <div class="fs-7 text-muted">Hành chính + 3 Ca Nhà máy sữa</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="vnm-card p-3 h-100 border-start border-4 border-success">
            <div class="text-secondary fs-7 text-uppercase fw-semibold">Lượt phân ca Sản xuất tuần này</div>
            <div class="fs-2 fw-bold text-success mt-1">@Model.TotalFactoryShiftCount</div>
            <div class="fs-7 text-muted">Ca 1 (06-14h) & Ca 2 (14-22h)</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="vnm-card p-3 h-100 border-start border-4 border-dark">
            <div class="text-secondary fs-7 text-uppercase fw-semibold">Lượt Ca 3 Đêm (Phụ cấp +30%)</div>
            <div class="fs-2 fw-bold mt-1">@Model.TotalNightShiftCount</div>
            <div class="fs-7 text-muted">Khung giờ 22:00 - 06:00 sáng hôm sau</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="vnm-card p-3 h-100 border-start border-4 border-danger">
            <div class="text-secondary fs-7 text-uppercase fw-semibold">Ngày Nghỉ Lễ hưởng lương (@Model.SelectedYear)</div>
            <div class="fs-2 fw-bold text-danger mt-1">@Model.TotalHolidayDaysInYear ngày</div>
            <div class="fs-7 text-muted">Theo Điều 112 BLLĐ 2019 (OT x300%)</div>
        </div>
    </div>
</div>

<!-- Navigation Tabs -->
<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
        <button class="nav-link @(activeTab == "roster" ? "active" : "") fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-roster" type="button">
            <i class="ti ti-drag-drop me-1"></i>Lịch Xếp ca Kéo-Thả (Drag & Drop Calendar)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "shifts" ? "active" : "") fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-shifts" type="button">
            <i class="ti ti-clock-hour-8 me-1"></i>Danh mục Ca làm việc (@Model.WorkShifts.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "holidays" ? "active" : "") fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-holidays" type="button">
            <i class="ti ti-calendar-star me-1"></i>Lịch Ngày Lễ, Tết Việt Nam (@Model.Holidays.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "rotation-swap" ? "active" : "") fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-rotation-swap" type="button">
            <i class="ti ti-arrows-exchange me-1"></i>Xoay ca & Đổi ca
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "policies" ? "active" : "") fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-policies" type="button">
            <i class="ti ti-shield-cog me-1"></i>Nhóm chính sách & Quy định
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- TAB 1: CALENDAR XẾP CA KÉO THẢ -->
    <div class="tab-pane fade @(activeTab == "roster" ? "show active" : "")" id="tab-roster">
        <!-- Thanh công cụ lọc tuần + Bảng mẫu Ca kéo-thả -->
        <div class="vnm-card p-3 mb-3">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-xl-7">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
                            <a href="/Shifts?weekStart=@prevWeek&unitId=@Model.SelectedUnitId" class="btn btn-sm btn-outline-secondary" title="Tuần trước">
                                <i class="ti ti-chevron-left"></i> Tuần trước
                            </a>
                            <div class="input-group input-group-sm" style="width: auto;">
                                <span class="input-group-text bg-light fw-semibold">Tuần</span>
                                <input type="date" name="weekStart" class="form-control form-control-sm" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" title="Chọn ngày để xem tuần chứa ngày đó" />
                                <span class="input-group-text bg-white font-monospace fs-7">@Model.WeekStartDate.ToString("dd/MM") — @Model.WeekEndDate.ToString("dd/MM")</span>
                            </div>
                            <a href="/Shifts?weekStart=@nextWeek&unitId=@Model.SelectedUnitId" class="btn btn-sm btn-outline-secondary" title="Tuần sau">
                                Tuần sau <i class="ti ti-chevron-right"></i>
                            </a>
                            <select name="unitId" class="form-select form-select-sm" style="width: 195px;" onchange="this.form.submit()">
                                <option value="">-- Tất cả đơn vị --</option>
                                @foreach (var u in Model.Units)
                                {
                                    <option value="@u.Id" selected="@(Model.SelectedUnitId == u.Id)">@u.Name</option>
                                }
                            </select>
                        </form>
                        <form asp-action="CopyPreviousWeek" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="targetWeekStart" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="unitId" value="@Model.SelectedUnitId" />
                            <button type="submit" class="btn btn-sm btn-outline-info" onclick="return confirm('Sao chép toàn bộ lịch phân ca từ tuần trước sang tuần này?');">
                                <i class="ti ti-copy me-1"></i>Sao chép tuần trước
                            </button>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalApplyRotationQuick">
                            <i class="ti ti-rotate me-1"></i>Áp mẫu xoay ca cho nhóm
                        </button>
                    </div>
                </div>

                <!-- Palette các thẻ Ca làm việc có thể kéo thả -->
                <div class="col-xl-5">
                    <div class="d-flex flex-wrap align-items-center justify-content-xl-end gap-2">
                        <span class="fs-7 text-muted fw-semibold"><i class="ti ti-click me-1"></i>Nhấp ô để gán/sửa/xóa • Shift+Click hoặc kéo quét để chọn nhiều ô:</span>
                        @foreach (var s in Model.WorkShifts)
                        {
                            <div draggable="true"
                                 ondragstart="onShiftDragStart(event, @s.Id, '@s.ShiftCode', '@s.StartTime.ToString("HH:mm")-@s.EndTime.ToString("HH:mm")', false, '@s.BadgeColorClass')"
                                 class="badge border px-3 py-2 @s.BadgeColorClass"
                                 style="cursor: grab; user-select: none;"
                                 title="Kéo thả ca @s.ShiftName vào ô lịch bên dưới">
                                <i class="ti ti-grip-vertical me-1"></i><strong>@s.ShiftCode</strong> (@s.StartTime.ToString("HH:mm")-@s.EndTime.ToString("HH:mm"))
                            </div>
                        }
                        <div draggable="true"
                             ondragstart="onShiftDragStart(event, null, 'OFF', 'Nghỉ', true, 'bg-secondary-subtle text-secondary border-secondary-subtle')"
                             class="badge border px-3 py-2 bg-secondary-subtle text-secondary"
                             style="cursor: grab; user-select: none;"
                             title="Kéo thả ngày nghỉ tuần (OFF) vào ô lịch">
                            <i class="ti ti-grip-vertical me-1"></i><strong>OFF</strong> (Nghỉ tuần)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.ConflictWarnings is { Count: > 0 })
        {
            var groupedWarnings = Model.ConflictWarnings
                .GroupBy(w => new { w.EmployeeId, w.EmployeeCode, w.EmployeeName })
                .ToList();
            var statutoryLegalRef = Model.ConflictWarnings.Select(w => w.LegalReference).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
                ?? Model.StatutoryParameter?.LegalReference
                ?? "BLLĐ 45/2019/QH14";

            <div class="alert alert-warning border-warning mb-3 py-2" id="shiftConflictPanel" role="alert">
                <div class="d-flex align-items-center justify-content-between gap-2">
                    <div class="fw-semibold fs-7">
                        <i class="ti ti-alert-triangle me-1"></i>
                        <span>Phát hiện <strong>@Model.ConflictWarnings.Count</strong> cảnh báo xếp ca ở <strong>@groupedWarnings.Count</strong> nhân viên</span>
                        <span class="ms-2 text-muted" title="Căn cứ pháp lý: @statutoryLegalRef" data-bs-toggle="tooltip">
                            <i class="ti ti-info-circle"></i> Căn cứ pháp lý
                        </span>
                    </div>
                    <button class="btn btn-sm btn-outline-warning text-dark py-0 px-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseShiftWarnings" aria-expanded="false">
                        <i class="ti ti-chevron-down me-1"></i>Xem chi tiết (@groupedWarnings.Count NV)
                    </button>
                </div>
                <div class="collapse mt-2" id="collapseShiftWarnings">
                    <div class="list-group list-group-flush rounded border">
                        @foreach (var grp in groupedWarnings)
                        {
                            <div class="list-group-item py-2 px-3 bg-white">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div class="fw-semibold fs-7">@grp.Key.EmployeeCode — @grp.Key.EmployeeName</div>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var item in grp.OrderBy(x => x.WorkDate))
                                        {
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle fw-normal">@item.WorkDate.ToString("dd/MM"): @item.Message</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Floating Toolbar chọn nhiều ô -->
        <div id="bulkCellSelectionToolbar" class="vnm-card p-2 mb-3 border border-primary bg-primary-subtle d-none">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="fw-bold text-primary fs-7">
                    <i class="ti ti-select me-1"></i>Đã chọn <span id="selectedCellCount">0</span> ô lịch
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <select id="bulkCellShiftAction" class="form-select form-select-sm" style="width: 240px;">
                        @foreach (var s in Model.WorkShifts)
                        {
                            <option value="assign:@s.Id:@s.ShiftCode:@s.StartTime.ToString("HH:mm")-@s.EndTime.ToString("HH:mm"):@s.BadgeColorClass">
                                Gán ca @s.ShiftCode — @s.ShiftName (@s.StartTime.ToString("HH:mm")-@s.EndTime.ToString("HH:mm"))
                            </option>
                        }
                        <option value="off">Đánh dấu OFF (Nghỉ tuần)</option>
                        <option value="delete">Xóa phân ca đã chọn</option>
                    </select>
                    <input type="text" id="bulkCellNotes" class="form-control form-control-sm" style="width: 200px;" placeholder="Ghi chú (tùy chọn)..." />
                    <button type="button" class="btn btn-sm btn-primary" onclick="applyBulkCellSelection()">
                        <i class="ti ti-check me-1"></i>Áp dụng hàng loạt
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearCellSelection()">Bỏ chọn</button>
                </div>
            </div>
        </div>

        <div class="vnm-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0 text-center" id="shiftRosterTable" style="user-select: none;">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start" style="min-width: 230px;">Nhân viên & Đơn vị</th>
                            @foreach (var dt in Model.WeekDates)
                            {
                                var isSun = dt.DayOfWeek == DayOfWeek.Sunday;
                                <th style="min-width: 120px;" class="@(isSun ? "bg-danger-subtle text-danger" : "")">
                                    <div class="fw-bold">@Vinamilk.HRM.Application.TimeAttendance.ShiftAndHolidaySeeder.GetDayOfWeekVi(dt.DayOfWeek)</div>
                                    <div class="fs-7 font-monospace">@dt.ToString("dd/MM")</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.RosterRows)
                        {
                            <tr>
                                <td class="text-start">
                                    <div class="fw-bold">@row.FullName</div>
                                    <div class="text-muted fs-7">@row.EmployeeCode • @row.UnitName</div>
                                </td>
                                @foreach (var cell in row.DayCells)
                                {
                                    <td class="p-2 shift-drop-zone"
                                        data-emp-id="@row.EmployeeId"
                                        data-emp-code="@row.EmployeeCode"
                                        data-emp-name="@row.FullName"
                                        data-date="@cell.WorkDate.ToString("yyyy-MM-dd")"
                                        data-date-vi="@cell.WorkDate.ToString("dd/MM/yyyy")"
                                        data-shift-id="@(cell.WorkShiftId?.ToString() ?? "")"
                                        data-shift-code="@cell.ShiftCode"
                                        data-is-off="@(cell.IsDayOff ? "true" : "false")"
                                        data-has-schedule="@(cell.ScheduleId.HasValue ? "true" : "false")"
                                        data-notes="@(cell.Notes ?? "")"
                                        ondragover="onShiftDragOver(event)"
                                        ondragleave="onShiftDragLeave(event)"
                                        ondrop="onShiftDrop(event, @row.EmployeeId, '@cell.WorkDate.ToString("yyyy-MM-dd")')"
                                        style="transition: background 0.15s ease; cursor: pointer;">
                                        @if (cell.IsHoliday)
                                        {
                                            <div class="badge bg-danger text-white w-100 py-1 mb-1" title="@cell.HolidayName">
                                                <i class="ti ti-flag me-1"></i>LỄ: @cell.HolidayName
                                            </div>
                                        }
                                        <div class="shift-cell-badge badge border w-100 py-2 @cell.BadgeColorClass @(string.IsNullOrEmpty(cell.ConflictWarning) ? "" : "border-danger border-2")">
                                            <div class="fw-bold fs-6 shift-code-label">@cell.ShiftCode</div>
                                            <div class="fs-7 fw-normal mt-1 shift-time-label">@cell.TimeRangeText</div>
                                            <div class="text-danger fs-7 mt-1 shift-warn-label @(string.IsNullOrEmpty(cell.ConflictWarning) ? "d-none" : "")" title="@cell.ConflictWarning">
                                                <i class="ti ti-alert-triangle"></i> Cảnh báo
                                            </div>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 2: DANH MỤC CA LÀM VIỆC -->
    <div class="tab-pane fade @(activeTab == "shifts" ? "show active" : "")" id="tab-shifts">
        <div class="vnm-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Ca</th>
                            <th>Loại ca</th>
                            <th>Tên Ca làm việc</th>
                            <th>Giờ làm việc</th>
                            <th>Nghỉ giữa ca</th>
                            <th>Số giờ chuẩn</th>
                            <th>Qua đêm & Phụ cấp đêm</th>
                            <th>Cho phép trễ</th>
                            <th>Lượt xếp ca tuần này</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.WorkShifts)
                        {
                            <tr>
                                <td><span class="badge border px-2 py-1 @s.BadgeColorClass">@s.ShiftCode</span></td>
                                <td><span class="badge bg-info-subtle text-info border border-info-subtle">@s.ShiftType</span></td>
                                <td class="fw-bold">@s.ShiftName</td>
                                <td class="font-monospace">
                                    @s.StartTime.ToString("HH:mm") — @s.EndTime.ToString("HH:mm")
                                    @if (s.ShiftType == "Split" && s.SplitStartTime2.HasValue && s.SplitEndTime2.HasValue)
                                    {
                                        <div class="fs-7 text-muted">+ @s.SplitStartTime2.Value.ToString("HH:mm") — @s.SplitEndTime2.Value.ToString("HH:mm")</div>
                                    }
                                    @if (s.ShiftType == "Flexible" && s.CoreStartTime.HasValue && s.CoreEndTime.HasValue)
                                    {
                                        <div class="fs-7 text-primary">Core: @s.CoreStartTime.Value.ToString("HH:mm")-@s.CoreEndTime.Value.ToString("HH:mm")</div>
                                    }
                                </td>
                                <td class="font-monospace">
                                    @(s.BreakStartTime.HasValue ? $"{s.BreakStartTime:HH\\:mm} - {s.BreakEndTime:HH\\:mm}" + (s.IsBreakPaid ? " (Có lương)" : "") : "Ăn ca theo dây chuyền")
                                </td>
                                <td>@s.StandardHours.ToString("0.#") giờ (@s.WorkdayValue công)</td>
                                <td>
                                    @if (s.IsOvernight)
                                    {
                                        <span class="badge bg-dark text-white">Ca đêm (+@(s.NightShiftAllowanceRate * 100)% lương)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Ca ban ngày</span>
                                    }
                                </td>
                                <td>@s.GraceLateMinutes phút</td>
                                <td><span class="badge bg-primary-subtle text-primary">@s.AssignedSchedulesCount lượt</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 3: NGÀY LỄ TẾT VIỆT NAM -->
    <div class="tab-pane fade @(activeTab == "holidays" ? "show active" : "")" id="tab-holidays">
        <div class="vnm-card p-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <form method="get" class="d-flex flex-wrap align-items-center gap-2">
                <input type="hidden" name="tab" value="holidays" />
                <input type="hidden" name="weekStart" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="unitId" value="@Model.SelectedUnitId" />
                <label class="fw-semibold small mb-0">Xem lịch lễ năm:</label>
                <select name="year" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                    @for (int y = 2025; y <= 2030; y++)
                    {
                        <option value="@y" selected="@(Model.SelectedYear == y)">@y</option>
                    }
                </select>
                <span class="badge @(Model.Holidays.Count(h => !h.IsCompensatoryDay) >= 12 ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis")">
                    @Model.Holidays.Count(h => !h.IsCompensatoryDay) / 12 ngày lễ luật định năm @Model.SelectedYear
                </span>
            </form>
            <button type="button" class="btn btn-sm btn-warning fw-semibold" data-bs-toggle="modal" data-bs-target="#modalGenerateHolidaysYear">
                <i class="ti ti-calendar-cog me-1"></i>Sinh lịch lễ năm N (@nextHolidayYear)
            </button>
        </div>

        @if (Model.Holidays.Count == 0)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-3">
                <i class="ti ti-alert-triangle me-2"></i>
                <strong>Năm @Model.SelectedYear chưa có danh mục ngày nghỉ lễ!</strong>
                Vui lòng nhấn <strong>"Sinh lịch lễ năm N (@Model.SelectedYear)"</strong> hoặc dùng biểu mẫu bên dưới để sinh ngày Dương cố định và nhập Tết Âm lịch / Giỗ Tổ trước khi chốt công.
            </div>
        }

        <div class="vnm-card p-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-start border-4 border-warning">
            <div>
                <div class="fw-bold text-primary"><i class="ti ti-flag me-1"></i>Lễ Quốc khánh 2/9 gồm 2 ngày (Điều 112.1.đ BLLĐ 2019 • Thông báo 9441/TB-BNV)</div>
                <div class="small text-muted">Mặc định năm 2026 chọn ngày liền trước (01/09). HR có thể chuyển giữa 01/09 (trước) và 03/09 (sau) theo thông báo của Bộ Nội vụ / Thủ tướng.</div>
            </div>
            <form asp-action="SelectNationalDayAdjacentHoliday" method="post" class="d-flex align-items-center gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.SelectedYear" />
                <select name="choice" class="form-select form-select-sm" style="width: auto;">
                    <option value="Before" selected="@defaultNationalBefore">Ngày liền trước: 01/09 (Mặc định TB 9441/TB-BNV)</option>
                    <option value="After" selected="@(!defaultNationalBefore)">Ngày liền sau: 03/09</option>
                </select>
                <button type="submit" class="btn btn-sm vnm-btn-primary text-nowrap">
                    <i class="ti ti-check me-1"></i>Xác nhận ngày liền kề 2/9
                </button>
            </form>
        </div>
        <div class="vnm-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ngày tháng</th>
                            <th>Thứ trong tuần</th>
                            <th>Tên Ngày Lễ / Tết (Điều 112 BLLĐ sửa đổi)</th>
                            <th>Hưởng nguyên lương</th>
                            <th>Hệ số lương làm thêm (OT)</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Holidays)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-danger">@h.HolidayDate.ToString("dd/MM/yyyy")</td>
                                <td>@h.DayOfWeekVi</td>
                                <td class="fw-semibold">
                                    @h.HolidayName
                                    @if (h.IsCompensatoryDay)
                                    {
                                        <span class="badge bg-info-subtle text-info ms-1">Nghỉ bù (@h.OriginalHolidayDate?.ToString("dd/MM"))</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(h.PolicyGroupName))
                                    {
                                        <span class="badge bg-primary-subtle text-primary ms-1">Nhóm: @h.PolicyGroupName</span>
                                    }
                                    @if (h.EffectiveFrom.HasValue)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary ms-1">HL: @h.EffectiveFrom.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    @if (h.NeedsHrVerification)
                                    {
                                        <span class="badge bg-warning-subtle text-warning ms-1" title="@h.LegalReference">Cần HR đối chiếu</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(h.LegalReference))
                                    {
                                        <div class="fs-7 fw-normal text-muted">@h.LegalReference</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success">100% lương cơ bản</span>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger fw-bold">x@(h.OvertimeMultiplier * 100)% (OT300)</span>
                                </td>
                                <td class="text-end">
                                    <form asp-action="DeleteHoliday" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@h.Id" />
                                        <input type="hidden" name="year" value="@Model.SelectedYear" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa ngày lễ">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 4: XOAY CA TỰ ĐỘNG (3 CA 4 KÍP) & ĐỔI CA GIỮA 2 NHÂN VIÊN -->
    <div class="tab-pane fade @(activeTab == "rotation-swap" ? "show active" : "")" id="tab-rotation-swap">
        <div class="row g-3">
            <div class="col-lg-5">
                <div class="vnm-card p-3 h-100">
                    <h6 class="fw-bold mb-3"><i class="ti ti-rotate me-1 text-primary"></i>Sinh lịch Xoay ca Tự động (3 ca 4 kíp)</h6>
                    <form asp-action="GenerateRotation" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label fs-7 fw-semibold">Mẫu xoay ca</label>
                            <select name="patternId" class="form-select form-select-sm" required>
                                @foreach (var p in (Model.RotationPatterns ?? Array.Empty<Vinamilk.HRM.Application.TimeAttendance.ShiftRotationPatternDto>()))
                                {
                                    <option value="@p.Id">@p.PatternName (@p.ShiftSequenceCsv)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fs-7 fw-semibold">Đơn vị áp dụng</label>
                            <select name="organizationUnitId" class="form-select form-select-sm">
                                <option value="">Tất cả nhân viên đang làm việc</option>
                                @foreach (var u in Model.Units)
                                {
                                    <option value="@u.Id">@u.Name (@u.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fs-7 fw-semibold">Từ ngày</label>
                                <input type="date" name="startDate" class="form-control form-control-sm" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label fs-7 fw-semibold">Số tuần sinh lịch</label>
                                <input type="number" name="weeksCount" class="form-control form-control-sm" value="4" min="1" max="52" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="ti ti-sparkles me-1"></i>Sinh lịch xoay ca tự động
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="vnm-card p-3 h-100">
                    <h6 class="fw-bold mb-3"><i class="ti ti-arrows-exchange me-1 text-success"></i>Đề nghị Đổi ca giữa 2 Nhân viên</h6>
                    <form asp-action="SubmitSwap" method="post" class="row g-2 mb-3 border-bottom pb-3">
                        @Html.AntiForgeryToken()
                        <div class="col-md-6">
                            <label class="form-label fs-7 fw-semibold">Nhân viên đề nghị</label>
                            <select name="requesterEmployeeId" class="form-select form-select-sm" required>
                                @foreach (var e in (Model.EmployeesLookup ?? Array.Empty<Vinamilk.HRM.Application.Workflows.SimpleLookupDto>()))
                                {
                                    <option value="@e.Id">@e.Code - @e.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fs-7 fw-semibold">Ngày của NV đề nghị</label>
                            <input type="date" name="requesterWorkDate" class="form-control form-control-sm" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fs-7 fw-semibold">Nhân viên đổi cùng</label>
                            <select name="targetEmployeeId" class="form-select form-select-sm" required>
                                @foreach (var e in (Model.EmployeesLookup ?? Array.Empty<Vinamilk.HRM.Application.Workflows.SimpleLookupDto>()))
                                {
                                    <option value="@e.Id">@e.Code - @e.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fs-7 fw-semibold">Ngày của NV đổi cùng</label>
                            <input type="date" name="targetWorkDate" class="form-control form-control-sm" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-9">
                            <input type="text" name="reason" class="form-control form-control-sm" placeholder="Lý do đổi ca..." required />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-outline-primary btn-sm w-100">Gửi đơn đổi ca</button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>NV Đề nghị</th>
                                    <th>NV Đổi cùng</th>
                                    <th>Lý do</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Duyệt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in (Model.ShiftSwapRequests ?? Array.Empty<Vinamilk.HRM.Application.TimeAttendance.ShiftSwapRequestItemDto>()))
                                {
                                    <tr>
                                        <td class="fs-7"><strong>@r.RequesterName</strong><br /><span class="text-muted">@r.RequesterWorkDate.ToString("dd/MM/yyyy")</span></td>
                                        <td class="fs-7"><strong>@r.TargetName</strong><br /><span class="text-muted">@r.TargetWorkDate.ToString("dd/MM/yyyy")</span></td>
                                        <td class="fs-7">@r.Reason</td>
                                        <td><span class="badge @(r.Status == "Approved" ? "bg-success-subtle text-success" : r.Status == "Rejected" ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning")">@r.Status</span></td>
                                        <td class="text-end">
                                            @if (r.Status == "Pending")
                                            {
                                                <form asp-action="ProcessSwap" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="requestId" value="@r.Id" />
                                                    <input type="hidden" name="approve" value="true" />
                                                    <button type="submit" class="btn btn-xs btn-success" title="Duyệt"><i class="ti ti-check"></i></button>
                                                </form>
                                                <form asp-action="ProcessSwap" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="requestId" value="@r.Id" />
                                                    <input type="hidden" name="approve" value="false" />
                                                    <button type="submit" class="btn btn-xs btn-outline-danger" title="Từ chối"><i class="ti ti-x"></i></button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 5: NHÓM CHÍNH SÁCH (POLICY GROUP) & THAM SỐ PHÁP LÝ -->
    <div class="tab-pane fade @(activeTab == "policies" ? "show active" : "")" id="tab-policies">
        @if (Model.StatutoryParameter != null)
        {
            var st = Model.StatutoryParameter;
            <div class="alert alert-info border-info mb-3 fs-7">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <strong><i class="ti ti-scale me-1"></i>Tham số Pháp lý Chấm công (hiệu lực từ @st.EffectiveFrom.ToString("dd/MM/yyyy")):</strong>
                    @if (st.NeedsHrVerification)
                    {
                        <span class="badge bg-warning text-dark">NeedsHrVerification = true (Cần HR đối chiếu)</span>
                    }
                </div>
                <div>
                    Giờ làm đêm: <strong>@st.NightWorkStartTime.ToString("HH:mm")–@st.NightWorkEndTime.ToString("HH:mm")</strong> |
                    Nghỉ tối thiểu giữa 2 ca: <strong>@st.MinInterShiftRestHours.ToString("0.#")h</strong> |
                    Trần giờ thường tuần: <strong>@st.MaxNormalWeeklyHours.ToString("0.#")h</strong> |
                    Trần OT: <strong>@st.MaxMonthlyOvertimeHours.ToString("0.#")h/tháng</strong>, <strong>@st.MaxYearlyOvertimeHours.ToString("0.#")h/năm</strong> |
                    Căn cứ: <em>@st.LegalReference</em>
                </div>
            </div>
        }

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="vnm-card overflow-hidden">
                    <div class="p-3 border-bottom fw-bold"><i class="ti ti-list-check me-1 text-primary"></i>Danh sách Nhóm chính sách chấm công</div>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm align-middle mb-0 fs-7">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã</th>
                                    <th>Tên nhóm</th>
                                    <th>Ân hạn</th>
                                    <th>Làm tròn</th>
                                    <th>Ngưỡng 1/2 & 0 công</th>
                                    <th>Quota giải trình</th>
                                    <th>Đang gán</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pg in (Model.PolicyGroups ?? Array.Empty<Vinamilk.HRM.Application.TimeAttendance.PolicyGroupSummaryDto>()))
                                {
                                    <tr>
                                        <td>
                                            <strong>@pg.PolicyCode</strong>
                                            @if (pg.IsCompanyDefault)
                                            {
                                                <span class="badge bg-primary-subtle text-primary">Mặc định</span>
                                            }
                                        </td>
                                        <td>@pg.PolicyName</td>
                                        <td>@pg.GraceLateMinutes p</td>
                                        <td>@pg.RoundingIntervalMinutes p (@pg.RoundingMode)</td>
                                        <td>&gt;@pg.HalfDayLateThresholdMinutes p / &gt;@pg.ZeroDayLateThresholdMinutes p</td>
                                        <td>@pg.MaxMissedPunchExplanationsPerMonth/tháng (@pg.MissedPunchOverQuotaAction)</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@pg.AssignmentCount phạm vi</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="vnm-card p-3 mb-3">
                    <h6 class="fw-bold mb-2">Tạo / Cập nhật Nhóm chính sách</h6>
                    <form asp-action="SavePolicyGroup" method="post" class="row g-2 fs-7">
                        @Html.AntiForgeryToken()
                        <div class="col-4"><input name="policyCode" class="form-control form-control-sm" placeholder="Mã (VD: PLANT_PRO)" required /></div>
                        <div class="col-8"><input name="policyName" class="form-control form-control-sm" placeholder="Tên nhóm chính sách" required /></div>
                        <div class="col-4"><label class="form-label mb-0">Ân hạn trễ (p)</label><input type="number" name="graceLateMinutes" value="5" class="form-control form-control-sm" /></div>
                        <div class="col-4"><label class="form-label mb-0">Bước tròn (p)</label><select name="roundingIntervalMinutes" class="form-select form-select-sm"><option value="0">0</option><option value="5" selected>5</option><option value="10">10</option><option value="15">15</option></select></div>
                        <div class="col-4"><label class="form-label mb-0">Kiểu tròn</label><select name="roundingMode" class="form-select form-select-sm"><option value="None">None</option><option value="Nearest" selected>Nearest</option><option value="Ceiling">Ceiling</option><option value="Floor">Floor</option></select></div>
                        <div class="col-4"><label class="form-label mb-0">Nửa công (&gt;p)</label><input type="number" name="halfDayLateThresholdMinutes" value="60" class="form-control form-control-sm" /></div>
                        <div class="col-4"><label class="form-label mb-0">Mất công (&gt;p)</label><input type="number" name="zeroDayLateThresholdMinutes" value="240" class="form-control form-control-sm" /></div>
                        <div class="col-4"><label class="form-label mb-0">Quota quên công</label><input type="number" name="maxMissedPunchExplanationsPerMonth" value="3" class="form-control form-control-sm" /></div>
                        <div class="col-6"><label class="form-label mb-0">Xử lý vượt quota</label><select name="missedPunchOverQuotaAction" class="form-select form-select-sm"><option value="FixedFine">Phạt tiền</option><option value="DeductHalfDay">Trừ 0.5 công</option><option value="DeductFullDay">Trừ 1 công</option></select></div>
                        <div class="col-6"><label class="form-label mb-0">Tiền phạt (VNĐ)</label><input type="number" name="missedPunchPenaltyAmount" value="100000" class="form-control form-control-sm" /></div>
                        <div class="col-8"><label class="form-label mb-0">Ngày làm trong tuần</label><input name="weeklyWorkdaysMask" value="Mon,Tue,Wed,Thu,Fri" class="form-control form-control-sm" /></div>
                        <div class="col-4"><label class="form-label mb-0">Trần tuần (h)</label><input type="number" step="0.5" name="maxWeeklyWorkingHoursOverride" class="form-control form-control-sm" /></div>
                        <input type="hidden" name="graceEarlyMinutes" value="5" />
                        <input type="hidden" name="requireApprovedOvertimeRequest" value="true" />
                        <div class="col-12 mt-2"><button type="submit" class="btn btn-primary btn-sm w-100">Lưu Nhóm chính sách</button></div>
                    </form>
                </div>

                <div class="vnm-card p-3">
                    <h6 class="fw-bold mb-2">Gán Nhóm chính sách (NV &gt; Chức danh &gt; Đơn vị)</h6>
                    <form asp-action="AssignPolicyGroup" method="post" class="row g-2 fs-7">
                        @Html.AntiForgeryToken()
                        <div class="col-12">
                            <select name="policyGroupId" class="form-select form-select-sm" required>
                                @foreach (var pg in (Model.PolicyGroups ?? Array.Empty<Vinamilk.HRM.Application.TimeAttendance.PolicyGroupSummaryDto>()))
                                {
                                    <option value="@pg.Id">@pg.PolicyCode - @pg.PolicyName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <select name="employeeId" class="form-select form-select-sm">
                                <option value="">-- Hoặc gán theo Nhân viên (Ưu tiên 1) --</option>
                                @foreach (var e in (Model.EmployeesLookup ?? Array.Empty<Vinamilk.HRM.Application.Workflows.SimpleLookupDto>()))
                                {
                                    <option value="@e.Id">@e.Code - @e.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <select name="positionId" class="form-select form-select-sm">
                                <option value="">-- Hoặc Chức danh (Ưu tiên 2) --</option>
                                @foreach (var pos in (Model.PositionsLookup ?? Array.Empty<Vinamilk.HRM.Application.Workflows.SimpleLookupDto>()))
                                {
                                    <option value="@pos.Id">@pos.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <select name="organizationUnitId" class="form-select form-select-sm">
                                <option value="">-- Hoặc Đơn vị (Ưu tiên 3) --</option>
                                @foreach (var u in Model.Units)
                                {
                                    <option value="@u.Id">@u.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12"><button type="submit" class="btn btn-outline-primary btn-sm w-100">Áp dụng Chính sách</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Phân ca Hàng loạt -->
<div class="modal fade" id="modalBulkSchedule" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="BulkAssignSchedule" method="post" class="modal-content border-0 shadow">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="ti ti-calendar-plus text-primary me-2"></i>Phân ca Hàng loạt theo Đơn vị / Khoảng ngày</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Chọn Đơn vị / Nhà máy áp dụng (*)</label>
                    <select name="organizationUnitId" class="form-select" required>
                        @foreach (var u in Model.Units)
                        {
                            <option value="@u.Id">@u.Name (@u.Code)</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Từ ngày (*)</label>
                        <input type="date" name="fromDate" class="form-control" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Đến ngày (*)</label>
                        <input type="date" name="toDate" class="form-control" value="@Model.WeekEndDate.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ca làm việc áp dụng (*)</label>
                    <select name="workShiftId" class="form-select">
                        @foreach (var s in Model.WorkShifts)
                        {
                            <option value="@s.Id">@s.ShiftCode — @s.ShiftName (@s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm"))</option>
                        }
                    </select>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="isDayOff" value="true" id="chkBulkDayOff" />
                    <label class="form-check-label" for="chkBulkDayOff">Đánh dấu là Ngày nghỉ tuần (OFF)</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary">Thực hiện Phân ca</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Thêm Ca làm việc -->
<div class="modal fade" id="modalSaveShift" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="SaveWorkShift" method="post" class="modal-content border-0 shadow">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Thiết lập Ca làm việc</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mã Ca (*)</label>
