@model Vinamilk.HRM.Application.TimeAttendance.MonthlyAttendanceBoardDto
@{
    ViewData["Title"] = $"Bảng Chấm Công Tháng {Model.Month:D2}/{Model.Year} • GPS/QR • OT & Giải trình";
    ViewData["BreadcrumbParent"] = "Chấm công & Nghỉ phép (Phiên 6)";
    string activeTab = ViewBag.ActiveTab as string ?? "matrix";
    Vinamilk.HRM.Infrastructure.Services.AttendanceImportPreviewResult? importPreview = null;
    if (TempData["ImportPreviewJson"] is string previewJson && !string.IsNullOrWhiteSpace(previewJson))
    {
        importPreview = System.Text.Json.JsonSerializer.Deserialize<Vinamilk.HRM.Infrastructure.Services.AttendanceImportPreviewResult>(previewJson);
    }
    var deviceList = Model.Devices ?? Array.Empty<Vinamilk.HRM.Application.TimeAttendance.AttendanceDeviceDto>();
    var mappingList = Model.DeviceMappings ?? Array.Empty<Vinamilk.HRM.Application.TimeAttendance.EmployeeDeviceMappingDto>();
    var unmappedList = Model.UnmappedLogs ?? Array.Empty<Vinamilk.HRM.Application.TimeAttendance.UnmappedAttendanceLogDto>();
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="ti ti-calendar-time text-primary me-2"></i>Quản trị Chấm công Đa kênh, Làm thêm giờ (OT) & Giải trình Công
        </h2>
        <p class="text-secondary mb-0">
            Import Máy chấm công/Excel • Chấm công Web GPS Geofencing & QR Động • Bảng công 31 ngày • Đi muộn/Về sớm, OT, Công tác & Khóa bảng công
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalImportAttendance">
            <i class="ti ti-file-import me-1"></i>Import Máy chấm công / Excel
        </button>
        <a href="/Attendance/ExportExcel?month=@Model.Month&year=@Model.Year&unitId=@Model.SelectedUnitId" class="btn btn-outline-success">
            <i class="ti ti-file-spreadsheet me-1"></i>Xuất Excel Bảng công (.xlsx)
        </a>
        <form asp-action="RecalculateMonth" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="month" value="@Model.Month" />
            <input type="hidden" name="year" value="@Model.Year" />
            <button type="submit" class="btn btn-outline-info" @(Model.IsMonthLocked ? "disabled" : "")>
                <i class="ti ti-refresh me-1"></i>Tổng hợp lại Công
            </button>
        </form>
        <form asp-action="ToggleLockMonth" method="post" class="d-inline"
              onsubmit="@(!Model.IsMonthLocked && Model.HolidayCountInYear == 0 ? $"return confirm('CẢNH BÁO: Năm {Model.Year} chưa có danh mục ngày nghỉ lễ! Bạn có chắc chắn vẫn muốn khóa bảng công tháng {Model.Month:D2}/{Model.Year}?');" : "")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="month" value="@Model.Month" />
            <input type="hidden" name="year" value="@Model.Year" />
            <input type="hidden" name="lockState" value="@(Model.IsMonthLocked ? "false" : "true")" />
            @if (Model.IsMonthLocked)
            {
                <button type="submit" class="btn btn-warning">
                    <i class="ti ti-lock-open me-1"></i>Mở khóa Bảng công T@(Model.Month.ToString("D2"))
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-danger">
                    <i class="ti ti-lock me-1"></i>Khóa Bảng công Chuyển Tính lương
                </button>
            }
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-3">
        <i class="ti ti-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3">
        <i class="ti ti-alert-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm mb-3">
        <i class="ti ti-alert-circle me-2"></i>@TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.HolidayCountInYear == 0)
{
    <div class="alert alert-danger border-0 shadow-sm d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <i class="ti ti-calendar-exclamation fs-5 me-2"></i>
            <strong>CẢNH BÁO TRƯỚC KHI CHỐT CÔNG:</strong> Năm <strong>@Model.Year</strong> chưa có danh mục ngày nghỉ lễ (0 ngày lễ trong hệ thống). Nếu chốt công ngay lúc này, các ngày lễ năm @Model.Year sẽ không tự động tính ký hiệu <strong>L</strong> hoặc hệ số OT 300%!
        </div>
        <a href="/Shifts?year=@Model.Year&tab=holidays" class="btn btn-sm btn-danger text-nowrap">
            <i class="ti ti-calendar-plus me-1"></i>Sinh lịch lễ năm @Model.Year
        </a>
    </div>
}
else if (Model.UnverifiedHolidaysInYear > 0 && !Model.IsMonthLocked)
{
    <div class="alert alert-info border-0 shadow-sm d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <i class="ti ti-info-circle me-2"></i>
            Năm <strong>@Model.Year</strong> hiện có <strong>@Model.HolidayCountInYear</strong> ngày lễ, trong đó <strong>@Model.UnverifiedHolidaysInYear</strong> ngày đang chờ HR đối chiếu trước khi chốt công cuối kỳ.
        </div>
        <a href="/Shifts?year=@Model.Year&tab=holidays" class="btn btn-sm btn-outline-primary text-nowrap">
            Kiểm tra lịch lễ @Model.Year
        </a>
    </div>
}

@if (Model.IsMonthLocked)
{
    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center justify-content-between mb-3">
        <div>
            <i class="ti ti-lock-check fs-4 me-2"></i>
            <strong>BẢNG CHẤM CÔNG THÁNG @Model.Month.ToString("D2")/@Model.Year ĐÃ KHÓA SỔ!</strong>
            Người khóa: <strong>@(Model.LockedBy ?? "huyen.ntt")</strong> lúc @(Model.LockedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Hôm nay"). Mọi thao tác sửa đổi/import đều được bảo vệ để phục vụ tính lương.
        </div>
        <span class="badge bg-dark">LOCKED FOR PAYROLL</span>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="vnm-card p-3 h-100 border-start border-4 border-primary">
            <div class="text-secondary fs-7 text-uppercase fw-semibold">Công chuẩn Tháng @Model.Month.ToString("D2")/@Model.Year</div>
            <div class="fs-2 fw-bold text-primary mt-1">@Model.StandardWorkdaysInMonth.ToString("0.#") công</div>
            <div class="fs-7 text-muted">Nhân sự có bảng công: <strong>@Model.TotalPresentToday</strong></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="vnm-card p-3 h-100 border-start border-4 border-danger">
            <div class="text-secondary fs-7 text-uppercase fw-semibold">Lượt Đi muộn / Về sớm</div>
            <div class="fs-2 fw-bold text-danger mt-1">@Model.TotalLateCasesInMonth lượt</div>
            <div class="fs-7 text-muted">Có thể gửi Giải trình qua Workflow</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="vnm-card p-3 h-100 border-start border-4 border-warning">
            <div class="text-secondary fs-7 text-uppercase fw-semibold">Tổng Giờ Làm thêm (OT)</div>
            <div class="fs-2 fw-bold text-warning mt-1">@Model.TotalOtHoursInMonth.ToString("0.#") giờ</div>
            <div class="fs-7 text-muted">Kiểm soát trần 40h/tháng • 200h/năm</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="vnm-card p-3 h-100 border-start border-4 border-info">
            <div class="text-secondary fs-7 text-uppercase fw-semibold">Lượt Ngày Đi Công tác (CT)</div>
            <div class="fs-2 fw-bold text-info mt-1">@Model.TotalBusinessTripDays ngày</div>
            <div class="fs-7 text-muted">Tính 100% ngày công hưởng lương</div>
        </div>
    </div>
</div>

<!-- Navigation Tabs -->
<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
        <button class="nav-link @(activeTab == "matrix" ? "active" : "") fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-matrix" type="button">
            <i class="ti ti-table me-1"></i>Bảng công Tháng @Model.Month.ToString("D2")/@Model.Year (@Model.MatrixRows.Count NV)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "gpsqr" ? "active" : "") fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-gpsqr" type="button">
            <i class="ti ti-map-pin-check me-1"></i>Chấm công Web GPS Geofencing & QR Động
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "overtime" ? "active" : "") fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-overtime" type="button">
            <i class="ti ti-clock-plus me-1"></i>Quản lý Làm thêm giờ - OT (@Model.OvertimeRequests.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "explanations" ? "active" : "") fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-explanations" type="button">
            <i class="ti ti-file-description me-1"></i>Giải trình Chấm công & Công tác (@Model.Explanations.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "devices" ? "active" : "") fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-devices" type="button">
            <i class="ti ti-cpu me-1"></i>Máy chấm công, Mapping & Nhập tay HR (@unmappedList.Count chờ)
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- TAB 1: MA TRẬN BẢNG CHẤM CÔNG 31 NGÀY -->
    <div class="tab-pane fade @(activeTab == "matrix" ? "show active" : "")" id="tab-matrix">
        <div class="vnm-card p-3 mb-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fs-7 fw-semibold">Tháng</label>
                    <select name="month" class="form-select form-select-sm">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(Model.Month == m)">Tháng @m.ToString("D2")</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fs-7 fw-semibold">Năm</label>
                    <select name="year" class="form-select form-select-sm">
                        <option value="2025" selected="@(Model.Year == 2025)">2025</option>
                        <option value="2026" selected="@(Model.Year == 2026)">2026</option>
                        <option value="2027" selected="@(Model.Year == 2027)">2027</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fs-7 fw-semibold">Đơn vị / Nhà máy / Trang trại</label>
                    <select name="unitId" class="form-select form-select-sm">
                        <option value="">-- Toàn bộ đơn vị --</option>
                        @foreach (var u in Model.Units)
                        {
                            <option value="@u.Id" selected="@(Model.SelectedUnitId == u.Id)">@u.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fs-7 fw-semibold">Tìm Mã NV / Họ tên</label>
                    <input type="text" name="search" class="form-control form-control-sm" value="@Model.SearchKeyword" placeholder="Nhập mã VNM-0001 hoặc tên..." />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="ti ti-search me-1"></i>Xem Bảng công
                    </button>
                </div>
            </form>

            <!-- Chú giải ký hiệu chấm công -->
            <div class="d-flex flex-wrap gap-2 mt-3 pt-2 border-top fs-7 align-items-center">
                <span class="fw-semibold text-muted">Ký hiệu:</span>
                <span class="badge bg-success-subtle text-success">X : Đi làm (1.0)</span>
                <span class="badge bg-warning-subtle text-warning-emphasis">½ : Nửa công (0.5)</span>
                <span class="badge bg-info-subtle text-info-emphasis">CT : Công tác (1.0)</span>
                <span class="badge bg-primary-subtle text-primary">P : Phép năm (1.0)</span>
                <span class="badge bg-info-subtle text-dark">R : Nghỉ riêng (1.0)</span>
                <span class="badge bg-danger text-white">L : Lễ Tết (1.0)</span>
                <span class="badge bg-warning text-dark">Ô / TS : Ốm / Thai sản</span>
                <span class="badge bg-secondary-subtle text-secondary">Ro : Không lương</span>
                <span class="badge bg-dark-subtle text-dark">KL : Vắng không phép</span>
                <span class="badge bg-danger-subtle text-danger border border-danger">TC : Thiếu chấm</span>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">Vàng đậm + ✎ : HR sửa tay</span>
                <span class="badge bg-light text-muted border">OFF : Nghỉ tuần</span>
            </div>

            <!-- Thanh Quy trình Chốt công 3 bước & Tính lại có tiến độ -->
            <div class="row g-2 mt-3 pt-3 border-top align-items-center">
                <div class="col-lg-7">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="fw-bold fs-7 text-primary"><i class="ti ti-shield-lock me-1"></i>Chốt công 3 bước (@Model.ClosingStatus):</span>
                        <form asp-action="AdvanceClosingStep" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="month" value="@Model.Month" />
                            <input type="hidden" name="year" value="@Model.Year" />
                            <input type="hidden" name="unitId" value="@Model.SelectedUnitId" />
                            <input type="hidden" name="actionStep" value="UnitSubmit" />
                            <button type="submit" class="btn btn-sm @(Model.ClosingStatus == "Open" ? "btn-outline-primary" : "btn-primary")" @(Model.IsMonthLocked ? "disabled" : "")>
                                1. HR đơn vị chốt
                            </button>
                        </form>
                        <form asp-action="AdvanceClosingStep" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="month" value="@Model.Month" />
                            <input type="hidden" name="year" value="@Model.Year" />
                            <input type="hidden" name="unitId" value="@Model.SelectedUnitId" />
                            <input type="hidden" name="actionStep" value="ManagerConfirm" />
                            <button type="submit" class="btn btn-sm @(Model.ClosingStatus == "ManagerConfirmed" || Model.ClosingStatus == "Locked" ? "btn-info text-white" : "btn-outline-info")" @(Model.IsMonthLocked ? "disabled" : "")>
                                2. Quản lý xác nhận
                            </button>
                        </form>
                        <form asp-action="AdvanceClosingStep" method="post" class="d-inline"
                              onsubmit="@(Model.HolidayCountInYear == 0 ? $"return confirm('CẢNH BÁO: Năm {Model.Year} chưa có danh mục ngày nghỉ lễ! Vẫn tiếp tục khóa bảng công?');" : "")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="month" value="@Model.Month" />
                            <input type="hidden" name="year" value="@Model.Year" />
                            <input type="hidden" name="unitId" value="@Model.SelectedUnitId" />
                            <input type="hidden" name="actionStep" value="FinalLock" />
                            <input type="hidden" name="forceLock" value="true" />
                            <button type="submit" class="btn btn-sm @(Model.IsMonthLocked ? "btn-danger" : "btn-outline-danger")" @(Model.IsMonthLocked ? "disabled" : "")>
                                3. HR tổng khóa
                            </button>
                        </form>
                        @if (Model.IsMonthLocked)
                        {
                            <button type="button" class="btn btn-sm btn-warning fw-bold" data-bs-toggle="modal" data-bs-target="#modalPostLockAdjustment">
                                <i class="ti ti-adjustments-plus me-1"></i>Điều chỉnh kỳ sau
                            </button>
                        }
                        @if (Model.ReviewDeadlineAt.HasValue)
                        {
                            <span class="badge bg-info-subtle text-info-emphasis fs-7">
                                Hạn NV xem/giải trình: @Model.ReviewDeadlineAt.Value.ToString("dd/MM HH:mm") UTC
                            </span>
                        }
                    </div>
                </div>
                <div class="col-lg-5">
                    <form asp-action="StartRecalculationBatch" method="post" class="d-flex flex-wrap gap-1 justify-content-lg-end align-items-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="month" value="@Model.Month" />
                        <input type="hidden" name="year" value="@Model.Year" />
                        <input type="hidden" name="unitId" value="@Model.SelectedUnitId" />
                        <select name="employeeId" class="form-select form-select-sm" style="max-width: 170px;">
                            <option value="">Tất cả NV (theo ĐV)</option>
                            @foreach (var emp in Model.ActiveEmployees)
                            {
                                <option value="@emp.Id">@emp.Name</option>
                            }
                        </select>
                        <input type="date" name="fromDate" class="form-control form-control-sm" style="max-width: 125px;" value="@(new DateOnly(Model.Year, Model.Month, 1).ToString("yyyy-MM-dd"))" />
                        <input type="date" name="toDate" class="form-control form-control-sm" style="max-width: 125px;" value="@(new DateOnly(Model.Year, Model.Month, Model.DaysInMonth).ToString("yyyy-MM-dd"))" />
                        <button type="submit" class="btn btn-sm btn-outline-success fw-semibold" @(Model.IsMonthLocked ? "disabled" : "")>
                            <i class="ti ti-calculator me-1"></i>Tính lại Engine
                        </button>
                    </form>
                    @if (Model.RecalculationBatches != null && Model.RecalculationBatches.Count > 0)
                    {
                        var latestBatch = Model.RecalculationBatches[0];
                        <div class="progress mt-1" style="height: 14px;" title="@latestBatch.Message">
                            <div class="progress-bar @(latestBatch.Status == "Completed" ? "bg-success" : "bg-primary progress-bar-striped progress-bar-animated")" role="progressbar" style="width: @latestBatch.ProgressPercent%;">
                                @latestBatch.BatchCode (@latestBatch.ProgressPercent% - @latestBatch.ProcessedEmployees/@latestBatch.TotalEmployees)
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="vnm-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.78rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start" style="min-width: 190px; position: sticky; left: 0; z-index: 2; background: var(--vnm-bg-surface);">Nhân sự</th>
                            @for (int d = 1; d <= Model.DaysInMonth; d++)
                            {
                                var dt = new DateOnly(Model.Year, Model.Month, d);
                                var isSun = dt.DayOfWeek == DayOfWeek.Sunday;
                                <th style="min-width: 34px;" class="@(isSun ? "bg-danger-subtle text-danger" : "")">
                                    <div>@d.ToString("D2")</div>
                                </th>
                            }
                            <th class="bg-primary-subtle text-primary">Thực tế</th>
                            <th class="bg-info-subtle text-info-emphasis">Phép/Lễ/R</th>
                            <th class="bg-danger-subtle text-danger">Trễ/Sớm/Quên</th>
                            <th class="bg-warning-subtle text-warning-emphasis">OT / Đêm</th>
                            <th class="bg-success-subtle text-success fw-bold">Công tính lương</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.MatrixRows)
                        {
                            var totalOt = row.TotalOtHours150 + row.TotalOtHours200 + row.TotalOtHours300;
                            <tr>
                                <td class="text-start" style="position: sticky; left: 0; z-index: 1; background: var(--vnm-bg-surface);">
                                    <div class="fw-bold">@row.FullName</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">@row.EmployeeCode • @row.UnitName</div>
                                </td>
                                @foreach (var cell in row.Days)
                                {
                                    var tooltip = $"Ngày {cell.Date:dd/MM}: Ký hiệu {cell.Symbol}" +
                                                  (cell.CheckInText != null ? $" | Vào {cell.CheckInText} - Ra {cell.CheckOutText}" : "") +
                                                  (cell.LateMinutes > 0 ? $" | Đi muộn {cell.LateMinutes} phút" : "") +
                                                  (cell.OvertimeHours > 0 ? $" | OT {cell.OvertimeHours:0.#}h" : "") +
                                                  (cell.EditReason != null ? $" | {cell.EditReason}" : "");
                                    <td class="@cell.CssClass" title="@tooltip" style="cursor: pointer; @(cell.IsManualEdited ? "outline: 2px solid #f59e0b; outline-offset: -2px;" : "")" onclick="openAttendanceCellModal(@row.EmployeeId, '@cell.Date.ToString("yyyy-MM-dd")')">
                                        <div>@cell.Symbol@(cell.IsManualEdited ? "✎" : "")</div>
                                        @if (cell.LateMinutes > 0)
                                        {
                                            <div style="font-size: 0.62rem;">-@cell.LateMinutes'</div>
                                        }
                                        else if (cell.OvertimeHours > 0)
                                        {
                                            <div class="text-primary" style="font-size: 0.62rem;">+@cell.OvertimeHours.ToString("0.#")h</div>
                                        }
                                    </td>
                                }
                                <td class="fw-bold">@row.ActualWorkdays.ToString("0.#")/@row.StandardWorkdays.ToString("0.#")</td>
                                <td>@((row.PaidLeaveDays + row.HolidayDays + row.TotalPaidPersonalLeaveDays).ToString("0.#"))</td>
                                <td class="@(row.TotalLateMinutes > 0 || row.TotalMissedPunchCount > 0 ? "text-danger fw-bold" : "text-muted")">
                                    @(row.TotalLateMinutes > 0 ? $"{row.TotalLateMinutes}p({row.TotalLateCount})" : "0") / @(row.TotalEarlyLeaveMinutes)s / Q:@row.TotalMissedPunchCount
                                </td>
                                <td class="@(totalOt > 0 || row.TotalNightHours > 0 ? "text-warning-emphasis fw-bold" : "text-muted")">
                                    @totalOt.ToString("0.#")h / Đ:@row.TotalNightHours.ToString("0.#")h
                                </td>
                                <td class="fw-bold text-success bg-success-subtle">@row.TotalPayableWorkdays.ToString("0.#")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 2: CHẤM CÔNG WEB GPS GEOFENCING & QUÉT MÃ QR ĐỘNG -->
    <div class="tab-pane fade @(activeTab == "gpsqr" ? "show active" : "")" id="tab-gpsqr">
        <div class="row g-3">
            <div class="col-lg-5">
                <div class="vnm-card p-4 h-100">
                    <h5 class="fw-bold mb-2">
                        <i class="ti ti-map-pin-check text-primary me-2"></i>Chấm công Web Định vị GPS (Haversine) & QR Động
                    </h5>
                    <p class="text-secondary fs-7 mb-3">
                        Hệ thống kiểm tra khoảng cách tọa độ GPS so với bán kính cho phép của Nhà máy / Văn phòng Vinamilk, xác thực mã QR Kiosk thay đổi mỗi 30 giây và chống chấm hộ theo ID thiết bị.
                    </p>

                    <div class="p-3 rounded border text-center mb-3" style="background: var(--vnm-bg-subtle);">
                        <div class="fs-7 text-muted text-uppercase fw-semibold">Mã QR Kiosk Động Hiện Hành (Xoay mỗi 30 giây)</div>
                        <div class="fs-3 fw-bold font-monospace text-primary my-1" id="vnmCurrentQrCode">@Model.CurrentDynamicQrToken</div>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('qrInputBox').value='@Model.CurrentDynamicQrToken'">
                            <i class="ti ti-qrcode me-1"></i>Điền mã QR này vào form chấm công
                        </button>
                    </div>

                    <form asp-action="WebCheckIn" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nhân viên thực hiện chấm công (*)</label>
                            <select name="employeeId" class="form-select" required>
                                @foreach (var emp in Model.ActiveEmployees)
                                {
                                    <option value="@emp.Id">@emp.Name</option>
                                }
                            </select>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Loại chấm công</label>
                                <select name="punchType" class="form-select">
                                    <option value="CheckIn">Vào ca (Check-In)</option>
                                    <option value="CheckOut">Tan ca (Check-Out)</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Phương thức xác thực</label>
                                <select name="sourceType" class="form-select" id="punchSourceSelect">
                                    <option value="MobileGps">Định vị GPS (Geofencing)</option>
                                    <option value="WebQr">Quét mã QR Động (WebQr)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold d-flex justify-content-between">
                                <span>Chọn nhanh Tọa độ Điểm chuẩn Vinamilk hoặc Lấy GPS trình duyệt</span>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="detectBrowserGps()">
                                    <i class="ti ti-current-location me-1"></i>Lấy GPS thiết bị
                                </button>
                            </label>
                            <select class="form-select form-select-sm mb-2" onchange="applyPresetLocation(this)">
                                @foreach (var loc in Model.GeofenceLocations)
                                {
                                    <option value="@loc.Latitude,@loc.Longitude">
                                        @loc.Name (Bán kính @loc.AllowedRadiusMeters m)
                                    </option>
                                }
                            </select>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label fs-7 text-muted">Vĩ độ (Latitude)</label>
                                    <input type="number" step="0.0001" name="latitude" id="gpsLatInput" class="form-control form-control-sm font-monospace" value="10.7296" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fs-7 text-muted">Kinh độ (Longitude)</label>
                                    <input type="number" step="0.0001" name="longitude" id="gpsLonInput" class="form-control form-control-sm font-monospace" value="106.7218" required />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mã QR xác thực (Nếu chọn phương thức WebQr)</label>
                            <input type="text" name="qrToken" id="qrInputBox" class="form-control font-monospace" value="@Model.CurrentDynamicQrToken" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Device Fingerprint / Mã thiết bị cá nhân (Chống chấm công hộ)</label>
                            <input type="text" name="clientDeviceId" id="clientDeviceIdBox" class="form-control font-monospace form-control-sm" placeholder="VD: IPHONE-15-VNM-001 (tùy chọn)" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                            <i class="ti ti-fingerprint me-1"></i>Xác nhận Chấm công Ngay
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="vnm-card overflow-hidden h-100">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                        <div class="fw-bold"><i class="ti ti-history text-primary me-1"></i>Nhật ký Chấm công Đa kênh Gần nhất (GPS / QR / Máy vân tay)</div>
                        <span class="badge bg-primary-subtle text-primary">@Model.RecentLogs.Count bản ghi</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Nhân viên</th>
                                    <th>Loại</th>
                                    <th>Nguồn / Thiết bị</th>
                                    <th>Tọa độ GPS & Địa điểm Geofence</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model.RecentLogs)
                                {
                                    <tr>
                                        <td class="font-monospace fs-7">@log.PunchTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td>
                                            <div class="fw-semibold">@log.FullName</div>
                                            <div class="text-muted fs-7">@log.EmployeeCode</div>
                                        </td>
                                        <td>
                                            <span class="badge @(log.PunchType == "CheckIn" ? "bg-success-subtle text-success" : "bg-info-subtle text-info-emphasis")">
                                                @log.PunchType
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold fs-7">@log.SourceType</div>
                                            <div class="text-muted fs-7 font-monospace">@log.DeviceId</div>
                                        </td>
                                        <td class="fs-7">
                                            <div>@log.LocationAddress</div>
                                            @if (log.Latitude.HasValue && log.Longitude.HasValue)
                                            {
                                                <span class="text-muted font-monospace">(@log.Latitude.Value.ToString("0.0000"), @log.Longitude.Value.ToString("0.0000"))</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(log.GeofenceStatus) && log.GeofenceStatus != "NotApplicable")
                                            {
                                                <span class="badge bg-light text-dark border ms-1">@log.GeofenceStatus</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(log.EnteredByUsername))
                                            {
                                                <div class="text-warning-emphasis">HR: @log.EnteredByUsername (@log.ManualReason)</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 3: QUẢN LÝ LÀM THÊM GIỜ (OVERTIME) -->
    <div class="tab-pane fade @(activeTab == "overtime" ? "show active" : "")" id="tab-overtime">
        <div class="row g-3">
            <div class="col-lg-4">
                <div class="vnm-card p-3">
                    <h5 class="fw-bold mb-2"><i class="ti ti-clock-plus text-primary me-2"></i>Đăng ký Làm thêm giờ (OT)</h5>
                    <p class="text-secondary fs-7">
                        Tự động kiểm tra trần OT <strong>40 giờ/tháng</strong> và <strong>200 giờ/năm</strong> theo Điều 107 Bộ luật Lao động 2019 và đẩy vào luồng duyệt <code>WF_OVERTIME</code>.
                    </p>
                    <form asp-action="SubmitOvertime" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Nhân viên đăng ký (*)</label>
                            <select name="employeeId" class="form-select" required>
                                @foreach (var emp in Model.ActiveEmployees)
                                {
                                    <option value="@emp.Id">@emp.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Ngày làm thêm (*)</label>
                            <input type="date" name="overtimeDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Từ giờ (*)</label>
                                <input type="time" name="startTime" class="form-control" value="17:30" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Đến giờ (*)</label>
                                <input type="time" name="endTime" class="form-control" value="20:30" required />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Loại hệ số OT (Điều 98 BLLĐ 2019)</label>
                            <select name="overtimeRateType" class="form-select">
                                <option value="OT150">OT150 — Ngày thường (Hưởng 150% đơn giá lương)</option>
                                <option value="OT200">OT200 — Ngày nghỉ hàng tuần (Hưởng 200%)</option>
                                <option value="OT300">OT300 — Ngày Lễ, Tết có hưởng lương (Hưởng 300%)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lý do & Nội dung công việc OT (*)</label>
                            <textarea name="reason" class="form-control" rows="2" placeholder="VD: Tăng ca đóng gói lô hàng sữa tươi xuất khẩu..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="ti ti-send me-1"></i>Gửi Đơn OT qua Workflow
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="vnm-card overflow-hidden">
                    <div class="p-3 border-bottom fw-bold">
                        Danh sách Đơn Làm thêm giờ & Theo dõi Trần OT (40h/tháng • 200h/năm)
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nhân viên</th>
                                    <th>Ngày & Khung giờ OT</th>
                                    <th>Số giờ & Hệ số</th>
                                    <th>Lũy kế Trần OT</th>
                                    <th>Trạng thái Workflow</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ot in Model.OvertimeRequests)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@ot.FullName</div>
                                            <div class="text-muted fs-7">@ot.EmployeeCode • @ot.UnitName</div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold font-monospace">@ot.OvertimeDate.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted fs-7">@ot.StartTime.ToString("HH:mm") - @ot.EndTime.ToString("HH:mm")</div>
                                            <div class="text-secondary fs-7">@ot.Reason</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-warning-subtle text-warning-emphasis fw-bold">@ot.RequestedHours.ToString("0.#") giờ</span>
                                            <div class="badge bg-dark mt-1">@ot.OvertimeRateType</div>
                                        </td>
                                        <td>
                                            <div class="fs-7">Tháng: <strong>@ot.EmployeeMonthlyOtTotal.ToString("0.#") / 40h</strong></div>
                                            <div class="progress my-1" style="height: 5px; width: 120px;">
                                                <div class="progress-bar @(ot.EmployeeMonthlyOtTotal > 32 ? "bg-danger" : "bg-primary")"
                                                     style="width: @Math.Min(100, (int)(ot.EmployeeMonthlyOtTotal / 40m * 100))%"></div>
                                            </div>
                                            <div class="fs-7 text-muted">Năm: @ot.EmployeeYearlyOtTotal.ToString("0.#") / 200h</div>
                                        </td>
                                        <td>
                                            @if (ot.Status == "Approved")
                                            {
                                                <span class="badge bg-success-subtle text-success">Đã duyệt (@ot.ApprovedHours.ToString("0.#")h)</span>
                                            }
                                            else if (ot.Status == "Rejected")
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Từ chối</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis">Chờ duyệt</span>
                                                <div class="mt-1">
                                                    <a href="/Workflows?entityType=OvertimeRequest" class="fs-7 text-primary text-decoration-none">
                                                        Xử lý tại Workflow <i class="ti ti-arrow-right"></i>
                                                    </a>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 4: GIẢI TRÌNH CHẤM CÔNG -->
    <div class="tab-pane fade @(activeTab == "explanations" ? "show active" : "")" id="tab-explanations">
        <div class="row g-3">
            <div class="col-lg-4">
                <div class="vnm-card p-3">
                    <h5 class="fw-bold mb-2"><i class="ti ti-file-description text-primary me-2"></i>Gửi Giải trình Chấm công</h5>
                    <p class="text-secondary fs-7">
                        Dành cho trường hợp quên chấm vân tay, lỗi nhận diện khuôn mặt hoặc đi gặp đối tác bên ngoài. Sau khi Workflow duyệt sẽ tự động xóa phút đi trễ và tính đủ 1.0 công.
                    </p>
                    <form asp-action="SubmitExplanation" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Nhân viên giải trình (*)</label>
                            <select name="employeeId" class="form-select" required>
                                @foreach (var emp in Model.ActiveEmployees)
                                {
                                    <option value="@emp.Id">@emp.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Ngày cần giải trình (*)</label>
                            <input type="date" name="attendanceDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Giờ vào thực tế</label>
                                <input type="time" name="proposedCheckIn" class="form-control" value="08:00" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Giờ ra thực tế</label>
                                <input type="time" name="proposedCheckOut" class="form-control" value="17:00" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lý do giải trình chi tiết (*)</label>
                            <textarea name="reason" class="form-control" rows="3" placeholder="VD: Đi họp với đối tác cung ứng bao bì Tetra Pak từ 07:45 sáng..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="ti ti-send me-1"></i>Trình duyệt Giải trình Công
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="vnm-card overflow-hidden">
                    <div class="p-3 border-bottom fw-bold">
                        Danh sách Các ngày Đi trễ / Cần giải trình hoặc Đã điều chỉnh Công
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nhân viên</th>
                                    <th>Ngày công</th>
                                    <th>Ký hiệu & Phút trễ</th>
                                    <th>Nội dung Giải trình / Ghi chú</th>
                                    <th>Trạng thái Duyệt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ex in Model.Explanations)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@ex.FullName</div>
                                            <div class="text-muted fs-7">@ex.EmployeeCode • @ex.UnitName</div>
                                        </td>
                                        <td class="font-monospace fw-semibold">@ex.AttendanceDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary me-1">@ex.CurrentSymbol</span>
                                            @if (ex.LateMinutes > 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Trễ @ex.LateMinutes phút</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success">Đủ công</span>
                                            }
                                        </td>
                                        <td class="fs-7">@ex.EditReason</td>
                                        <td>
                                            @if (ex.IsApproved || ex.WorkflowStatus == "Approved")
                                            {
                                                <span class="badge bg-success-subtle text-success"><i class="ti ti-check me-1"></i>Đã duyệt cập nhật công</span>
                                            }
                                            else if (ex.WorkflowStatus == "InProgress")
                                            {
                                                <a href="/Workflows?entityType=AttendanceExplanation" class="badge bg-warning-subtle text-warning-emphasis text-decoration-none">
                                                    Đang chờ duyệt (#WF-@ex.WorkflowInstanceId)
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Chưa gửi giải trình</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 5: MÁY CHẤM CÔNG, MAPPING, PREVIEW IMPORT & NHẬP TAY HR -->
    <div class="tab-pane fade @(activeTab == "devices" ? "show active" : "")" id="tab-devices">
        @if (importPreview != null)
        {
            <div class="vnm-card p-3 mb-3 border border-primary">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="ti ti-eye-check me-2"></i>Bước 2: Kết quả Preview Import Excel (Chưa ghi DB)
                    </h5>
                    <form asp-action="ConfirmImportExcel" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="month" value="@Model.Month" />
                        <input type="hidden" name="year" value="@Model.Year" />
                        <input type="hidden" name="previewRowsJson" value="@System.Text.Json.JsonSerializer.Serialize(importPreview.Rows)" />
                        <button type="submit" class="btn btn-success btn-sm fw-bold" @(importPreview.ValidCount == 0 ? "disabled" : "")>
                            <i class="ti ti-check me-1"></i>Xác nhận Ghi DB (@importPreview.ValidCount dòng hợp lệ)
                        </button>
                    </form>
                </div>
                <div class="table-responsive" style="max-height: 260px;">
                    <table class="table table-sm table-bordered mb-0 fs-7">
                        <thead class="table-light">
                            <tr>
                                <th>Dòng</th>
                                <th>Mã NV</th>
                                <th>Ngày công</th>
                                <th>Vào</th>
                                <th>Ra</th>
                                <th>Trạng thái</th>
                                <th>Ghi chú lỗi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in importPreview.Rows)
                            {
                                <tr class="@(r.IsValid ? "" : "table-danger")">
                                    <td>@r.RowNumber</td>
                                    <td class="font-monospace">@r.EmployeeCode</td>
                                    <td>@(r.WorkDate.HasValue ? r.WorkDate.Value.ToString("dd/MM/yyyy") : r.WorkDateText)</td>
                                    <td>@r.CheckInTime?.ToString("HH:mm")</td>
                                    <td>@r.CheckOutTime?.ToString("HH:mm")</td>
                                    <td>@(r.IsValid ? "Hợp lệ" : "Lỗi")</td>
                                    <td class="text-danger">@r.ValidationMessage</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="row g-3 mb-3">
            <div class="col-lg-5">
                <div class="vnm-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="fw-bold mb-0"><i class="ti ti-fingerprint text-primary me-2"></i>Đọc file Máy chấm công (.csv/.txt/.dat)</h5>
                        <form asp-action="RunDeviceSyncNow" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="month" value="@Model.Month" />
                            <input type="hidden" name="year" value="@Model.Year" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="ti ti-refresh me-1"></i>Chạy Sync Job
                            </button>
                        </form>
                    </div>
                    <form asp-action="IngestBiometricFile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="month" value="@Model.Month" />
                        <input type="hidden" name="year" value="@Model.Year" />
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Chọn Máy chấm công (*)</label>
                            <select name="deviceCode" class="form-select form-select-sm" required>
                                @foreach (var d in deviceList)
                                {
                                    <option value="@d.DeviceCode">@d.DeviceCode - @d.DeviceName (@d.ConnectorType)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold">File log xuất từ máy (.csv / .txt / .dat) (*)</label>
                            <input type="file" name="logFile" accept=".csv,.txt,.dat" class="form-control form-control-sm" required />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                            <i class="ti ti-upload me-1"></i>Đọc & Đồng bộ Log Máy chấm công
                        </button>
                    </form>

                    <hr class="my-3" />
                    <h6 class="fw-bold mb-2"><i class="ti ti-pencil text-warning me-1"></i>Nhập tay / Điều chỉnh công bởi HR (Bắt buộc lý do)</h6>
                    <form asp-action="UpsertManualAttendance" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="month" value="@Model.Month" />
                        <input type="hidden" name="year" value="@Model.Year" />
                        <div class="mb-2">
                            <select name="employeeId" class="form-select form-select-sm" required>
                                @foreach (var emp in Model.ActiveEmployees)
                                {
                                    <option value="@emp.Id">@emp.Name</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <input type="date" name="workDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-3">
                                <input type="time" name="checkInTime" class="form-control form-control-sm" value="08:00" required />
                            </div>
                            <div class="col-3">
                                <input type="time" name="checkOutTime" class="form-control form-control-sm" value="17:00" />
                            </div>
                            <div class="col-2">
                                <select name="attendanceSymbol" class="form-select form-select-sm">
                                    <option value="X">X</option>
                                    <option value="X/2">X/2</option>
                                    <option value="CT">CT</option>
                                    <option value="P">P</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-2">
                            <input type="text" name="reason" class="form-control form-control-sm" placeholder="Lý do nhập tay / sửa công HR (*)" required />
                        </div>
                        <button type="submit" class="btn btn-warning btn-sm w-100 fw-bold">
                            <i class="ti ti-device-floppy me-1"></i>Lưu công nhập tay HR (Ghi AuditLog)
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="vnm-card p-3 h-100">
                    <h5 class="fw-bold mb-2">
                        <i class="ti ti-link text-primary me-2"></i>Hàng chờ Chưa ánh xạ Mã Máy (@unmappedList.Count) & Ánh xạ Nhân viên
                    </h5>
                    <form asp-action="MapDeviceEmployee" method="post" class="row g-2 mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="month" value="@Model.Month" />
                        <input type="hidden" name="year" value="@Model.Year" />
                        <div class="col-md-4">
                            <select name="employeeId" class="form-select form-select-sm" required>
                                @foreach (var emp in Model.ActiveEmployees)
                                {
                                    <option value="@emp.Id">@emp.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input type="text" name="deviceUserCode" class="form-control form-control-sm" placeholder="Mã user trên máy (*)" required />
                        </div>
                        <div class="col-md-3">
                            <input type="text" name="deviceCode" class="form-control form-control-sm" placeholder="Mã máy (tùy chọn)" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-outline-success btn-sm w-100 fw-semibold">Map & Replay</button>
                        </div>
                    </form>

                    <div class="table-responsive" style="max-height: 220px;">
                        <table class="table table-sm table-hover mb-0 fs-7">
                            <thead class="table-light">
                                <tr>
                                    <th>Máy</th>
                                    <th>Mã trên máy</th>
                                    <th>Thời gian chấm</th>
                                    <th>Loại</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (unmappedList.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-3">Không có log chấm công nào đang chờ ánh xạ.</td></tr>
                                }
                                @foreach (var u in unmappedList)
                                {
                                    <tr>
                                        <td class="font-monospace">@u.DeviceCode</td>
                                        <td class="fw-bold text-danger font-monospace">@u.DeviceUserCode</td>
                                        <td class="font-monospace">@u.PunchTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td>@u.PunchType</td>
                                        <td><span class="badge bg-warning-subtle text-warning-emphasis">@u.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Import Excel Máy chấm công (Bước 1: Preview kiểm tra lỗi trước khi ghi DB) -->
<div class="modal fade" id="modalImportAttendance" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="PreviewImportExcel" method="post" enctype="multipart/form-data" class="modal-content border-0 shadow">
            @Html.AntiForgeryToken()
            <input type="hidden" name="month" value="@Model.Month" />
            <input type="hidden" name="year" value="@Model.Year" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="ti ti-file-import text-primary me-2"></i>Import 2 Bước từ Excel (Preview → Xác nhận)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info border-0 fs-7">
                    Bước 1 sẽ đọc và báo lỗi từng dòng (trùng log, sai ngày, mã NV không tồn tại) <strong>mà chưa ghi vào CSDL</strong>. Sau khi kiểm tra bảng Preview bạn mới bấm Xác nhận ghi DB.
                </div>
                <div class="mb-3">
                    <a href="/Attendance/DownloadImportTemplate" class="btn btn-sm btn-outline-primary">
                        <i class="ti ti-download me-1"></i>Tải File Excel Mẫu Import Chấm công (.xlsx)
                    </a>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold">Chọn file Excel (.xlsx) dữ liệu chấm công (*)</label>
                    <input type="file" name="excelFile" accept=".xlsx" class="form-control" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary">Kiểm tra Preview (Chưa ghi DB)</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Chi tiết Ô công (Click ô xem log + đơn liên quan) -->
<div class="modal fade" id="modalAttendanceCellDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="ti ti-calendar-event text-primary me-2"></i>Chi tiết Chấm công & Log nguồn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="attendanceCellDetailBody">
                <div class="text-center text-muted py-4">Đang tải chi tiết...</div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Điều chỉnh công kỳ sau (Truy lĩnh / Truy thu sau khi khóa) -->
<div class="modal fade" id="modalPostLockAdjustment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="CreatePostLockAdjustment" method="post" class="modal-content border-0 shadow">
            @Html.AntiForgeryToken()
            <input type="hidden" name="targetMonth" value="@Model.Month" />
            <input type="hidden" name="targetYear" value="@Model.Year" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="ti ti-adjustments-plus text-warning me-2"></i>Phiếu Điều chỉnh Công Kỳ Sau (Kỳ đã khóa @Model.Month.ToString("D2")/@Model.Year)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning fs-7 border-0">
                    Bảng công tháng @Model.Month.ToString("D2")/@Model.Year đã khóa cứng. Mọi chênh lệch công/OT sẽ được lập phiếu điều chỉnh truy lĩnh/truy thu áp dụng vào kỳ lương tiếp theo và ghi AuditLog.
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold">Nhân viên (*)</label>
                    <select name="employeeId" class="form-select form-select-sm" required>
                        @foreach (var emp in Model.ActiveEmployees)
                        {
                            <option value="@emp.Id">@emp.Name</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label fw-semibold fs-7">Ngày phát sinh điều chỉnh</label>
                        <input type="date" name="adjustmentDate" class="form-control form-control-sm" value="@(new DateOnly(Model.Year, Model.Month, 1).ToString("yyyy-MM-dd"))" required />
                    </div>
                    <div class="col-3">
                        <label class="form-label fw-semibold fs-7">Áp dụng Tháng</label>
                        <input type="number" name="appliedPayrollMonth" min="1" max="12" class="form-control form-control-sm" value="@(Model.Month == 12 ? 1 : Model.Month + 1)" required />
                    </div>
                    <div class="col-3">
                        <label class="form-label fw-semibold fs-7">Năm</label>
                        <input type="number" name="appliedPayrollYear" class="form-control form-control-sm" value="@(Model.Month == 12 ? Model.Year + 1 : Model.Year)" required />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4">
                        <label class="form-label fw-semibold fs-7">Loại điều chỉnh</label>
                        <select name="adjustmentType" class="form-select form-select-sm">
                            <option value="WorkdayDelta">Chênh lệch ngày công</option>
                            <option value="OtHoursDelta">Chênh lệch giờ OT</option>
                            <option value="NightHoursDelta">Chênh lệch giờ đêm</option>
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label fw-semibold fs-7">+/- Ngày công</label>
                        <input type="number" step="0.5" name="workdayDelta" class="form-control form-control-sm" value="1.0" required />
                    </div>
                    <div class="col-4">
                        <label class="form-label fw-semibold fs-7">+/- OT 150% (h)</label>
                        <input type="number" step="0.5" name="otHours150Delta" class="form-control form-control-sm" value="0" />
                    </div>
                </div>
                <input type="hidden" name="otHours200Delta" value="0" />
                <input type="hidden" name="otHours300Delta" value="0" />
                <input type="hidden" name="nightHoursDelta" value="0" />
                <div class="mb-2">
                    <label class="form-label fw-semibold fs-7">Lý do điều chỉnh kỳ sau (*)</label>
                    <input type="text" name="reason" class="form-control form-control-sm" placeholder="VD: Bổ sung xác nhận công tác bị sót sau chốt công..." required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-warning fw-bold">Tạo phiếu điều chỉnh</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        async function openAttendanceCellModal(employeeId, dateStr) {
            const modalEl = document.getElementById('modalAttendanceCellDetail');
            const bodyEl = document.getElementById('attendanceCellDetailBody');
            bodyEl.innerHTML = '<div class="text-center text-muted py-4">Đang tải chi tiết công & log...</div>';
            if (window.bootstrap) {
                window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
            try {
                const resp = await fetch(`/Attendance/CellDetails?employeeId=${employeeId}&date=${dateStr}`);
                if (!resp.ok) throw new Error('Không tải được chi tiết ô công.');
                const d = await resp.json();
                let logsHtml = d.logs && d.logs.length
                    ? d.logs.map(l => `<li><code>${l.punchTime}</code> | <b>${l.punchType}</b> | Nguồn: ${l.sourceType} (${l.deviceId || '-'}) ${l.manualReason ? '— ' + l.manualReason : ''}</li>`).join('')
                    : '<li class="text-muted">Không có log quét máy/GPS</li>';
                let reqsHtml = d.relatedRequests && d.relatedRequests.length
                    ? d.relatedRequests.map(r => `<li>${r}</li>`).join('')
                    : '<li class="text-muted">Không có đơn nghỉ / OT liên quan</li>';
                bodyEl.innerHTML = `
                    <div class="mb-2"><strong>${d.fullName}</strong> (${d.employeeCode}) • Ngày <strong>${d.workDate}</strong> • Ca: <span class="badge bg-primary-subtle text-primary">${d.shiftCode || 'HC'}</span> • Ký hiệu: <span class="badge bg-success">${d.statusCode}</span></div>
                    <div class="row g-2 mb-3 fs-7">
                        <div class="col-4 border rounded p-2">Công chuẩn: <b>${d.standardHours}h</b><br/>Giờ làm: <b>${d.workingHours}h</b><br/>Số công: <b>${d.workdayCount}</b></div>
                        <div class="col-4 border rounded p-2">Đi muộn: <b>${d.lateMinutes}p</b><br/>Về sớm: <b>${d.earlyLeaveMinutes}p</b><br/>Giờ đêm: <b>${d.nightShiftHours}h</b></div>
                        <div class="col-4 border rounded p-2">OT150: <b>${d.overtimeHours150Day}/${d.overtimeHours150Night}h</b><br/>OT200: <b>${d.overtimeHours200Day}/${d.overtimeHours200Night}h</b><br/>OT300: <b>${d.overtimeHours300Day}/${d.overtimeHours300Night}h</b></div>
                    </div>
                    <div class="mb-2"><strong>Nhật ký log nguồn:</strong><ul class="fs-7 mb-2">${logsHtml}</ul></div>
                    <div class="mb-2"><strong>Đơn nghỉ / OT liên quan:</strong><ul class="fs-7 mb-2">${reqsHtml}</ul></div>
                    <div class="text-muted fs-7">Ghi chú tính công: ${d.editReason || '-'}</div>`;
            } catch (err) {
                bodyEl.innerHTML = `<div class="alert alert-danger">${err.message}</div>`;
            }
        }
        function applyPresetLocation(selectEl) {
            if (!selectEl.value) return;
            const parts = selectEl.value.split(',');
            if (parts.length === 2) {
                document.getElementById('gpsLatInput').value = parts[0];
                document.getElementById('gpsLonInput').value = parts[1];
            }
        }

        function detectBrowserGps() {
            if (!navigator.geolocation) {
                if (window.VnmUI) window.VnmUI.toast('Trình duyệt không hỗ trợ Geolocation.', 'warning');
                return;
            }
            navigator.geolocation.getCurrentPosition(function (pos) {
                document.getElementById('gpsLatInput').value = pos.coords.latitude.toFixed(4);
                document.getElementById('gpsLonInput').value = pos.coords.longitude.toFixed(4);
                if (window.VnmUI) window.VnmUI.toast('Đã lấy tọa độ GPS thực tế từ trình duyệt!', 'success');
            }, function () {
                if (window.VnmUI) window.VnmUI.toast('Không thể truy cập GPS thiết bị, đang giữ tọa độ mặc định Trụ sở Vinamilk.', 'info');
            });
        }
    </script>
}

