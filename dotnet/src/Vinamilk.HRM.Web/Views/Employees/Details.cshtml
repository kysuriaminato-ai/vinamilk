@section Scripts {
    <script>
        let avatarImg = null;
        function drawAvatarCrop() {
            const canvas = document.getElementById('avatarCropCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const zoom = parseFloat(document.getElementById('avatarZoomRange')?.value || '1.2');

            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (avatarImg) {
                const w = canvas.width * zoom;
                const h = canvas.height * zoom;
                const x = (canvas.width - w) / 2;
                const y = (canvas.height - h) / 2;
                ctx.drawImage(avatarImg, x, y, w, h);
            } else {
                const grad = ctx.createLinearGradient(0, 0, 220, 220);
                grad.addColorStop(0, '#0213B0');
                grad.addColorStop(1, '#059669');
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, 220, 220);
                ctx.fillStyle = '#FFFFFF';
                ctx.font = 'bold 52px Be Vietnam Pro, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('@e.EmployeeCode', 110, 110);
            }
        }

        function loadAvatarForCrop(input) {
            if (!input.files || !input.files[0]) return;
            const reader = new FileReader();
            reader.onload = function (evt) {
                avatarImg = new Image();
                avatarImg.onload = () => drawAvatarCrop();
                avatarImg.src = evt.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }

        function prepareCroppedAvatar() {
            const canvas = document.getElementById('avatarCropCanvas');
            document.getElementById('croppedDataUrlInput').value = canvas.toDataURL('image/png');
        }

        document.addEventListener('DOMContentLoaded', () => drawAvatarCrop());
    </script>
}

