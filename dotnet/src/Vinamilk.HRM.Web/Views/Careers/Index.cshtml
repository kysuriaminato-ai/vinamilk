@model IReadOnlyList<Vinamilk.HRM.Web.Controllers.PublicJobCardVm>
@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
    int currentPage = (int)(ViewBag.CurrentPage ?? 1);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    int totalItems = (int)(ViewBag.TotalItems ?? Model.Count);
    string? q = ViewBag.SearchQuery as string;
}

<nav aria-label="Breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="/gioi-thieu">Giới thiệu</a></li>
        <li class="breadcrumb-item active" aria-current="page">Tuyển dụng</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="fw-extrabold mb-1">Cơ hội Nghề nghiệp tại Vinamilk</h1>
        <p class="text-muted mb-0">Tìm thấy <strong>@totalItems</strong> vị trí đang mở tuyển trên toàn quốc</p>
    </div>
    <form method="get" action="/tuyen-dung" class="d-flex gap-2">
        <input type="search" name="q" value="@q" class="form-control" placeholder="Tìm vị trí hoặc đơn vị..." aria-label="Tìm kiếm việc làm" />
        <button type="submit" class="btn btn-primary fw-semibold">Tìm kiếm</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Hiện chưa có vị trí phù hợp với từ khóa tìm kiếm.</div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var job in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="bg-white p-4 rounded-4 border h-100 d-flex flex-column justify-content-between shadow-sm">
                    <div>
                        <span class="badge bg-primary-subtle text-primary mb-2">@job.UnitName</span>
                        <h2 class="h5 fw-bold mb-2">
                            <a href="/tuyen-dung/@job.Slug-@job.Id" class="text-decoration-none text-dark">@job.Title</a>
                        </h2>
                        <div class="small text-muted mb-1"><i class="ti ti-map-pin me-1"></i>@job.WorkLocation</div>
                        <div class="small text-muted mb-1"><i class="ti ti-cash me-1"></i>@job.SalaryRangeText</div>
                        <div class="small text-muted"><i class="ti ti-calendar me-1"></i>Hạn nộp: @job.ClosingDate.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="small fw-semibold text-success">Tuyển @job.Vacancies vị trí</span>
                        <a href="/tuyen-dung/@job.Slug-@job.Id" class="btn btn-sm btn-outline-primary fw-semibold">Xem chi tiết</a>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Phân trang tin tuyển dụng">
            <ul class="pagination justify-content-center">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" href="/tuyen-dung?page=@p&q=@Uri.EscapeDataString(q ?? "")">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
