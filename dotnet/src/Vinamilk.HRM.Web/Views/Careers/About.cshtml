@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<section class="p-4 p-md-5 rounded-4 text-white mb-4" style="background: linear-gradient(135deg, #0213B0, #1E3A8A);">
    <span class="badge bg-light text-primary fw-bold mb-2">VỀ CHÚNG TÔI</span>
    <h1 class="fw-extrabold mb-3">Kiến tạo giá trị dinh dưỡng — Phát triển nhân tài bền vững tại Vinamilk</h1>
    <p class="lead text-white-50 mb-4">
        Với mạng lưới nhà máy chuẩn quốc tế, trang trại công nghệ cao và đội ngũ hơn 10.000 nhân sự, Vinamilk luôn chào đón những tài năng đam mê đổi mới.
    </p>
    <a href="/tuyen-dung" class="btn btn-light text-primary fw-bold px-4">
        <i class="ti ti-briefcase me-1"></i>Xem các vị trí đang tuyển
    </a>
</section>

<section class="row g-3">
    <div class="col-md-4">
        <article class="bg-white p-4 rounded-4 border h-100">
            <h2 class="h5 fw-bold text-primary mb-2">Môi trường Chuẩn Quốc tế</h2>
            <p class="text-muted mb-0">Ứng dụng SAP SuccessFactors, chuyển đổi số toàn diện và văn hóa làm việc minh bạch, trao quyền.</p>
        </article>
    </div>
    <div class="col-md-4">
        <article class="bg-white p-4 rounded-4 border h-100">
            <h2 class="h5 fw-bold text-primary mb-2">Phúc lợi & Đãi ngộ Toàn diện</h2>
            <p class="text-muted mb-0">Lương thưởng cạnh tranh theo hiệu suất KPI, bảo hiểm sức khỏe cao cấp và chương trình chăm sóc gia đình.</p>
        </article>
    </div>
    <div class="col-md-4">
        <article class="bg-white p-4 rounded-4 border h-100">
            <h2 class="h5 fw-bold text-primary mb-2">Lộ trình Thăng tiến Rõ ràng</h2>
            <p class="text-muted mb-0">Hệ thống đào tạo nội bộ Vinamilk Academy giúp nhân sự phát triển năng lực chuyên môn và lãnh đạo.</p>
        </article>
    </div>
</section>

