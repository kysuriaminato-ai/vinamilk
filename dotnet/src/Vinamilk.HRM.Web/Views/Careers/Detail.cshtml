@model Vinamilk.HRM.Web.Controllers.PublicJobDetailVm
@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<nav aria-label="Breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="/gioi-thieu">Giới thiệu</a></li>
        <li class="breadcrumb-item"><a href="/tuyen-dung">Tuyển dụng</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<article class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4 pb-3 border-bottom">
        <div>
            <span class="badge bg-primary-subtle text-primary mb-2">@Model.PostingCode • @Model.UnitName</span>
            <h1 class="fw-extrabold mb-2">@Model.Title</h1>
            <div class="d-flex flex-wrap gap-3 text-muted small">
                <span><i class="ti ti-map-pin me-1"></i>@Model.WorkLocation</span>
                <span><i class="ti ti-cash me-1"></i>@Model.SalaryRangeText</span>
                <span><i class="ti ti-users me-1"></i>Số lượng: @Model.Vacancies</span>
                <span><i class="ti ti-calendar me-1"></i>Hạn nộp: @Model.ClosingDate.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
        <a href="/Recruitment" class="btn btn-primary fw-bold px-4">Ứng tuyển ngay</a>
    </div>

    <section class="mb-4">
        <h2 class="h5 fw-bold text-primary mb-2">1. Mô tả công việc</h2>
        <p style="white-space: pre-line;">@Model.JobDescription</p>
    </section>

    <section class="mb-4">
        <h2 class="h5 fw-bold text-primary mb-2">2. Yêu cầu ứng viên</h2>
        <p style="white-space: pre-line;">@Model.JobRequirements</p>
    </section>

    <section>
        <h2 class="h5 fw-bold text-primary mb-2">3. Quyền lợi & Phúc lợi</h2>
        <p class="mb-0" style="white-space: pre-line;">@Model.Benefits</p>
    </section>
</article>

