@model Vinamilk.HRM.Application.Payroll.PayrollOperationsOverviewDto
@{
    ViewData["Title"] = "Tạm ứng, Khoản vay, Truy lĩnh/Truy thu & Quy đổi Net → Gross";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div class="d-flex flex-wrap gap-2">
        <a href="/Payroll" class="btn btn-outline-primary"><i class="ti ti-cash me-1"></i>1. Bảng lương &amp; Kỳ tính lương</a>
        <a href="/Payroll/Parameters" class="btn btn-outline-primary"><i class="ti ti-adjustments-horizontal me-1"></i>2. Tham số Luật</a>
        <a href="/Payroll/SalaryStructures" class="btn btn-outline-primary"><i class="ti ti-calculator me-1"></i>3. Cấu trúc lương</a>
        <a href="/Payroll/Operations" class="btn vnm-btn-primary"><i class="ti ti-wallet me-1"></i>4. Tạm ứng / Vay / Truy lĩnh / Net→Gross</a>
    </div>
</div>

@if (TempData["PayrollSuccess"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-3">@TempData["PayrollSuccess"]</div>
}
@if (TempData["PayrollError"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-3">@TempData["PayrollError"]</div>
}

<div class="row g-3 mb-4">
    <!-- FORM TẠM ỨNG -->
    <div class="col-lg-4">
        <div class="vnm-card p-3 h-100">
            <h6 class="fw-bold mb-3"><i class="ti ti-cash-banknote text-primary me-1"></i>Tạo Phiếu Tạm ứng lương</h6>
            <form method="post" action="/Payroll/CreateAdvance" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12">
                    <label class="form-label small fw-semibold">Nhân viên</label>
                    <select name="employeeId" class="form-select form-select-sm" required>
                        @foreach (var e in Model.Employees)
                        {
                            <option value="@e.Id">@e.EmployeeCode - @e.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">Ngày ứng</label>
                    <input type="date" name="advanceDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" required />
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">Trừ tháng</label>
                    <input type="number" name="targetMonth" min="1" max="12" value="@DateTime.Today.Month" class="form-control form-control-sm" required />
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">Năm</label>
                    <input type="number" name="targetYear" min="2024" max="2035" value="@DateTime.Today.Year" class="form-control form-control-sm" required />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Số tiền tạm ứng (đ)</label>
                    <input type="number" name="amount" min="10000" step="10000" value="3000000" class="form-control form-control-sm" required />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Lý do</label>
                    <input type="text" name="reason" class="form-control form-control-sm" placeholder="VD: Tạm ứng lương giữa tháng..." required />
                </div>
                <div class="col-12 mt-2">
                    <button type="submit" class="btn btn-sm vnm-btn-primary w-100">Lưu Tạm ứng</button>
                </div>
            </form>
        </div>
    </div>

    <!-- FORM KHOẢN VAY -->
    <div class="col-lg-4">
        <div class="vnm-card p-3 h-100">
            <h6 class="fw-bold mb-3"><i class="ti ti-credit-card text-success me-1"></i>Tạo Khoản Vay Trả góp</h6>
            <form method="post" action="/Payroll/CreateLoan" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12">
                    <label class="form-label small fw-semibold">Nhân viên</label>
                    <select name="employeeId" class="form-select form-select-sm" required>
                        @foreach (var e in Model.Employees)
                        {
                            <option value="@e.Id">@e.EmployeeCode - @e.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold">Số tiền vay (đ)</label>
                    <input type="number" name="principalAmount" min="100000" step="100000" value="12000000" class="form-control form-control-sm" required />
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold">Số kỳ (tháng)</label>
                    <input type="number" name="termMonths" min="1" max="120" value="6" class="form-control form-control-sm" required />
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">Giải ngân</label>
                    <input type="date" name="disbursementDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" required />
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">Từ tháng</label>
                    <input type="number" name="startMonth" min="1" max="12" value="@DateTime.Today.Month" class="form-control form-control-sm" required />
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">Năm</label>
                    <input type="number" name="startYear" min="2024" max="2035" value="@DateTime.Today.Year" class="form-control form-control-sm" required />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Lý do khoản vay</label>
                    <input type="text" name="reason" class="form-control form-control-sm" placeholder="VD: Hỗ trợ mua nhà / ốm đau..." required />
                </div>
                <div class="col-12 mt-2">
                    <button type="submit" class="btn btn-sm btn-success w-100">Tạo Lịch Trả góp</button>
                </div>
            </form>
        </div>
    </div>

    <!-- FORM TRUY LĨNH / TRUY THU / HOA HỒNG / THƯỞNG -->
    <div class="col-lg-4">
        <div class="vnm-card p-3 h-100">
            <h6 class="fw-bold mb-3"><i class="ti ti-adjustments text-warning me-1"></i>Truy lĩnh / Truy thu / Thưởng &amp; Hoa hồng</h6>
            <form method="post" action="/Payroll/CreateAdjustment" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12">
                    <label class="form-label small fw-semibold">Nhân viên</label>
                    <select name="employeeId" class="form-select form-select-sm" required>
                        @foreach (var e in Model.Employees)
                        {
                            <option value="@e.Id">@e.EmployeeCode - @e.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold">Loại điều chỉnh</label>
                    <select name="adjustmentType" class="form-select form-select-sm">
                        <option value="RetroEarning">Truy lĩnh (+)</option>
                        <option value="RetroDeduction">Truy thu (-)</option>
                        <option value="Commission">Hoa hồng doanh số (+)</option>
                        <option value="Bonus13">Thưởng Tháng 13 (+)</option>
                        <option value="HolidayBonus">Thưởng Lễ/Tết (+)</option>
                    </select>
                </div>
                <div class="col-3">
                    <label class="form-label small fw-semibold">Tháng</label>
                    <input type="number" name="targetMonth" min="1" max="12" value="@DateTime.Today.Month" class="form-control form-control-sm" required />
                </div>
                <div class="col-3">
                    <label class="form-label small fw-semibold">Năm</label>
                    <input type="number" name="targetYear" min="2024" max="2035" value="@DateTime.Today.Year" class="form-control form-control-sm" required />
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold">Số tiền (đ)</label>
                    <input type="number" name="amount" min="1000" step="10000" value="1500000" class="form-control form-control-sm" required />
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold">Kỳ đã khóa nguồn (nếu truy)</label>
                    <select name="sourceLockedPeriodId" class="form-select form-select-sm">
                        <option value="">-- Không gắn --</option>
                        @foreach (var lp in Model.LockedPeriods)
                        {
                            <option value="@lp.Id">@lp.PeriodCode</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Lý do (bắt buộc)</label>
                    <input type="text" name="reason" class="form-control form-control-sm" placeholder="VD: Bổ sung 2 ngày công truy lĩnh kỳ trước..." required />
                </div>
                <div class="col-12 mt-2">
                    <button type="submit" class="btn btn-sm btn-warning text-dark fw-semibold w-100">Lưu Phiếu Điều chỉnh</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CÔNG CỤ QUY ĐỔI NHANH NET -> GROSS -->
<div class="vnm-card p-3 mb-4">
    <h5 class="fw-bold mb-3"><i class="ti ti-arrows-exchange text-primary me-2"></i>Công cụ Quy đổi Lương Net → Gross (Binary Search ≤ 1đ)</h5>
    <div id="netToGrossForm" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Lương Net mục tiêu (đ)</label>
            <input type="number" id="ntgTargetNet" value="30000000" step="500000" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">Số người phụ thuộc</label>
            <input type="number" id="ntgDeps" value="1" min="0" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">Vùng lương tối thiểu</label>
            <select id="ntgRegion" class="form-select form-select-sm">
                <option value="1">Vùng I</option>
                <option value="2">Vùng II</option>
                <option value="3">Vùng III</option>
                <option value="4">Vùng IV</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Chế độ thuế TNCN</label>
            <select id="ntgMode" class="form-select form-select-sm">
                <option value="ResidentStandard">Cư trú ≥ 3 tháng (Lũy tiến)</option>
                <option value="ResidentShortTerm">Hợp đồng &lt; 3 tháng (10%)</option>
                <option value="NonResident">Nước ngoài Non-Resident (20%)</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="button" id="btnSolveNtg" class="btn btn-sm vnm-btn-primary w-100">Quy đổi ngay</button>
        </div>
    </div>
    <div id="ntgResultBox" class="mt-3 d-none alert alert-info mb-0"></div>
</div>

<!-- DANH SÁCH TẠM ỨNG / KHOẢN VAY / ĐIỀU CHỈNH -->
<div class="row g-3">
    <div class="col-lg-4">
        <div class="vnm-card p-3">
            <h6 class="fw-bold mb-2">Danh sách Tạm ứng (@Model.Advances.Count)</h6>
            <div class="table-responsive" style="max-height: 280px; overflow-y:auto;">
                <table class="table table-sm mb-0 small">
                    <thead><tr><th>NV</th><th>Kỳ trừ</th><th class="text-end">Số tiền</th><th>Trạng thái</th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.Advances)
                        {
                            <tr>
                                <td><strong>@a.EmployeeCode</strong><div>@a.EmployeeName</div></td>
                                <td>@a.TargetMonth.ToString("D2")/@a.TargetYear</td>
                                <td class="text-end fw-semibold">@a.Amount.ToString("N0")</td>
                                <td><span class="badge @(a.Status == "Deducted" ? "bg-success" : "bg-warning text-dark")">@a.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="vnm-card p-3">
            <h6 class="fw-bold mb-2">Khoản vay &amp; Trả góp (@Model.Loans.Count)</h6>
            <div class="table-responsive" style="max-height: 280px; overflow-y:auto;">
                <table class="table table-sm mb-0 small">
                    <thead><tr><th>NV</th><th>Kỳ đã thu</th><th class="text-end">Tổng vay / Còn</th></tr></thead>
                    <tbody>
                        @foreach (var l in Model.Loans)
                        {
                            <tr>
                                <td><strong>@l.EmployeeCode</strong><div>@l.EmployeeName</div></td>
                                <td>@l.PaidInstallments / @l.TermMonths kỳ</td>
                                <td class="text-end"><div>@l.PrincipalAmount.ToString("N0")</div><span class="text-muted">Còn: @l.RemainingPrincipal.ToString("N0")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="vnm-card p-3">
            <h6 class="fw-bold mb-2">Truy lĩnh / Truy thu / Thưởng (@Model.Adjustments.Count)</h6>
            <div class="table-responsive" style="max-height: 280px; overflow-y:auto;">
                <table class="table table-sm mb-0 small">
                    <thead><tr><th>NV</th><th>Loại &amp; Kỳ</th><th class="text-end">Số tiền</th></tr></thead>
                    <tbody>
                        @foreach (var adj in Model.Adjustments)
                        {
                            <tr>
                                <td><strong>@adj.EmployeeCode</strong><div class="text-muted">@adj.Reason</div></td>
                                <td><span class="badge bg-info-subtle text-dark">@adj.AdjustmentType</span><div>@adj.TargetMonth.ToString("D2")/@adj.TargetYear</div></td>
                                <td class="text-end fw-semibold">@adj.Amount.ToString("N0")<div><small class="text-muted">@adj.Status</small></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('btnSolveNtg').addEventListener('click', async () => {
        const token = document.querySelector('#netToGrossForm input[name="__RequestVerificationToken"]').value;
        const payload = {
            targetNetSalary: Number(document.getElementById('ntgTargetNet').value || 0),
            dependentCount: Number(document.getElementById('ntgDeps').value || 0),
            wageRegion: Number(document.getElementById('ntgRegion').value || 1),
            taxResidencyMode: document.getElementById('ntgMode').value,
            isUnionMember: true
        };
        const res = await fetch('/Payroll/SolveNetToGross', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(payload)
        });
        const d = await res.json();
        const box = document.getElementById('ntgResultBox');
        box.classList.remove('d-none');
        box.innerHTML = `<strong>Kết quả quy đổi (${d.iterationsUsed} lần lặp):</strong>
            Lương Gross cần ký = <span class="text-primary fs-5 fw-bold">${Number(d.solvedContractBaseSalary).toLocaleString('vi-VN')} đ</span>
            | BH NLĐ = ${Number(d.breakdown.totalEmployeeInsurance).toLocaleString('vi-VN')} đ
            | Thuế TNCN = ${Number(d.breakdown.personalIncomeTax).toLocaleString('vi-VN')} đ
            | Net đạt được = <strong>${Number(d.achievedNetSalary).toLocaleString('vi-VN')} đ</strong> (Sai số: ${d.residualDifference} đ)`;
    });
</script>
}
