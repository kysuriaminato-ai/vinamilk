@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Khôi phục Mật khẩu qua Email";
}

<div class="vnm-card p-4 p-md-5 shadow-lg w-100" style="max-width: 540px; border-radius: var(--vnm-radius-xl);">
    <div class="mb-3">
        <a href="/Auth/Login" class="text-decoration-none fs-7 text-secondary">
            <i class="ti ti-arrow-left me-1"></i>Quay lại Đăng nhập
        </a>
    </div>

    <div class="d-flex align-items-center gap-2 mb-3">
        <div class="rounded-3 p-2 text-primary" style="background: var(--vnm-primary-soft);">
            <i class="ti ti-mail-forward fs-3"></i>
        </div>
        <div>
            <h1 class="fw-extrabold mb-0" style="font-size: var(--vnm-fs-xl);">Quên mật khẩu?</h1>
            <div class="text-secondary fs-7">Khôi phục bằng Token chữ ký số Data Protection API</div>
        </div>
    </div>

    @if (TempData["AuthSuccess"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm fs-6">
            <i class="ti ti-circle-check me-1"></i>@TempData["AuthSuccess"]
        </div>
    }

    @if (ViewBag.GeneratedResetUrl != null)
    {
        <div class="p-3 rounded-3 mb-3 border" style="background: var(--vnm-info-bg); border-color: var(--vnm-info) !important;">
            <div class="fw-bold text-primary fs-6 mb-1">
                <i class="ti ti-mail-opened me-1"></i>Mô phỏng Email gửi tới: <span class="font-monospace">@ViewBag.TargetEmail</span>
            </div>
            <p class="fs-7 text-secondary mb-2">Nhấn vào liên kết có chữ ký bảo mật dưới đây để đặt lại mật khẩu ngay (Hiệu lực 30 phút):</p>
            <a href="@ViewBag.GeneratedResetUrl" class="btn btn-sm vnm-btn-primary w-100">
                <i class="ti ti-key me-1"></i>Mở Trang Đặt lại Mật khẩu (Signed Token)
            </a>
        </div>
    }

    <form asp-controller="Auth" asp-action="ForgotPasswordSubmit" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label fw-semibold">Email công việc hoặc Username <span class="text-danger">*</span></label>
            <input type="text"
                   name="emailOrUsername"
                   class="form-control"
                   value="huyen.ntt@vinamilk.com.vn"
                   required
                   placeholder="VD: huyen.ntt@vinamilk.com.vn" />
        </div>

        <button type="submit" class="btn vnm-btn-primary w-100 py-2">
            <i class="ti ti-send me-1"></i>Gửi Liên kết Khôi phục Mật khẩu
        </button>
    </form>
</div>

