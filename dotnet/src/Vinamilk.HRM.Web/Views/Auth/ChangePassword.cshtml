@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    var firstLogin = (bool)(ViewBag.FirstLogin ?? false);
}

<div class="vnm-card p-4 p-md-5 shadow-lg w-100" style="max-width: 560px; border-radius: var(--vnm-radius-xl);">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/Auth/Login" class="text-decoration-none fs-7 text-secondary">
            <i class="ti ti-arrow-left me-1"></i>Quay lại Đăng nhập
        </a>
        @if (firstLogin)
        {
            <span class="vnm-badge vnm-badge-warning"><span class="vnm-badge-dot"></span>Bắt buộc đổi mật khẩu lần đầu</span>
        }
    </div>

    <h1 class="fw-extrabold mb-1" style="font-size: var(--vnm-fs-xl);">
        @(firstLogin ? "Đổi mật khẩu kích hoạt tài khoản lần đầu" : "Đổi mật khẩu Bảo mật")
    </h1>
    <p class="text-secondary fs-6 mb-3">
        Tuân thủ Chính sách Mật khẩu Doanh nghiệp Vinamilk (PBKDF2-SHA256).
    </p>

    @if (TempData["AuthError"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm fs-6">
            <i class="ti ti-alert-octagon me-1"></i>@TempData["AuthError"]
        </div>
    }
    @if (TempData["AuthWarning"] != null)
    {
        <div class="alert alert-warning border-0 shadow-sm fs-6">
            <i class="ti ti-alert-triangle me-1"></i>@TempData["AuthWarning"]
        </div>
    }

    <form asp-controller="Auth" asp-action="ChangePasswordSubmit" method="post">
        @Html.AntiForgeryToken()

        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="mb-3">
                <label class="form-label fw-semibold">Tài khoản (Username hoặc Email) <span class="text-danger">*</span></label>
                <input type="text" name="usernameOrEmail" class="form-control" value="tung.pt@vinamilk.com.vn" required />
            </div>
        }

        <div class="mb-3">
            <label class="form-label fw-semibold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
            <input type="password" name="currentPassword" class="form-control" value="Vinamilk@2026" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
            <input type="password" name="newPassword" class="form-control" value="Vinamilk@2026#Secure" required />
            <div class="p-2 rounded mt-2 fs-7" style="background: var(--vnm-bg-subtle);">
                <div class="fw-semibold text-secondary mb-1">Chính sách mật khẩu bắt buộc:</div>
                <div>• Tối thiểu 8 ký tự, có chữ HOA (A-Z), chữ thường (a-z), số (0-9) và ký tự đặc biệt.</div>
                <div>• Không chứa tên đăng nhập và không trùng mật khẩu hiện tại.</div>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Nhập lại mật khẩu mới <span class="text-danger">*</span></label>
            <input type="password" name="confirmPassword" class="form-control" value="Vinamilk@2026#Secure" required />
        </div>

        <button type="submit" class="btn vnm-btn-primary w-100 py-2">
            <i class="ti ti-shield-check me-1"></i>Cập nhật Mật khẩu Mới
        </button>
    </form>
</div>

