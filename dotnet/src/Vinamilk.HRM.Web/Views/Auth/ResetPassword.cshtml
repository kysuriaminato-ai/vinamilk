@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Đặt lại Mật khẩu mới";
}

<div class="vnm-card p-4 p-md-5 shadow-lg w-100" style="max-width: 540px; border-radius: var(--vnm-radius-xl);">
    <div class="d-flex align-items-center gap-2 mb-3">
        <div class="rounded-3 p-2 text-primary" style="background: var(--vnm-primary-soft);">
            <i class="ti ti-key fs-3"></i>
        </div>
        <div>
            <h1 class="fw-extrabold mb-0" style="font-size: var(--vnm-fs-xl);">Đặt lại Mật khẩu Mới</h1>
            <div class="text-secondary fs-7">Chuẩn băm PBKDF2-HMACSHA256 (100.000 vòng lặp)</div>
        </div>
    </div>

    @if (TempData["AuthError"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm fs-6">
            <i class="ti ti-alert-triangle me-1"></i>@TempData["AuthError"]
        </div>
    }

    <form asp-controller="Auth" asp-action="ResetPasswordSubmit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@ViewBag.Token" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
            <input type="password" name="newPassword" class="form-control" value="Vinamilk@2026#New" required />
            <div class="form-text fs-7">Tối thiểu 8 ký tự, gồm chữ HOA, chữ thường, chữ số và ký tự đặc biệt.</div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
            <input type="password" name="confirmPassword" class="form-control" value="Vinamilk@2026#New" required />
        </div>

        <button type="submit" class="btn vnm-btn-primary w-100 py-2">
            <i class="ti ti-device-floppy me-1"></i>Xác nhận Đặt lại Mật khẩu
        </button>
    </form>
</div>

