<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vinamilk Enterprise HRM</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Vinamilk HRM Custom Theme -->
    <style>
        :root {
            --vnm-blue: #0047BA;
            --vnm-blue-dark: #00338D;
            --vnm-blue-light: #E8F0FE;
            --vnm-green: #1E8E3E;
            --vnm-amber: #D97706;
            --vnm-red: #DC2626;
            --vnm-bg: #F8FAFC;
            --vnm-card-bg: #FFFFFF;
            --vnm-text-main: #0F172A;
            --vnm-text-muted: #64748B;
            --vnm-border: #E2E8F0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--vnm-bg);
            color: var(--vnm-text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Navbar Vinamilk */
        .vnm-navbar {
            background: linear-gradient(135deg, #0047BA 0%, #002B7A 100%);
            box-shadow: 0 4px 20px rgba(0, 71, 186, 0.15);
            padding: 0.75rem 1.5rem;
        }

        .vnm-brand {
            font-weight: 800;
            font-size: 1.25rem;
            color: #FFFFFF !important;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .vnm-brand-badge {
            background: rgba(255, 255, 255, 0.2);
            color: #FFFFFF;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 20px;
            text-transform: uppercase;
        }

        .nav-link-vnm {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-link-vnm:hover, .nav-link-vnm.active {
            color: #FFFFFF !important;
            background: rgba(255, 255, 255, 0.15);
        }

        /* Skeleton Loading Animation */
        @@keyframes skeleton-shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        .skeleton {
            background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
            background-size: 200% 100%;
            animation: skeleton-shimmer 1.5s infinite;
            border-radius: 8px;
        }

        .card-custom {
            background: var(--vnm-card-bg);
            border: 1px solid var(--vnm-border);
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card-custom:hover {
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
        }

        /* Badges */
        .badge-sla-bonus {
            background-color: #DCFCE7;
            color: #166534;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 0.75rem;
        }

        .badge-sla-penalty {
            background-color: #FEE2E2;
            color: #991B1B;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 0.75rem;
        }

        /* Footer */
        .vnm-footer {
            margin-top: auto;
            background: #FFFFFF;
            border-top: 1px solid var(--vnm-border);
            padding: 1.25rem 0;
            color: var(--vnm-text-muted);
            font-size: 0.875rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg vnm-navbar">
            <div class="container-fluid">
                <a class="vnm-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-droplet-half fs-4"></i>
                    <span>VINAMILK HRM</span>
                    <span class="vnm-brand-badge">Enterprise 2026</span>
                </a>
                <button class="navbar-toggler text-white border-0" type="button" data-bs-toggle="collapse" data-bs-target="#vnmNav">
                    <i class="bi bi-list fs-3"></i>
                </button>
                <div class="collapse navbar-collapse" id="vnmNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link-vnm" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Tổng quan
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-vnm" asp-controller="Timekeeping" asp-action="Index">
                                <i class="bi bi-clock-history"></i> Quản lý Ca kíp & Chấm công
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-vnm" asp-controller="Kpi" asp-action="Index">
                                <i class="bi bi-kanban"></i> Động cơ KPI & SLA
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-white gap-3">
                        <div class="text-end d-none d-md-block">
                            <div class="fw-bold small">Trụ sở Vinamilk Tower (Quận 7)</div>
                            <div class="text-white-50" style="font-size: 0.75rem;">Hội Đồng Quản Trị & Ban Điều Hành</div>
                        </div>
                        <div class="rounded-circle bg-white text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid py-4 px-lg-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="vnm-footer text-center">
        <div class="container">
            <strong>Công ty Cổ phần Sữa Việt Nam (Vinamilk)</strong> &copy; 2026 - Hệ thống Quản trị Nguồn nhân lực Doanh nghiệp (Enterprise HRM).
            <span class="d-none d-md-inline ms-2">| Kiến trúc: Clean Architecture (.NET 9 / SQL Server SSMS).</span>
        </div>
    </footer>

    <!-- Bootstrap & SweetAlert2 for notifications -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
