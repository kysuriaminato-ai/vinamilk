@model VinamilkHRM.Application.DTOs.Analytics.StrategicDashboardDataDto
@{
    ViewData["Title"] = "Bảng Điều Khiển Quản Trị Cấp Chiến Lược (Strategic MIS HR Dashboard)";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-2">
            <i class="bi bi-shield-check me-1"></i> STRATEGIC MIS HR INTELLIGENCE
        </span>
        <h1 class="h3 fw-bold text-dark mb-1">
            Bảng Điều Khiển Thông Tin Quản Trị Cấp Chiến Lược
        </h1>
        <p class="text-muted small mb-0">
            Dự báo tỷ lệ biến động nhân sự, phân tích cơ cấu quỹ lương, mô phỏng chính sách tiền lương và AI HR Advisor cố vấn giữ chân nhân tài.
        </p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm fw-bold shadow-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Xuất Báo Cáo HĐQT
        </button>
        <button type="button" class="btn btn-primary btn-sm fw-bold shadow-sm" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i> Làm Mới Dữ Liệu
        </button>
    </div>
</div>

<!-- Thẻ KPI Chiến Lược Vinamilk -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-custom p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-3">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem;">Tổng Quy Mô Nhân Sự</small>
                <div class="h3 fw-bold text-dark mb-0">@Model.TotalHeadcount <span class="fs-6 fw-normal text-muted">nhân sự</span></div>
                <small class="text-success fw-semibold"><i class="bi bi-arrow-up-right me-1"></i>+4.2% so với cùng kỳ</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-custom p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 fs-3">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <div>
                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem;">Tỷ Lệ Thôi Việc (Turnover)</small>
                <div class="h3 fw-bold text-danger mb-0">@Model.OverallTurnoverRate%</div>
                <small class="text-success fw-semibold"><i class="bi bi-shield-check me-1"></i>Thấp hơn chuẩn FMCG (6.8%)</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-custom p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 fs-3">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem;">Tổng Chi Phí Nhân Sự / Tháng</small>
                <div class="h3 fw-bold text-success mb-0">@((Model.TotalMonthlyLaborCost / 1000000m).ToString("N1")) <span class="fs-6 fw-normal text-muted">Tr.VNĐ</span></div>
                <small class="text-muted fw-semibold">Gồm 23.5% BHXH Doanh nghiệp</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-custom p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3 fs-3">
                <i class="bi bi-emoji-smile-fill"></i>
            </div>
            <div>
                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem;">Chỉ Số Gắn Kết (eNPS)</small>
                <div class="h3 fw-bold text-warning mb-0">+@Model.EmployeeNetPromoterScore</div>
                <small class="text-success fw-semibold"><i class="bi bi-star-fill me-1"></i>Top 1 Nơi làm việc tốt nhất</small>
            </div>
        </div>
    </div>
</div>

<!-- Khu vực Biểu đồ Chart.js -->
<div class="row g-4 mb-4">
    <!-- Biểu đồ 1: Dự báo biến động nhân sự đa khối (Turnover Forecast Timeline) -->
    <div class="col-lg-8">
        <div class="card-custom p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-graph-up text-primary me-2"></i> Dự Báo Tỷ Lệ Biến Động Nhân Sự (Turnover Forecast 6 Tháng)
                    </h5>
                    <small class="text-muted">Mô hình AI dự báo xu hướng nghỉ việc theo 4 khối chiến lược so sánh với Benchmark FMCG</small>
                </div>
                <span class="badge bg-light text-dark border px-3 py-1">Đơn vị: % / tháng</span>
            </div>
            <div style="height: 320px; position: relative;">
                <canvas id="turnoverForecastChart"></canvas>
            </div>
            <div class="row g-2 mt-3 pt-3 border-top text-center small text-muted">
                @foreach (var f in Model.TurnoverForecasts)
                {
                    <div class="col-md-3">
                        <div class="fw-bold text-dark">@f.UnitCategory</div>
                        <div>Hiện tại: <span class="fw-bold text-primary">@f.CurrentRate%</span> | T+6: <span class="fw-bold text-success">@f.ForecastM6%</span></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Biểu đồ 2: Cơ cấu Quỹ lương & Trách nhiệm Bảo hiểm của Doanh nghiệp -->
    <div class="col-lg-4">
        <div class="card-custom p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart text-success me-2"></i> Cơ Cấu Chi Phí Lao Động
                </h5>
                <span class="badge bg-success-subtle text-success">P&L Lao Động</span>
            </div>
            <div style="height: 240px; position: relative;" class="my-auto">
                <canvas id="payrollStructureChart"></canvas>
            </div>
            <div class="mt-3 pt-3 border-top small">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted"><i class="bi bi-square-fill text-primary me-1"></i> Lương Cơ Bản:</span>
                    <strong class="text-dark">@((Model.PayrollStructure.TotalBaseSalary / 1000000m).ToString("N1")) Tr.VNĐ</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted"><i class="bi bi-square-fill text-info me-1"></i> Phụ Cấp & Đãi Ngộ:</span>
                    <strong class="text-dark">@((Model.PayrollStructure.TotalAllowances / 1000000m).ToString("N1")) Tr.VNĐ</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted"><i class="bi bi-square-fill text-warning me-1"></i> Ca Đêm (+30%) & OT:</span>
                    <strong class="text-dark">@((Model.PayrollStructure.TotalNightShiftAndOvertime / 1000000m).ToString("N1")) Tr.VNĐ</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted"><i class="bi bi-square-fill text-success me-1"></i> Thưởng Hiệu Quả KPI:</span>
                    <strong class="text-dark">@((Model.PayrollStructure.TotalKpiBonuses / 1000000m).ToString("N1")) Tr.VNĐ</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted"><i class="bi bi-square-fill text-danger me-1"></i> BHXH Doanh Nghiệp (23.5%):</span>
                    <strong class="text-danger">@((Model.PayrollStructure.EmployerInsuranceCost / 1000000m).ToString("N1")) Tr.VNĐ</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Động cơ Mô phỏng Chính sách Tiền lương (Policy Simulation Engine) -->
<div class="card-custom p-4 mb-4 border-warning border-opacity-50" style="background: linear-gradient(180deg, #FFFFFF 0%, #FFFDF7 100%);">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap">
        <div>
            <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-1">
                <i class="bi bi-cpu-fill me-1"></i> SIMULATION ENGINE
            </span>
            <h4 class="fw-bold mb-0 text-dark">
                Mô Phỏng Chi Phí Tài Chính Khi Nhà Nước Điều Chỉnh Lương Tối Thiểu Vùng
            </h4>
            <small class="text-muted">Kéo thanh trượt để tính toán ngay lập tức tác động P&L đến Tổng chi phí quỹ lương và Biên EBITDA Tập đoàn.</small>
        </div>
        <div class="text-end">
            <span class="badge bg-light text-muted border px-3 py-2">Dựa trên dữ liệu nhân sự thực tế</span>
        </div>
    </div>

    <div class="row g-4 align-items-center">
        <div class="col-lg-5 border-end-lg pe-lg-4">
            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <label class="form-label fw-bold small text-dark mb-0">Tỷ lệ Tăng Lương Tối Thiểu Vùng (%):</label>
                    <span class="badge bg-primary fs-6 fw-bold" id="wagePercentDisplay">6.0%</span>
                </div>
                <input type="range" class="form-range" id="wagePercentSlider" min="0" max="15" step="0.5" value="6.0" oninput="updateSimulation()">
                <div class="d-flex justify-content-between small text-muted">
                    <span>0% (Hiện hành)</span>
                    <span>6.0% (Đề xuất)</span>
                    <span>15.0% (Kịch bản cao)</span>
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <label class="form-label fw-bold small text-dark mb-0">Tỷ lệ Tăng Trần Đóng BHXH / BHYT (%):</label>
                    <span class="badge bg-info text-dark fs-6 fw-bold" id="insPercentDisplay">7.3%</span>
                </div>
                <input type="range" class="form-range" id="insPercentSlider" min="0" max="15" step="0.5" value="7.3" oninput="updateSimulation()">
                <div class="d-flex justify-content-between small text-muted">
                    <span>0% (Không đổi)</span>
                    <span>7.3% (Mức tăng cơ sở)</span>
                    <span>15.0% (Trần tối đa)</span>
                </div>
            </div>
        </div>

        <div class="col-lg-7 ps-lg-4">
            <div class="row g-3 text-center">
                <div class="col-sm-4">
                    <div class="p-3 bg-white rounded-3 border shadow-sm">
                        <small class="text-muted d-block mb-1">Chi Phí Tăng Thêm / Tháng</small>
                        <h4 class="fw-bold text-danger mb-0" id="monthlyDeltaCost">
                            +@((Model.BaselineSimulation.MonthlyDeltaCost / 1000000m).ToString("N2")) Tr.VNĐ
                        </h4>
                        <small class="text-muted">Lương thực tế phát sinh</small>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 bg-white rounded-3 border shadow-sm">
                        <small class="text-muted d-block mb-1">Tác Động Quỹ Lương / Năm</small>
                        <h4 class="fw-bold text-danger mb-0" id="annualDeltaCost">
                            +@((Model.BaselineSimulation.TotalAnnualizedFinancialImpact / 1000000000m).ToString("N2")) Tỷ VNĐ
                        </h4>
                        <small class="text-muted">Đã gồm 23.5% Bảo hiểm</small>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 bg-white rounded-3 border shadow-sm">
                        <small class="text-muted d-block mb-1">Tác Động Biên EBITDA</small>
                        <h4 class="fw-bold text-warning mb-0" id="ebitdaImpact">
                            -@Model.BaselineSimulation.EstimatedEbitdaImpactBasisPoints bps
                        </h4>
                        <small class="text-muted">Điểm cơ bản lợi nhuận</small>
                    </div>
                </div>
            </div>

            <!-- Departmental Impact Bar -->
            <div class="mt-3 p-3 bg-light rounded-3 small">
                <div class="fw-bold text-dark mb-2"><i class="bi bi-pie-chart-fill text-primary me-1"></i> Khối chịu tác động ngân sách lớn nhất:</div>
                <div class="row g-2">
                    @foreach (var d in Model.BaselineSimulation.DepartmentalImpacts)
                    {
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between border-bottom pb-1">
                                <span class="text-muted">@d.UnitName:</span>
                                <strong class="text-danger">+@((d.AdditionalCostPerMonth / 1000000m).ToString("N1")) Tr.VNĐ/tháng (+@d.PercentageIncrease%)</strong>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cố vấn Nhân sự Thông minh AI HR Advisor -->
<div class="card-custom p-4 mb-4">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap">
        <div>
            <span class="badge bg-primary text-white fw-bold px-3 py-1 rounded-pill mb-1">
                <i class="bi bi-robot me-1"></i> AI HR ADVISOR INSIGHTS
            </span>
            <h4 class="fw-bold mb-0 text-dark">
                Khuyến Nghị Giữ Chân Nhân Tài & Tối Ưu Năng Suất Ca Kíp
            </h4>
            <small class="text-muted">Mô hình phân tích máy học tổng hợp dữ liệu chấm công, sản lượng, KPI và lộ trình kế thừa</small>
        </div>
        <span class="badge bg-success-subtle text-success px-3 py-2 fw-bold">
            <i class="bi bi-stars me-1"></i> 4 Khuyến Nghị Chiến Lược Hoạt Động
        </span>
    </div>

    <div class="row g-4">
        @foreach (var ai in Model.AiRecommendations)
        {
            var riskBadgeClass = ai.RiskLevel switch
            {
                "HIGH" => "bg-danger text-white",
                "MEDIUM" => "bg-warning text-dark",
                _ => "bg-success text-white"
            };

            var borderClass = ai.RiskLevel switch
            {
                "HIGH" => "border-danger border-opacity-25",
                "MEDIUM" => "border-warning border-opacity-25",
                _ => "border-success border-opacity-25"
            };

            <div class="col-md-6">
                <div class="card h-100 p-4 border @borderClass shadow-sm" style="border-radius: 12px; background: #FAFCFF;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge @riskBadgeClass px-3 py-1 fw-bold">RỦI RO: @ai.RiskLevel</span>
                        <small class="text-muted fw-bold"><i class="bi bi-check2-circle text-primary me-1"></i> Độ tin cậy AI: @ai.ConfidenceScorePercentage%</small>
                    </div>

                    <h5 class="fw-bold text-primary mb-1">@ai.Category</h5>
                    <div class="small text-muted fw-semibold mb-3"><i class="bi bi-bullseye me-1"></i> Áp dụng: @ai.TargetKhối</div>

                    <div class="mb-3 small">
                        <div class="fw-bold text-dark mb-1"><i class="bi bi-exclamation-circle-fill text-warning me-1"></i> Tín hiệu cảnh báo:</div>
                        <p class="text-secondary mb-0" style="line-height: 1.6;">@ai.KeyFinding</p>
                    </div>

                    <div class="p-3 bg-white rounded-3 border mb-3 small flex-grow-1">
                        <div class="fw-bold text-success mb-1"><i class="bi bi-lightbulb-fill text-warning me-1"></i> Giải pháp đề xuất của AI:</div>
                        <p class="text-dark mb-0 fw-semibold" style="line-height: 1.6;">@ai.ActionableRecommendation</p>
                    </div>

                    <div class="pt-2 border-top small text-muted d-flex align-items-center justify-content-between mt-auto">
                        <span><i class="bi bi-graph-up-arrow text-success me-1"></i> <strong>Lợi ích dự phóng:</strong></span>
                        <span class="text-success fw-bold text-end">@ai.ProjectedRoiOrBenefit</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    // 1. Khởi tạo Biểu đồ Dự Báo Biến Động Nhân Sự (Turnover Forecast Line Chart)
    const ctxTurnover = document.getElementById('turnoverForecastChart').getContext('2d');
    const turnoverChart = new Chart(ctxTurnover, {
        type: 'line',
        data: {
            labels: ['Hiện tại', 'Tháng T+1', 'Tháng T+2', 'Tháng T+3', 'Tháng T+4', 'Tháng T+5', 'Tháng T+6'],
            datasets: [
                {
                    label: 'Mega Factory (Tetra Pak)',
                    data: [4.2, 4.1, 3.9, 3.7, 3.6, 3.5, 3.4],
                    borderColor: '#D97706',
                    backgroundColor: 'rgba(217, 119, 6, 0.1)',
                    borderWidth: 2.5,
                    tension: 0.3,
                    fill: false
                },
                {
                    label: 'Chuỗi Giấc Mơ Sữa Việt',
                    data: [8.8, 8.5, 8.2, 7.9, 7.5, 7.2, 6.9],
                    borderColor: '#DC2626',
                    backgroundColor: 'rgba(220, 38, 38, 0.1)',
                    borderWidth: 2.5,
                    tension: 0.3,
                    fill: false
                },
                {
                    label: 'Trang trại Eco Farm',
                    data: [2.1, 2.0, 1.9, 1.9, 1.8, 1.8, 1.7],
                    borderColor: '#1E8E3E',
                    backgroundColor: 'rgba(30, 142, 62, 0.1)',
                    borderWidth: 2.5,
                    tension: 0.3,
                    fill: false
                },
                {
                    label: 'Hành chính Văn phòng HQ',
                    data: [3.0, 2.9, 2.8, 2.7, 2.6, 2.5, 2.4],
                    borderColor: '#0047BA',
                    backgroundColor: 'rgba(0, 71, 186, 0.1)',
                    borderWidth: 2.5,
                    tension: 0.3,
                    fill: false
                },
                {
                    label: 'Benchmark FMCG VN (Chuẩn ngành)',
                    data: [6.8, 6.8, 6.8, 6.8, 6.8, 6.8, 6.8],
                    borderColor: '#94A3B8',
                    borderDash: [6, 6],
                    borderWidth: 2,
                    pointRadius: 0,
                    fill: false
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                    labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11 } }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ': ' + context.parsed.y + '%';
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: false,
                    min: 0,
                    max: 14,
                    ticks: {
                        callback: function(value) { return value + '%'; },
                        font: { family: 'Plus Jakarta Sans', size: 10 }
                    },
                    grid: { color: '#F1F5F9' }
                },
                x: {
                    grid: { display: false },
                    ticks: { font: { family: 'Plus Jakarta Sans', size: 10 } }
                }
            }
        }
    });

    // 2. Khởi tạo Biểu đồ Cơ cấu Quỹ Lương (Donut Chart)
    const ctxStructure = document.getElementById('payrollStructureChart').getContext('2d');
    const structureChart = new Chart(ctxStructure, {
        type: 'doughnut',
        data: {
            labels: ['Lương Cơ Bản', 'Phụ Cấp', 'Ca Đêm & OT', 'Thưởng KPI', 'BHXH DN (23.5%)'],
            datasets: [{
                data: [
                    @Model.PayrollStructure.TotalBaseSalary,
                    @Model.PayrollStructure.TotalAllowances,
                    @Model.PayrollStructure.TotalNightShiftAndOvertime,
                    @Model.PayrollStructure.TotalKpiBonuses,
                    @Model.PayrollStructure.EmployerInsuranceCost
                ],
                backgroundColor: ['#0047BA', '#00A3E0', '#F5A623', '#28A745', '#DC3545'],
                borderWidth: 2,
                borderColor: '#FFFFFF'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const val = context.raw;
                            return context.label + ': ' + (val / 1000000).toFixed(1) + ' Tr.VNĐ';
                        }
                    }
                }
            },
            cutout: '68%'
        }
    });

    // 3. Xử lý Trực tiếp Kéo Thanh Trượt Mô Phỏng Chính Sách Lương
    function updateSimulation() {
        const wagePct = parseFloat(document.getElementById('wagePercentSlider').value);
        const insPct = parseFloat(document.getElementById('insPercentSlider').value);

        document.getElementById('wagePercentDisplay').innerText = wagePct.toFixed(1) + '%';
        document.getElementById('insPercentDisplay').innerText = insPct.toFixed(1) + '%';

        // Gọi API SimulatePolicy
        fetch('/StrategicDashboard/SimulatePolicy', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                minimumWageIncreasePercentage: wagePct,
                insuranceCapIncreasePercentage: insPct,
                kpiBudgetAdjustmentPercentage: 5.0
            })
        })
        .then(res => res.json())
        .then(result => {
            if (result.success && result.data) {
                const d = result.data;
                document.getElementById('monthlyDeltaCost').innerText = '+' + (d.monthlyDeltaCost / 1000000).toFixed(2) + ' Tr.VNĐ';
                document.getElementById('annualDeltaCost').innerText = '+' + (d.totalAnnualizedFinancialImpact / 1000000000).toFixed(2) + ' Tỷ VNĐ';
                document.getElementById('ebitdaImpact').innerText = '-' + d.estimatedEbitdaImpactBasisPoints.toFixed(1) + ' bps';
            }
        })
        .catch(err => console.error("Lỗi mô phỏng:", err));
    }
</script>
}
