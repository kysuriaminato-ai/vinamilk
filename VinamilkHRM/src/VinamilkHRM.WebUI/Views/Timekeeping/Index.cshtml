@using VinamilkHRM.Application.DTOs.Attendances
@using VinamilkHRM.Application.DTOs.Employees
@using VinamilkHRM.Domain.Enums
@model IReadOnlyList<AttendanceRecordDto>

@{
    ViewData["Title"] = "Quản lý Ca kíp & Chấm công Đa mô hình";
    var shifts = ViewBag.Shifts as IReadOnlyList<ShiftDto> ?? new List<ShiftDto>();
    var warnings = ViewBag.Warnings as IReadOnlyList<DisciplinaryWarningDto> ?? new List<DisciplinaryWarningDto>();
    var employees = ViewBag.Employees as IReadOnlyList<EmployeeDto> ?? new List<EmployeeDto>();
    DateTime selectedDate = ViewBag.SelectedDate ?? DateTime.Today;
}

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h3 class="fw-bold mb-1" style="color: var(--vnm-blue);">
            <i class="bi bi-clock-history me-2"></i>Quản lý Ca kíp & Chấm công Đa mô hình
        </h3>
        <p class="text-muted mb-0">Hệ thống phân bổ ca tự động cho Khối Văn phòng, Mega Factory Bình Dương và Trang trại Bò sữa Tây Ninh.</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex gap-2 justify-content-md-end">
        <button class="btn btn-outline-danger fw-semibold d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#unplannedLeaveModal">
            <i class="bi bi-exclamation-triangle-fill"></i> Báo nghỉ đột xuất
        </button>
        <button class="btn btn-primary fw-semibold d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#clockInOutModal" style="background-color: var(--vnm-blue); border-color: var(--vnm-blue);">
            <i class="bi bi-fingerprint fs-5"></i> Quẹt thẻ / Chấm công
        </button>
    </div>
</div>

<!-- Banner Cảnh báo Kỷ luật lao động nghiêm trọng (>= 5 ngày nghỉ không phép) -->
@if (warnings.Any())
{
    <div class="alert alert-danger shadow-sm border-0 rounded-3 mb-4 p-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-danger text-white p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <i class="bi bi-shield-fill-x fs-4"></i>
            </div>
            <div>
                <strong class="text-danger fs-6 d-block">
                    PHÁT HIỆN @warnings.Count() TRƯỜNG HỢP VI PHẠM KỶ LUẬT LAO ĐỘNG (NGHỈ LIÊN TỤC &gt;= 5 NGÀY)
                </strong>
                <span class="small text-danger-emphasis">
                    Căn cứ Điều 125 Bộ luật Lao động số 45/2019/QH14. Yêu cầu Lãnh đạo thẩm tra để lập hội đồng kỷ luật sa thải.
                </span>
            </div>
        </div>
        <button class="btn btn-sm btn-danger fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#warningsModal">
            Xem hồ sơ vi phạm (@warnings.Count)
        </button>
    </div>
}

<!-- Thống kê 3 Mô hình Ca làm việc chuẩn hóa Vinamilk -->
<div class="row g-3 mb-4">
    <!-- Mô hình 1: Khối Hành chính Văn phòng -->
    <div class="col-lg-4 col-md-6">
        <div class="card-custom p-3 border-start border-4 border-primary h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1">MÔ HÌNH 1</span>
                <span class="badge bg-secondary-subtle text-secondary small">8.0h công chuẩn</span>
            </div>
            <h6 class="fw-bold text-primary mb-1">Khối Hành chính Văn phòng</h6>
            <p class="text-muted small mb-2">Trụ sở chính Vinamilk Tower (Quận 7, TP.HCM)</p>
            <div class="bg-light p-2 rounded-2 small text-dark d-flex justify-content-between">
                <span><i class="bi bi-clock me-1 text-primary"></i> 08:00 - 17:30</span>
                <span class="text-muted">Nghỉ trưa: 90 phút</span>
            </div>
        </div>
    </div>

    <!-- Mô hình 2: Khối Nhà máy Sữa Mega Bình Dương -->
    <div class="col-lg-4 col-md-6">
        <div class="card-custom p-3 border-start border-4 border-warning h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-warning-subtle text-warning-emphasis fw-bold px-2 py-1">MÔ HÌNH 2</span>
                <span class="badge bg-warning text-dark fw-bold small">+30% Phụ cấp Ca 3</span>
            </div>
            <h6 class="fw-bold text-dark mb-1">Khối Nhà máy Sữa Mega Factory</h6>
            <p class="text-muted small mb-2">3 Ca xoay chuyền tiệt trùng Tetra Pak & UHT</p>
            <div class="bg-light p-2 rounded-2 small text-dark">
                <div class="d-flex justify-content-between mb-1">
                    <span><strong>Ca 1:</strong> 06h-14h</span>
                    <span><strong>Ca 2:</strong> 14h-22h</span>
                </div>
                <div class="text-danger fw-semibold">
                    <i class="bi bi-moon-stars-fill me-1"></i> Ca 3 (Đêm): 22h-06h (Hệ số lương 1.30)
                </div>
            </div>
        </div>
    </div>

    <!-- Mô hình 3: Khối Trang trại Bò sữa sinh thái Tây Ninh -->
    <div class="col-lg-4 col-md-12">
        <div class="card-custom p-3 border-start border-4 border-success h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-success-subtle text-success fw-bold px-2 py-1">MÔ HÌNH 3</span>
                <span class="badge bg-success text-white small">Ca kép chăm sóc</span>
            </div>
            <h6 class="fw-bold text-success mb-1">Khối Trang trại Bò sữa sinh thái</h6>
            <p class="text-muted small mb-2">Quy mô 8.000 con bò HF Resort Tây Ninh</p>
            <div class="bg-light p-2 rounded-2 small text-dark d-flex justify-content-between">
                <div>
                    <div><strong>Ca Sớm:</strong> 04:30 - 08:30 (Vắt sữa 1)</div>
                    <div><strong>Ca Chiều:</strong> 13:30 - 17:30 (Vắt sữa 2)</div>
                </div>
                <div class="text-end text-success fw-bold">Tổng 8.0h</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc & Bảng chấm công trực quan -->
<div class="card-custom p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-calendar2-check text-primary me-2"></i>Bảng Dữ liệu Chấm công Ngày @selectedDate.ToString("dd/MM/yyyy")
        </h5>
        <form method="get" class="d-flex gap-2">
            <input type="date" name="targetDate" class="form-control form-control-sm" value="@selectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            <button type="submit" class="btn btn-sm btn-primary px-3">Lọc</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="attendanceTable">
            <thead class="table-light">
                <tr class="text-uppercase small text-muted">
                    <th>Mã NV</th>
                    <th>Họ và tên</th>
                    <th>Đơn vị / Cơ sở</th>
                    <th>Khối nhân sự</th>
                    <th>Ca làm việc</th>
                    <th>Giờ Vào</th>
                    <th>Giờ Ra</th>
                    <th>Giờ Công</th>
                    <th>Giờ OT</th>
                    <th>Điểm chuyên cần</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@item.EmployeeCode</td>
                            <td class="fw-semibold">@item.EmployeeName</td>
                            <td class="small text-muted">@item.UnitName</td>
                            <td>
                                @switch (item.EmployeeType)
                                {
                                    case EmployeeType.Office:
                                        <span class="badge bg-primary-subtle text-primary">Văn phòng</span>
                                        break;
                                    case EmployeeType.FactoryWorker:
                                        <span class="badge bg-warning-subtle text-warning-emphasis">Nhà máy Mega</span>
                                        break;
                                    case EmployeeType.FarmSpecialist:
                                        <span class="badge bg-success-subtle text-success">Trang trại Bò</span>
                                        break;
                                    case EmployeeType.StoreAssociate:
                                        <span class="badge bg-info-subtle text-info-emphasis">Bán lẻ GMSV</span>
                                        break;
                                }
                            </td>
                            <td class="small">@item.ShiftName</td>
                            <td>@(item.CheckInTime.HasValue ? item.CheckInTime.Value.ToString(@"hh\:mm") : "--:--")</td>
                            <td>@(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString(@"hh\:mm") : "--:--")</td>
                            <td class="fw-bold">@item.WorkHours h</td>
                            <td>
                                @if (item.OvertimeHours > 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger fw-bold">+@item.OvertimeHours h OT</span>
                                }
                                else
                                {
                                    <span class="text-muted">0h</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="fw-semibold @(item.DiligenceScore < 80 ? "text-danger" : "text-success")">@item.DiligenceScore</span>
                                    <small class="text-muted">/100</small>
                                </div>
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case AttendanceStatus.Present:
                                        <span class="badge bg-success">Đúng giờ</span>
                                        break;
                                    case AttendanceStatus.Late:
                                        <span class="badge bg-warning text-dark">Đi muộn</span>
                                        break;
                                    case AttendanceStatus.EarlyDeparture:
                                        <span class="badge bg-warning text-dark">Về sớm</span>
                                        break;
                                    case AttendanceStatus.LateAndEarly:
                                        <span class="badge bg-danger">Muộn & Về sớm</span>
                                        break;
                                    case AttendanceStatus.OnLeave:
                                        <span class="badge bg-info text-dark">Nghỉ có phép</span>
                                        break;
                                    case AttendanceStatus.AbsentUnexcused:
                                        <span class="badge bg-danger">Vắng không phép</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@item.Status</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Chưa có dữ liệu chấm công cho ngày @selectedDate.ToString("dd/MM/yyyy"). Vui lòng quẹt thẻ Check-In phía trên.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ================= MODAL: CHẤM CÔNG VÀO / RA (CLOCK-IN / CLOCK-OUT) ================= -->
<div class="modal fade" id="clockInOutModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background-color: var(--vnm-blue);">
                <h5 class="modal-title fw-bold"><i class="bi bi-fingerprint me-2"></i>Mô phỏng Quẹt thẻ Vân tay / Face ID</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Chọn Cán bộ / Nhân sự Vinamilk</label>
                    <select id="clockEmpId" class="form-select">
                        @foreach (var emp in employees)
                        {
                            <option value="@emp.Id">@emp.EmployeeCode - @emp.FullName (@emp.EmployeeType)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ca làm việc</label>
                    <select id="clockShiftId" class="form-select">
                        @foreach (var s in shifts)
                        {
                            <option value="@s.Id">@s.ShiftName (@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm"))</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Ngày chấm công</label>
                        <input type="date" id="clockDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Thời điểm quét thẻ</label>
                        <input type="time" id="clockTime" class="form-control" value="@DateTime.Now.ToString("HH:mm")" />
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="button" class="btn btn-success flex-grow-1 fw-bold py-2" onclick="handleClock(true)">
                        <i class="bi bi-box-arrow-in-right me-1"></i> CHECK-IN VÀO CA
                    </button>
                    <button type="button" class="btn btn-danger flex-grow-1 fw-bold py-2" onclick="handleClock(false)">
                        <i class="bi bi-box-arrow-right me-1"></i> CHECK-OUT RA CA
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL: BÁO NGHỈ ĐỘT XUẤT (3 CHẾ ĐỘ) ================= -->
<div class="modal fade" id="unplannedLeaveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-octagon me-2"></i>Xử lý Nghỉ Đột xuất Vinamilk</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Nhân viên báo nghỉ</label>
                    <select id="leaveEmpId" class="form-select">
                        @foreach (var emp in employees)
                        {
                            <option value="@emp.Id">@emp.EmployeeCode - @emp.FullName</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Loại hình nghỉ đột xuất</label>
                    <select id="leaveType" class="form-select" onchange="toggleBhxhFields(this.value)">
                        <option value="1">1. Nghỉ có phép (Tự động trừ Quỹ phép năm)</option>
                        <option value="2">2. Nghỉ ốm đau BHXH 75% (Xuất Mẫu C70a-HD)</option>
                        <option value="5">3. Nghỉ không phép (Trừ công, trừ điểm chuyên cần, kỷ luật >= 5 ngày)</option>
                        <option value="4">4. Việc riêng có lương (Tang gia / Kết hôn)</option>
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Từ ngày</label>
                        <input type="date" id="leaveStartDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Đến ngày</label>
                        <input type="date" id="leaveEndDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tổng số ngày nghỉ</label>
                    <input type="number" step="0.5" id="leaveTotalDays" class="form-control" value="1.0" min="0.5" />
                </div>
                
                <!-- Trường giấy tờ y tế cho chế độ BHXH -->
                <div class="mb-3" id="bhxhFields" style="display:none;">
                    <label class="form-label fw-semibold text-primary">Số Giấy ra viện / Chứng từ Y tế (Mẫu C70a-HD)</label>
                    <input type="text" id="hospitalCert" class="form-control" placeholder="vd: BV-CHO-RAY-2025-09881" />
                    <small class="text-muted">Căn cứ tính 75% mức lương đóng BHXH cho người lao động.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Lý do nghỉ</label>
                    <textarea id="leaveReason" class="form-control" rows="2" placeholder="Ghi rõ lý do đột xuất..."></textarea>
                </div>

                <button type="button" class="btn btn-danger w-100 fw-bold py-2" onclick="submitLeave()">
                    XÁC NHẬN VÀ XỬ LÝ HỒ SƠ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL: DANH SÁCH VI PHẠM KỶ LUẬT >= 5 NGÀY ================= -->
<div class="modal fade" id="warningsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-shield-slash me-2"></i>Hồ sơ Vi phạm Kỷ luật Lao động (Điều 125)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-warning small mb-3">
                    Căn cứ Điều 125 Bộ luật Lao động 2019: Người lao động tự ý bỏ việc 05 ngày làm việc cộng dồn trong thời hạn 30 ngày mà không có lý do chính đáng sẽ bị áp dụng hình thức kỷ luật sa thải.
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr class="small text-muted">
                                <th>Nhân sự</th>
                                <th>Cơ sở</th>
                                <th>Số ngày tự ý nghỉ</th>
                                <th>Nội dung vi phạm</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var w in warnings)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@w.EmployeeName</div>
                                        <small class="text-muted">@w.EmployeeCode</small>
                                    </td>
                                    <td class="small">@w.UnitName</td>
                                    <td class="text-center text-danger fw-bold fs-5">@w.ConsecutiveAbsentDays ngày</td>
                                    <td class="small">@w.Details</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" onclick="resolveWarningPrompt(@w.Id)">
                                            Lập biên bản
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleBhxhFields(typeVal) {
        document.getElementById('bhxhFields').style.display = (typeVal === '2') ? 'block' : 'none';
    }

    async function handleClock(isCheckIn) {
        const empId = parseInt(document.getElementById('clockEmpId').value);
        const shiftId = parseInt(document.getElementById('clockShiftId').value);
        const date = document.getElementById('clockDate').value;
        const time = document.getElementById('clockTime').value + ':00';

        const endpoint = isCheckIn ? '/Timekeeping/ClockIn' : '/Timekeeping/ClockOut';
        const payload = isCheckIn 
            ? { employeeId: empId, shiftId: shiftId, checkInTime: time, attendanceDate: date }
            : { employeeId: empId, checkOutTime: time, attendanceDate: date };

        try {
            const resp = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: isCheckIn ? 'Check-In Thành Công' : 'Check-Out Thành Công',
                    text: data.message,
                    confirmButtonColor: '#0047BA'
                }).then(() => location.reload());
            } else {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message });
        }
    }

    async function submitLeave() {
        const empId = parseInt(document.getElementById('leaveEmpId').value);
        const leaveType = parseInt(document.getElementById('leaveType').value);
        const start = document.getElementById('leaveStartDate').value;
        const end = document.getElementById('leaveEndDate').value;
        const totalDays = parseFloat(document.getElementById('leaveTotalDays').value);
        const reason = document.getElementById('leaveReason').value;
        const cert = document.getElementById('hospitalCert').value;

        if (!reason.trim()) {
            Swal.fire({ icon: 'warning', title: 'Chú ý', text: 'Vui lòng nhập lý do nghỉ việc đột xuất!' });
            return;
        }

        const payload = {
            employeeId: empId,
            leaveType: leaveType,
            startDate: start,
            endDate: end,
            totalDays: totalDays,
            reason: reason,
            hospitalCertificateNumber: cert,
            isEmergencyNotification: (leaveType !== 5)
        };

        try {
            const resp = await fetch('/Timekeeping/SubmitUnplannedLeave', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();
            if (data.success) {
                Swal.fire({
                    icon: 'info',
                    title: 'Xử lý Nghỉ đột xuất',
                    text: data.message,
                    confirmButtonColor: '#0047BA'
                }).then(() => location.reload());
            } else {
                Swal.fire({ icon: 'error', title: 'Không thể phê duyệt', text: data.message });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message });
        }
    }

    function resolveWarningPrompt(warningId) {
        Swal.fire({
            title: 'Lập biên bản xử lý kỷ luật lao động',
            input: 'textarea',
            inputLabel: 'Kết luận hội đồng kỷ luật hoặc giải trình của nhân sự:',
            inputPlaceholder: 'Nhập kết luận hoặc hình thức xử phạt theo quy chế Vinamilk...',
            showCancelButton: true,
            confirmButtonText: 'Lưu biên bản',
            cancelButtonText: 'Hủy'
        }).then(async (result) => {
            if (result.isConfirmed && result.value) {
                const resp = await fetch(`/Timekeeping/ResolveWarning?warningId=${warningId}&notes=${encodeURIComponent(result.value)}`, { method: 'POST' });
                const data = await resp.json();
                if (data.success) {
                    Swal.fire('Thành công', data.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                }
            }
        });
    }
</script>
}
