@model IReadOnlyList<VinamilkHRM.Application.DTOs.Salaries.PaySlipDto>
@{
    ViewData["Title"] = "Quản Trị Tiền Lương & Thu Nhập Đa Hình";
    string currentPeriod = ViewBag.Period ?? DateTime.UtcNow.ToString("yyyy-MM");
    decimal totalGross = Model.Sum(p => p.GrossSalary);
    decimal totalInsurance = Model.Sum(p => p.SocialInsuranceDeduction + p.HealthInsuranceDeduction + p.UnemploymentInsuranceDeduction);
    decimal totalTax = Model.Sum(p => p.PersonalIncomeTax);
    decimal totalNet = Model.Sum(p => p.NetSalary);
    decimal totalKpi = Model.Sum(p => p.KpiBonus);
}

<!-- Alert thông báo -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
        <strong>Thành công!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1" style="color: #0047BA;">
            <i class="bi bi-wallet2 me-2"></i>Bảng Lương Đa Hình Vinamilk (Kỳ @currentPeriod)
        </h2>
        <p class="text-muted mb-0">Động cơ tính lương tự động tuân thủ Luật Lao động Việt Nam: Giảm trừ gia cảnh (11M / 4.4M), BHXH/BHYT/BHTN, Biểu thuế TNCN 7 bậc & Hệ số KPI SLA.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <!-- Form chọn kỳ lương -->
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="month" name="period" value="@currentPeriod" class="form-control form-control-sm" style="width: 160px;" />
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-funnel me-1"></i> Xem kỳ
            </button>
        </form>

        <!-- Form Kích hoạt Tính lương tự động -->
        <form method="post" asp-action="CalculatePayroll">
            <input type="hidden" name="period" value="@currentPeriod" />
            <button type="submit" class="btn btn-primary btn-sm px-3 fw-bold shadow-sm">
                <i class="bi bi-cpu me-1"></i> Tính Lương Toàn Bộ (Engine Đa Hình)
            </button>
        </form>

        <a asp-action="SalaryAdjustment" class="btn btn-outline-primary btn-sm px-3 fw-bold">
            <i class="bi bi-arrow-up-right-circle me-1"></i> Quy Trình Nâng Lương
        </a>
    </div>
</div>

<!-- 4 Thẻ KPI Tổng quan Quỹ lương -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-4 border-primary">
            <div class="small text-muted mb-1">Tổng Quỹ Lương Gross</div>
            <div class="fs-4 fw-bold text-primary">@totalGross.ToString("N0") <span class="fs-6 text-muted">đ</span></div>
            <div class="small text-muted mt-1"><i class="bi bi-people me-1"></i>@Model.Count nhân sự</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-4 border-danger">
            <div class="small text-muted mb-1">Trích BHXH + BHYT + BHTN (10.5%)</div>
            <div class="fs-4 fw-bold text-danger">@totalInsurance.ToString("N0") <span class="fs-6 text-muted">đ</span></div>
            <div class="small text-muted mt-1">Trích nộp cơ quan BHXH</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-4 border-warning">
            <div class="small text-muted mb-1">Thuế TNCN Tạm Trích (7 Bậc)</div>
            <div class="fs-4 fw-bold text-warning-emphasis">@totalTax.ToString("N0") <span class="fs-6 text-muted">đ</span></div>
            <div class="small text-muted mt-1">Khấu trừ lũy tiến từng phần</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-4 border-success">
            <div class="small text-muted mb-1">Tổng Chi Thực Lĩnh (Net Salary)</div>
            <div class="fs-4 fw-bold text-success">@totalNet.ToString("N0") <span class="fs-6 text-muted">đ</span></div>
            <div class="small text-muted mt-1"><i class="bi bi-award me-1"></i>Thưởng KPI: @totalKpi.ToString("N0") đ</div>
        </div>
    </div>
</div>

<!-- Bảng lương chi tiết -->
<div class="card card-custom">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-card-checklist me-2 text-primary"></i>Danh Sách Phiếu Lương Chi Tiết (@Model.Count CBNV)
        </h6>
        <span class="badge bg-primary-subtle text-primary">Áp dụng mẫu in Đa hình: Office / Factory / Store</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
            <thead class="table-light">
                <tr>
                    <th>Mã NV</th>
                    <th>Họ và tên</th>
                    <th>Khối nhân sự</th>
                    <th class="text-center">Công</th>
                    <th class="text-end">Lương CB</th>
                    <th class="text-end">Thưởng KPI</th>
                    <th class="text-end">Thu nhập Gross</th>
                    <th class="text-end text-danger">BH (10.5%)</th>
                    <th class="text-end text-danger">Thuế TNCN</th>
                    <th class="text-end text-success fw-bold">Thực lĩnh NET</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="12" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            Chưa có dữ liệu bảng lương kỳ <strong>@currentPeriod</strong>. Nhấp <strong>"Tính Lương Toàn Bộ"</strong> để kích hoạt động cơ tính tự động.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        decimal insTotal = p.SocialInsuranceDeduction + p.HealthInsuranceDeduction + p.UnemploymentInsuranceDeduction;
                        <tr>
                            <td class="fw-bold text-primary">@p.EmployeeCode</td>
                            <td>
                                <div class="fw-bold">@p.EmployeeName</div>
                                <div class="text-muted small">@p.UnitName</div>
                            </td>
                            <td>
                                @if (p.EmployeeType == "Office")
                                {
                                    <span class="badge bg-primary-subtle text-primary">Văn phòng</span>
                                }
                                else if (p.EmployeeType == "FactoryWorker")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis">Nhà máy (+30% đêm)</span>
                                }
                                else if (p.EmployeeType == "StoreAssociate")
                                {
                                    <span class="badge bg-success-subtle text-success">Chuỗi bán lẻ (Hoa hồng)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Trang trại</span>
                                }
                            </td>
                            <td class="text-center">@p.ActualWorkDays/@p.StandardWorkDays</td>
                            <td class="text-end">@p.BaseSalary.ToString("N0")</td>
                            <td class="text-end text-success fw-bold">@p.KpiBonus.ToString("N0")</td>
                            <td class="text-end fw-bold text-primary">@p.GrossSalary.ToString("N0")</td>
                            <td class="text-end text-danger">@insTotal.ToString("N0")</td>
                            <td class="text-end text-danger">@p.PersonalIncomeTax.ToString("N0")</td>
                            <td class="text-end text-success fw-bold fs-6">@p.NetSalary.ToString("N0") đ</td>
                            <td class="text-center">
                                @if (p.Status == VinamilkHRM.Domain.Enums.PaySlipStatus.Paid)
                                {
                                    <span class="badge bg-success">Đã chi trả</span>
                                }
                                else if (p.Status == VinamilkHRM.Domain.Enums.PaySlipStatus.Approved)
                                {
                                    <span class="badge bg-primary">Đã duyệt</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Bản thảo</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Payslip" asp-route-id="@p.Id" class="btn btn-outline-primary" title="Xem chi tiết phiếu lương">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="PrintPayslip" asp-route-id="@p.Id" target="_blank" class="btn btn-outline-secondary" title="In phiếu lương A4">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
