@model IReadOnlyList<VinamilkHRM.Application.DTOs.Salaries.ElectronicContractAppendixDto>
@{
    ViewData["Title"] = "Phụ Lục Hợp Đồng Lao Động Điện Tử";
    int ceoCount = Model.Count(a => a.IsCeoOverride);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: #0047BA;">
            <i class="bi bi-file-earmark-check-fill me-2"></i>Phụ Lục Hợp Đồng Lao Động Điện Tử
        </h2>
        <p class="text-muted mb-0">Hệ thống phụ lục hợp đồng điện tử tự động sinh sau khi nâng bậc lương hoặc CEO phê chuẩn đặc cách, tích hợp chữ ký số và mã băm SHA256.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="SalaryAdjustment" class="btn btn-outline-primary btn-sm px-3 fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Về Quy trình Nâng lương
        </a>
    </div>
</div>

<div class="card card-custom">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-shield-lock-fill text-success me-2"></i>Danh Sách Phụ Lục HĐ Điện Tử (@Model.Count phụ lục)
        </h6>
        <div>
            <span class="badge bg-warning text-dark fw-bold me-2">
                <i class="bi bi-lightning-fill"></i> @ceoCount Quyết định CEO Đặc cách
            </span>
            <span class="badge bg-success-subtle text-success fw-bold">
                <i class="bi bi-patch-check"></i> Chữ ký số hợp lệ 100%
            </span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
            <thead class="table-light">
                <tr>
                    <th>Số Phụ Lục HĐ</th>
                    <th>Nhân sự</th>
                    <th>HĐLĐ Gốc</th>
                    <th class="text-end">Lương Cũ</th>
                    <th class="text-end">Lương Mới</th>
                    <th class="text-center">Mức Tăng</th>
                    <th class="text-center">Loại Quyết Định</th>
                    <th>Chữ Ký Số SHA-256</th>
                    <th>Người Ký Số</th>
                    <th>Hiệu Lực</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-file-earmark-x fs-1 d-block mb-2"></i>
                            Chưa có phụ lục hợp đồng nào được sinh ra. Khi duyệt tăng lương hoặc CEO đặc cách, phụ lục điện tử sẽ xuất hiện tại đây.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary font-monospace">@a.AppendixNumber</td>
                            <td>
                                <div class="fw-bold">@a.EmployeeName</div>
                                <div class="text-muted small">@a.EmployeeCode</div>
                            </td>
                            <td class="small font-monospace">@a.ContractNumber</td>
                            <td class="text-end text-muted">@a.PreviousSalary.ToString("N0")</td>
                            <td class="text-end fw-bold text-success">@a.NewSalary.ToString("N0")</td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success fw-bold">+@a.SalaryIncrease.ToString("N0") đ</span>
                            </td>
                            <td class="text-center">
                                @if (a.IsCeoOverride)
                                {
                                    <span class="badge bg-warning text-dark fw-bold px-2 py-1 shadow-sm">
                                        <i class="bi bi-lightning-fill"></i> CEO Đặc Cách
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary px-2 py-1">
                                        <i class="bi bi-check-circle"></i> Thường Lệ C&B
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="font-monospace small text-truncate" style="max-width: 150px;" title="@a.DigitalSignatureHash">
                                    <i class="bi bi-fingerprint text-success me-1"></i>@(a.DigitalSignatureHash.Length > 16 ? a.DigitalSignatureHash.Substring(0, 16) + "..." : a.DigitalSignatureHash)
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold small">@a.SignerName</div>
                                <div class="text-muted" style="font-size: 11px;">@a.SignerTitle</div>
                            </td>
                            <td class="small">@a.EffectiveDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
