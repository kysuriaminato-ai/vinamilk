@using VinamilkHRM.Application.DTOs.Kpis
@using VinamilkHRM.Application.DTOs.Employees
@using VinamilkHRM.Domain.Enums
@model KpiKanbanBoardDto

@{
    ViewData["Title"] = "Động cơ Đánh giá KPI & Giao việc theo SLA";
    var employees = ViewBag.Employees as IReadOnlyList<EmployeeDto> ?? new List<EmployeeDto>();
    string selectedPeriod = ViewBag.SelectedPeriod ?? "2025-Q1";
}

<style>
    .kanban-board {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
        align-items: start;
    }

    @@media (max-width: 1200px) {
        .kanban-board {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .kanban-board {
            grid-template-columns: 1fr;
        }
    }

    .kanban-column {
        background-color: #F1F5F9;
        border-radius: 14px;
        padding: 1rem;
        min-height: 580px;
        display: flex;
        flex-direction: column;
        border: 1px solid #E2E8F0;
    }

    .kanban-col-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid;
    }

    .kanban-card {
        background: #FFFFFF;
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 0.85rem;
        border: 1px solid #E2E8F0;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        position: relative;
    }

    .kanban-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
    }

    .sla-pill-early {
        background-color: #DCFCE7;
        color: #15803D;
        font-weight: 700;
        font-size: 0.725rem;
        padding: 3px 8px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .sla-pill-late {
        background-color: #FEE2E2;
        color: #B91C1C;
        font-weight: 700;
        font-size: 0.725rem;
        padding: 3px 8px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .score-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.95rem;
    }
</style>

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h3 class="fw-bold mb-1" style="color: var(--vnm-blue);">
            <i class="bi bi-kanban-fill me-2"></i>Động cơ Đánh giá KPI & Giao việc theo SLA
        </h3>
        <p class="text-muted mb-0">Thuật toán SLA tự động: Sớm hạn (+2đ/ngày, max +10đ) | Trễ hạn (-5đ/ngày, sàn 0đ) | Lãnh đạo thẩm định và duyệt điểm.</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex gap-2 justify-content-md-end">
        <button class="btn btn-outline-primary d-flex align-items-center gap-1" onclick="simulateSkeletonLoading()">
            <i class="bi bi-arrow-repeat"></i> Làm mới dữ liệu
        </button>
        <button class="btn btn-primary fw-semibold d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createKpiModal" style="background-color: var(--vnm-blue); border-color: var(--vnm-blue);">
            <i class="bi bi-plus-circle-fill"></i> Giao chỉ tiêu mới
        </button>
    </div>
</div>

<!-- Header Thống kê Kỳ đánh giá -->
<div class="card-custom p-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div class="d-flex align-items-center gap-3">
        <div class="p-2 bg-primary-subtle text-primary rounded-3">
            <i class="bi bi-award-fill fs-3"></i>
        </div>
        <div>
            <span class="text-muted small">Kỳ đánh giá đang chọn:</span>
            <h5 class="fw-bold text-dark mb-0">@selectedPeriod (Tập đoàn Vinamilk)</h5>
        </div>
    </div>
    <div class="d-flex align-items-center gap-4">
        <div class="text-center">
            <span class="text-muted small d-block">Tổng số chỉ tiêu</span>
            <span class="fw-bold fs-5 text-primary">@Model.TotalTasksCount</span>
        </div>
        <div class="border-start ps-4 text-center">
            <span class="text-muted small d-block">Điểm trung bình đã duyệt</span>
            <span class="fw-bold fs-5 text-success">@Model.OverallAverageScore / 100</span>
        </div>
    </div>
</div>

<!-- ================= SKELETON LOADING CONTAINER (Hiển thị khi đang nạp) ================= -->
<div id="skeletonContainer" class="kanban-board mb-4" style="display: none;">
    @for (int i = 0; i < 4; i++)
    {
        <div class="kanban-column">
            <div class="skeleton mb-3" style="height: 32px; width: 60%;"></div>
            <div class="skeleton mb-3" style="height: 140px; width: 100%;"></div>
            <div class="skeleton mb-3" style="height: 140px; width: 100%;"></div>
        </div>
    }
</div>

<!-- ================= KANBAN BOARD CONTAINER CHÍNH ================= -->
<div id="kanbanBoardMain" class="kanban-board">

    <!-- CỘT 1: ĐÃ GIAO CHỈ TIÊU (ASSIGNED) -->
    <div class="kanban-column">
        <div class="kanban-col-header border-secondary">
            <div>
                <strong class="text-secondary"><i class="bi bi-pin-angle-fill me-1"></i>1. ĐÃ GIAO CHỈ TIÊU</strong>
            </div>
            <span class="badge bg-secondary rounded-pill">@Model.AssignedTasks.Count</span>
        </div>
        <div class="kanban-cards-wrapper">
            @foreach (var task in Model.AssignedTasks)
            {
                <div class="kanban-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-light text-muted border small">@task.WeightPercentage% Tỷ trọng</span>
                        <span class="small text-danger fw-semibold"><i class="bi bi-calendar-event me-1"></i>Hạn: @task.DueDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <h6 class="fw-bold mb-1 text-dark">@task.Title</h6>
                    <p class="text-muted small mb-2 text-truncate" title="@task.Description">@task.Description</p>
                    <div class="bg-light p-2 rounded-2 small mb-3">
                        <div class="text-muted">Nhân sự thực hiện:</div>
                        <div class="fw-semibold text-primary">@task.EmployeeName (@task.EmployeeCode)</div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary w-100 fw-semibold" onclick="startKpiTask(@task.Id)">
                        <i class="bi bi-play-circle me-1"></i> Tiếp nhận & Triển khai
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- CỘT 2: ĐANG THỰC HIỆN (IN PROGRESS) -->
    <div class="kanban-column">
        <div class="kanban-col-header border-primary">
            <div>
                <strong class="text-primary"><i class="bi bi-lightning-charge-fill me-1"></i>2. ĐANG THỰC HIỆN</strong>
            </div>
            <span class="badge bg-primary rounded-pill">@Model.InProgressTasks.Count</span>
        </div>
        <div class="kanban-cards-wrapper">
            @foreach (var task in Model.InProgressTasks)
            {
                <div class="kanban-card border-primary border-top border-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary-subtle text-primary small">Điểm chuẩn: @task.BaseScore</span>
                        <span class="small text-danger fw-semibold"><i class="bi bi-alarm me-1"></i>@task.DueDate.ToString("dd/MM")</span>
                    </div>
                    <h6 class="fw-bold mb-1 text-dark">@task.Title</h6>
                    <div class="small text-muted mb-2"><strong>Mục tiêu:</strong> @task.TargetMetric</div>
                    <div class="bg-light p-2 rounded-2 small mb-3">
                        <div class="fw-semibold text-primary">@task.EmployeeName</div>
                        <div class="text-muted" style="font-size: 0.75rem;">@task.UnitName</div>
                    </div>
                    <button class="btn btn-sm btn-primary w-100 fw-semibold" onclick="openSubmitModal(@task.Id, '@task.Title', '@task.DueDate.ToString("yyyy-MM-dd")')">
                        <i class="bi bi-send-check me-1"></i> Nộp kết quả (Tính SLA)
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- CỘT 3: CHỜ LÃNH ĐẠO DUYỆT (PENDING APPROVAL) -->
    <div class="kanban-column">
        <div class="kanban-col-header border-warning">
            <div>
                <strong class="text-warning-emphasis"><i class="bi bi-hourglass-split me-1"></i>3. CHỜ LÃNH ĐẠO DUYỆT</strong>
            </div>
            <span class="badge bg-warning text-dark rounded-pill">@Model.PendingApprovalTasks.Count</span>
        </div>
        <div class="kanban-cards-wrapper">
            @foreach (var task in Model.PendingApprovalTasks)
            {
                <div class="kanban-card border-warning border-top border-3">
                    <!-- Badge SLA tự động -->
                    <div class="mb-2">
                        @if (task.SlaBonusPenaltyScore > 0)
                        {
                            <span class="sla-pill-early">
                                <i class="bi bi-arrow-up-circle-fill"></i> SLA THƯỞNG +@task.SlaBonusPenaltyScore ĐIỂM
                            </span>
                        }
                        else if (task.SlaBonusPenaltyScore < 0)
                        {
                            <span class="sla-pill-late">
                                <i class="bi bi-arrow-down-circle-fill"></i> SLA PHẠT @task.SlaBonusPenaltyScore ĐIỂM
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary small">SLA: ĐÚNG HẠN 0Đ</span>
                        }
                    </div>

                    <h6 class="fw-bold mb-1 text-dark">@task.Title</h6>
                    <div class="p-2 bg-light rounded-2 small mb-2">
                        <div class="text-muted" style="font-size: 0.75rem;">Báo cáo kết quả:</div>
                        <div class="fst-italic text-dark text-truncate">@task.ActualResult</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="small text-muted">Điểm tạm tính:</span>
                        <span class="fw-bold fs-6 text-primary">@task.SelfEvaluationScore / 100</span>
                    </div>

                    <button class="btn btn-sm btn-success w-100 fw-bold" onclick="openLeaderApproveModal(@task.Id, '@task.Title', '@task.EmployeeName', @task.BaseScore, @task.SlaBonusPenaltyScore, @(task.SelfEvaluationScore ?? 100))">
                        <i class="bi bi-check2-circle me-1"></i> THẨM ĐỊNH & PHÊ DUYỆT
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- CỘT 4: ĐÃ PHÊ DUYỆT CHÍNH THỨC (APPROVED) -->
    <div class="kanban-column">
        <div class="kanban-col-header border-success">
            <div>
                <strong class="text-success"><i class="bi bi-check-all me-1"></i>4. ĐÃ DUYỆT (TÍNH LƯƠNG)</strong>
            </div>
            <span class="badge bg-success rounded-pill">@Model.ApprovedTasks.Count</span>
        </div>
        <div class="kanban-cards-wrapper">
            @foreach (var task in Model.ApprovedTasks)
            {
                <div class="kanban-card border-success border-top border-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-success-subtle text-success small">Đã chốt lương</span>
                        <div class="score-circle bg-success text-white">
                            @task.FinalScore
                        </div>
                    </div>
                    <h6 class="fw-bold mb-1 text-dark">@task.Title</h6>
                    <div class="small text-muted mb-2">@task.EmployeeName (@task.UnitName)</div>
                    <div class="bg-light p-2 rounded-2 small text-muted" style="font-size: 0.75rem;">
                        <div><i class="bi bi-chat-left-quote me-1"></i><strong>Nhận xét Lãnh đạo:</strong> @task.Feedback</div>
                        <div><i class="bi bi-calendar-check me-1"></i>Ngày duyệt: @(task.EvaluationDate.HasValue ? task.EvaluationDate.Value.ToString("dd/MM/yyyy") : "N/A")</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ================= MODAL: GIAO CHỈ TIÊU KPI MỚI ================= -->
<div class="modal fade" id="createKpiModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background-color: var(--vnm-blue);">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Giao Chỉ tiêu KPI theo SLA</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Nhân sự nhận chỉ tiêu</label>
                    <select id="kpiEmpId" class="form-select">
                        @foreach (var emp in employees)
                        {
                            <option value="@emp.Id">@emp.EmployeeCode - @emp.FullName (@emp.UnitName)</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Kỳ đánh giá</label>
                        <input type="text" id="kpiPeriod" class="form-control" value="@selectedPeriod" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Tỷ trọng (%)</label>
                        <input type="number" id="kpiWeight" class="form-control" value="25.0" min="5" max="100" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tiêu đề chỉ tiêu KPI</label>
                    <input type="text" id="kpiTitle" class="form-control" placeholder="vd: Đảm bảo tỷ lệ kiểm định vi sinh sữa chuẩn 100%" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mục tiêu đo lường (Target Metric)</label>
                    <input type="text" id="kpiMetric" class="form-control" placeholder="vd: Tỷ lệ đạt >= 99.8%, thời gian phản hồi < 2h" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold text-danger">Hạn định SLA (DueDate)</label>
                        <input type="date" id="kpiDueDate" class="form-control border-danger" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Điểm chuẩn (BaseScore)</label>
                        <input type="number" id="kpiBaseScore" class="form-control bg-light" value="100" readonly />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mô tả công việc chi tiết</label>
                    <textarea id="kpiDesc" class="form-control" rows="2" placeholder="Ghi rõ tiêu chuẩn hoàn thành..."></textarea>
                </div>
                <button type="button" class="btn btn-primary w-100 fw-bold py-2" onclick="submitCreateKpi()" style="background-color: var(--vnm-blue);">
                    LƯU VÀ GIAO CHỈ TIÊU CHO NHÂN SỰ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL: NỘP BÁO CÁO KẾT QUẢ & TÍNH SLA ================= -->
<div class="modal fade" id="submitResultModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-send-check me-2"></i>Nộp Báo Cáo Hoàn Thành KPI</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="submitKpiId" />
                <h6 id="submitTaskTitle" class="fw-bold text-primary mb-3"></h6>
                <div class="alert alert-info small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Quy tắc SLA tự động Vinamilk:</strong><br />
                    • Hoàn thành sớm hơn hạn định: <strong>+2 điểm/ngày</strong> (Tối đa +10 điểm).<br />
                    • Hoàn thành trễ hơn hạn định: <strong>-5 điểm/ngày</strong> (Sàn = 0 điểm).
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ngày thực tế hoàn thành</label>
                    <input type="date" id="submitCompletedDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Báo cáo kết quả và số liệu minh chứng</label>
                    <textarea id="submitSummary" class="form-control" rows="3" placeholder="Nhập tóm tắt số liệu đạt được..."></textarea>
                </div>
                <button type="button" class="btn btn-primary w-100 fw-bold py-2" onclick="submitTaskResult()">
                    NỘP BÁO CÁO & TÍNH ĐIỂM SLA
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL: PHÊ DUYỆT LÃNH ĐẠO (LEADER APPROVAL) ================= -->
<div class="modal fade" id="leaderApproveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-award me-2"></i>Lãnh Đạo Thẩm Định & Phê Duyệt KPI</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="approveKpiId" />
                <input type="hidden" id="approveBaseScore" />
                <input type="hidden" id="approveSlaScore" />

                <h6 id="approveTaskTitle" class="fw-bold text-dark mb-1"></h6>
                <div class="small text-muted mb-3">Nhân sự: <strong id="approveEmpName" class="text-primary"></strong></div>

                <div class="card p-3 bg-light mb-3 border-0">
                    <div class="d-flex justify-content-between mb-1 small">
                        <span>Điểm cơ bản (BaseScore):</span>
                        <strong id="dispBaseScore">100đ</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span>Điểm thưởng/phạt SLA tự động:</span>
                        <strong id="dispSlaScore">+0đ</strong>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2">
                        <span class="fw-bold">Điểm tạm tính:</span>
                        <strong class="text-primary fs-6" id="dispPreScore">100đ</strong>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold d-flex justify-content-between">
                        <span>Lãnh đạo điều chỉnh điểm (ScoreAdjustment):</span>
                        <strong class="text-success" id="dispAdjustment">+0đ</strong>
                    </label>
                    <input type="range" class="form-range" id="scoreAdjustmentRange" min="-20" max="20" step="1" value="0" oninput="updateCalculatedFinalScore(this.value)">
                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem;">
                        <span>-20đ (Kém)</span>
                        <span>0đ (Giữ nguyên)</span>
                        <span>+20đ (Xuất sắc)</span>
                    </div>
                </div>

                <div class="p-3 bg-success-subtle border border-success rounded-3 text-center mb-3">
                    <div class="small text-success-emphasis fw-bold">ĐIỂM KPI CHÍNH THỨC (FINAL SCORE) SẼ CHỐT SANG BẢNG LƯƠNG:</div>
                    <div class="fs-2 fw-extrabold text-success" id="dispFinalScore">100 / 100</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Ý kiến nhận xét / Đánh giá của Lãnh đạo</label>
                    <textarea id="leaderFeedback" class="form-control" rows="2" placeholder="Ghi nhận xét và lý do điều chỉnh điểm..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-danger flex-grow-1" onclick="rejectKpiPrompt()">
                        Trả về làm lại
                    </button>
                    <button type="button" class="btn btn-success flex-grow-2 fw-bold" onclick="submitLeaderApprove()">
                        XÁC NHẬN PHÊ DUYỆT ĐIỂM
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function simulateSkeletonLoading() {
        document.getElementById('kanbanBoardMain').style.display = 'none';
        document.getElementById('skeletonContainer').style.display = 'grid';

        setTimeout(() => {
            document.getElementById('skeletonContainer').style.display = 'none';
            document.getElementById('kanbanBoardMain').style.display = 'grid';
        }, 600);
    }

    async function submitCreateKpi() {
        const empId = parseInt(document.getElementById('kpiEmpId').value);
        const period = document.getElementById('kpiPeriod').value;
        const weight = parseFloat(document.getElementById('kpiWeight').value);
        const title = document.getElementById('kpiTitle').value;
        const metric = document.getElementById('kpiMetric').value;
        const dueDate = document.getElementById('kpiDueDate').value;
        const desc = document.getElementById('kpiDesc').value;

        if (!title.trim()) {
            Swal.fire({ icon: 'warning', title: 'Thiếu thông tin', text: 'Vui lòng nhập tiêu đề chỉ tiêu KPI!' });
            return;
        }

        const payload = {
            employeeId: empId,
            evaluatorId: 1, // Giám đốc Nhân sự
            period: period,
            title: title,
            description: desc,
            targetMetric: metric,
            weightPercentage: weight,
            dueDate: dueDate,
            baseScore: 100
        };

        try {
            const resp = await fetch('/Kpi/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();
            if (data.success) {
                Swal.fire('Thành công', data.message, 'success').then(() => location.reload());
            } else {
                Swal.fire('Lỗi', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Lỗi', err.message, 'error');
        }
    }

    async function startKpiTask(id) {
        try {
            const resp = await fetch(`/Kpi/Start?id=${id}`, { method: 'POST' });
            const data = await resp.json();
            if (data.success) {
                Swal.fire({ icon: 'info', title: 'Triển khai công việc', text: data.message, timer: 1500 }).then(() => location.reload());
            } else {
                Swal.fire('Lỗi', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Lỗi', err.message, 'error');
        }
    }

    function openSubmitModal(id, title, dueDate) {
        document.getElementById('submitKpiId').value = id;
        document.getElementById('submitTaskTitle').innerText = title;
        const modal = new bootstrap.Modal(document.getElementById('submitResultModal'));
        modal.show();
    }

    async function submitTaskResult() {
        const id = parseInt(document.getElementById('submitKpiId').value);
        const date = document.getElementById('submitCompletedDate').value;
        const summary = document.getElementById('submitSummary').value;

        if (!summary.trim()) {
            Swal.fire({ icon: 'warning', title: 'Thiếu nội dung', text: 'Vui lòng tóm tắt kết quả thực hiện!' });
            return;
        }

        const payload = {
            kpiId: id,
            completedDate: date,
            resultSummary: summary
        };

        try {
            const resp = await fetch('/Kpi/SubmitResult', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Đã nộp báo cáo hoàn thành',
                    html: `<b>Kết quả SLA:</b> ${data.message}`,
                    confirmButtonColor: '#0047BA'
                }).then(() => location.reload());
            } else {
                Swal.fire('Lỗi', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Lỗi', err.message, 'error');
        }
    }

    function openLeaderApproveModal(id, title, empName, baseScore, slaScore, preScore) {
        document.getElementById('approveKpiId').value = id;
        document.getElementById('approveBaseScore').value = baseScore;
        document.getElementById('approveSlaScore').value = slaScore;

        document.getElementById('approveTaskTitle').innerText = title;
        document.getElementById('approveEmpName').innerText = empName;
        document.getElementById('dispBaseScore').innerText = `${baseScore}đ`;
        document.getElementById('dispSlaScore').innerText = (slaScore >= 0 ? `+${slaScore}đ` : `${slaScore}đ`);
        document.getElementById('dispPreScore').innerText = `${preScore}đ`;

        document.getElementById('scoreAdjustmentRange').value = 0;
        updateCalculatedFinalScore(0);

        const modal = new bootstrap.Modal(document.getElementById('leaderApproveModal'));
        modal.show();
    }

    function updateCalculatedFinalScore(adjVal) {
        const base = parseFloat(document.getElementById('approveBaseScore').value) || 100;
        const sla = parseFloat(document.getElementById('approveSlaScore').value) || 0;
        const adj = parseFloat(adjVal) || 0;

        document.getElementById('dispAdjustment').innerText = (adj >= 0 ? `+${adj}đ` : `${adj}đ`);

        let finalScore = base + sla + adj;
        if (finalScore < 0) finalScore = 0;
        if (finalScore > 120) finalScore = 120;

        document.getElementById('dispFinalScore').innerText = `${finalScore.toFixed(0)} / 100`;
    }

    async function submitLeaderApprove() {
        const id = parseInt(document.getElementById('approveKpiId').value);
        const adj = parseFloat(document.getElementById('scoreAdjustmentRange').value);
        const feedback = document.getElementById('leaderFeedback').value;

        const payload = {
            kpiId: id,
            leaderId: 1,
            scoreAdjustment: adj,
            feedback: feedback
        };

        try {
            const resp = await fetch('/Kpi/LeaderApprove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Phê duyệt thành công',
                    text: data.message,
                    confirmButtonColor: '#1E8E3E'
                }).then(() => location.reload());
            } else {
                Swal.fire('Lỗi', data.message, 'error');
            }
        } catch (err) {
            Swal.fire('Lỗi', err.message, 'error');
        }
    }

    function rejectKpiPrompt() {
        const id = parseInt(document.getElementById('approveKpiId').value);
        Swal.fire({
            title: 'Trả về yêu cầu bổ sung',
            input: 'textarea',
            inputLabel: 'Lý do từ chối hoặc nội dung cần chỉnh sửa:',
            showCancelButton: true,
            confirmButtonText: 'Xác nhận trả về',
            confirmButtonColor: '#DC2626'
        }).then(async (result) => {
            if (result.isConfirmed && result.value) {
                const resp = await fetch(`/Kpi/Reject?id=${id}&leaderId=1&reason=${encodeURIComponent(result.value)}`, { method: 'POST' });
                const data = await resp.json();
                if (data.success) {
                    Swal.fire('Đã trả về', data.message, 'info').then(() => location.reload());
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                }
            }
        });
    }
</script>
}
