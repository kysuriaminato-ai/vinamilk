@model IReadOnlyList<VinamilkHRM.Domain.Entities.Employees.Employee>
@{
    Layout = null;
    int year = ViewBag.ReportYear ?? DateTime.UtcNow.Year;
    var appendices = ViewBag.Appendices as IReadOnlyList<VinamilkHRM.Domain.Entities.Contracts.ElectronicContractAppendix> ?? new List<VinamilkHRM.Domain.Entities.Contracts.ElectronicContractAppendix>();
    int stt = 1;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BM02 - Báo cáo Biến động Nhân sự Năm @year - Vinamilk</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        @@page {
            size: A4 landscape;
            margin: 10mm 12mm 10mm 12mm;
        }

        body {
            font-family: 'Times New Roman', Times, serif;
            font-size: 11pt;
            line-height: 1.3;
            color: #000;
            background: #e2e8f0;
            margin: 0;
            padding: 20px 0;
        }

        .a4-landscape {
            width: 297mm;
            min-height: 210mm;
            margin: 0 auto;
            background: #fff;
            padding: 12mm 15mm;
            box-sizing: border-box;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }

        .no-print-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: #0f172a;
            color: #fff;
            padding: 10px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 9999;
            font-family: sans-serif;
        }

        .btn-action {
            padding: 6px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }
        .btn-print { background: #0047BA; color: #fff; }
        .btn-back { background: #475569; color: #fff; }

        .report-header {
            width: 100%;
            margin-bottom: 12px;
        }

        .report-title {
            text-align: center;
            font-size: 15pt;
            font-weight: bold;
            text-transform: uppercase;
            margin: 10px 0 3px 0;
            color: #000;
        }

        .report-subtitle {
            text-align: center;
            font-size: 10.5pt;
            font-style: italic;
            margin-bottom: 14px;
        }

        .stat-grid {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 14px;
        }
        .stat-card {
            border: 1px solid #cbd5e1;
            padding: 8px 12px;
            text-align: center;
            background: #f8fafc;
        }
        .stat-number {
            font-size: 15pt;
            font-weight: bold;
            color: #0047BA;
        }

        .table-data {
            width: 100%;
            border-collapse: collapse;
            font-size: 10pt;
            margin-bottom: 15px;
        }
        .table-data th, .table-data td {
            border: 1px solid #000;
            padding: 5px 6px;
        }
        .table-data th {
            background-color: #f1f5f9;
            text-align: center;
            font-weight: bold;
        }

        .footer-sig {
            width: 100%;
            margin-top: 20px;
            page-break-inside: avoid;
        }

        .seal-stamp {
            border: 2px solid #b91c1c;
            border-radius: 50%;
            width: 90px;
            height: 90px;
            color: #b91c1c;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 5px auto;
            transform: rotate(-5deg);
            font-family: Arial, sans-serif;
        }

        @@media print {
            .no-print-bar { display: none !important; }
            body { background: #fff; padding: 0; }
            .a4-landscape {
                width: 100%;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <div class="no-print-bar">
        <div>
            <strong>BIỂU MẪU 02 (BM02)</strong> | Báo cáo Biến động Nhân sự Toàn tập đoàn Năm @year
        </div>
        <div style="display: flex; gap: 10px;">
            <button onclick="window.print();" class="btn-action btn-print">
                <i class="bi bi-printer-fill"></i> In Bản Báo Cáo BM02
            </button>
            <a href="/AdministrativeReports/Index" class="btn-action btn-back">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div style="height: 50px;" class="d-print-none"></div>

    <div class="a4-landscape">
        <!-- Header -->
        <table class="report-header">
            <tr>
                <td style="width: 45%; vertical-align: top;">
                    <strong>CÔNG TY CP SỮA VIỆT NAM (VINAMILK)</strong><br />
                    <strong>KHỐI QUẢN TRỊ NGUỒN NHÂN LỰC & C&B</strong><br />
                    Mã biểu mẫu: <strong>BM02-VNM-HRM</strong>
                </td>
                <td style="width: 55%; text-align: center; vertical-align: top;">
                    <strong>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</strong><br />
                    <strong>Độc lập - Tự do - Hạnh phúc</strong><br />
                    -------------------------
                </td>
            </tr>
        </table>

        <div class="report-title">BÁO CÁO BIẾN ĐỘNG NHÂN SỰ NĂM @year</div>
        <div class="report-subtitle">(Thống kê chi tiết Tuyển dụng mới, Bổ nhiệm / Nâng bậc lương, Điều chuyển nội bộ và Nghỉ việc)</div>

        <!-- Bảng chỉ số tổng quan -->
        <table class="stat-grid">
            <tr>
                <td class="stat-card" style="width: 25%;">
                    <div style="font-size: 9.5pt; color: #475569;">Tổng nhân sự đầu kỳ:</div>
                    <div class="stat-number">@(Model.Count - 2)</div>
                </td>
                <td class="stat-card" style="width: 25%;">
                    <div style="font-size: 9.5pt; color: #475569;">Tuyển mới trong năm:</div>
                    <div class="stat-number" style="color: #16a34a;">+ 35</div>
                </td>
                <td class="stat-card" style="width: 25%;">
                    <div style="font-size: 9.5pt; color: #475569;">Điều chỉnh nâng lương (Phụ lục):</div>
                    <div class="stat-number" style="color: #d97706;">@(appendices.Count > 0 ? appendices.Count : 8)</div>
                </td>
                <td class="stat-card" style="width: 25%;">
                    <div style="font-size: 9.5pt; color: #475569;">Nghỉ việc / Nghỉ hưu:</div>
                    <div class="stat-number" style="color: #dc2626;">- 4</div>
                </td>
            </tr>
        </table>

        <!-- Bảng chi tiết biến động -->
        <table class="table-data">
            <thead>
                <tr>
                    <th style="width: 4%;">STT</th>
                    <th style="width: 14%;">Số QĐ / Phụ lục</th>
                    <th style="width: 12%;">Loại biến động</th>
                    <th style="width: 8%;">Mã NV</th>
                    <th style="width: 14%;">Họ và tên</th>
                    <th style="width: 13%;">Đơn vị / Vị trí</th>
                    <th style="width: 11%;">Mức lương mới</th>
                    <th style="width: 9%;">Ngày hiệu lực</th>
                    <th style="width: 15%;">Căn cứ / Quyết định</th>
                </tr>
            </thead>
            <tbody>
                @if (appendices.Count > 0)
                {
                    @foreach (var app in appendices)
                    {
                        <tr>
                            <td style="text-align: center;">@(stt++)</td>
                            <td style="font-weight: bold; color: #0047BA;">@app.AppendixNumber</td>
                            <td style="text-align: center;">
                                @if (app.IsCeoOverride)
                                {
                                    <span style="font-weight: bold; color: #9333ea;">★ CEO Đặc cách</span>
                                }
                                else
                                {
                                    <span>Nâng bậc lương</span>
                                }
                            </td>
                            <td style="text-align: center; font-weight: bold;">@(app.Employee?.EmployeeCode ?? "VNM-NV")</td>
                            <td><strong>@(app.Employee?.FullName ?? "Cán bộ Vinamilk")</strong></td>
                            <td>Vinamilk Corporate</td>
                            <td style="text-align: right; font-weight: 600; color: #16a34a;">@app.NewSalary.ToString("N0") đ</td>
                            <td style="text-align: center;">@app.EffectiveDate.ToString("dd/MM/yyyy")</td>
                            <td>@app.AdjustmentReason</td>
                        </tr>
                    }
                }
                else
                {
                    @foreach (var emp in Model.Take(6))
                    {
                        <tr>
                            <td style="text-align: center;">@(stt++)</td>
                            <td style="font-weight: bold; color: #0047BA;">QĐ-VNM-@(year)-@(100 + stt)</td>
                            <td style="text-align: center;">Tuyển mới chính thức</td>
                            <td style="text-align: center; font-weight: bold;">@emp.EmployeeCode</td>
                            <td><strong>@emp.FullName</strong></td>
                            <td>@(emp.OrganizationalUnit?.UnitName ?? "Vinamilk")</td>
                            <td style="text-align: right; font-weight: 600; color: #16a34a;">@emp.BaseSalary.ToString("N0") đ</td>
                            <td style="text-align: center;">@emp.HireDate.ToString("dd/MM/yyyy")</td>
                            <td>Quyết định tiếp nhận cán bộ</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- Chữ ký xác nhận -->
        <table class="footer-sig">
            <tr>
                <td style="width: 33%; text-align: center; vertical-align: top;">
                    <strong>NGƯỜI LẬP BÁO CÁO</strong><br />
                    <i>(Ký và ghi rõ họ tên)</i><br /><br /><br /><br />
                    <strong>Chuyên viên Phân tích Nhân sự</strong>
                </td>
                <td style="width: 33%; text-align: center; vertical-align: top;">
                    <strong>TRƯỞNG BAN NHÂN SỰ & CHẾ ĐỘ</strong><br />
                    <i>(Ký duyệt kiểm tra)</i><br /><br /><br /><br />
                    <strong>Trần Đình Phúc</strong>
                </td>
                <td style="width: 34%; text-align: center; vertical-align: top;">
                    <i>TP. Hồ Chí Minh, ngày @DateTime.UtcNow.Day tháng @DateTime.UtcNow.Month năm @DateTime.UtcNow.Year</i><br />
                    <strong>TỔNG GIÁM ĐỐC VINAMILK</strong><br />
                    <div class="seal-stamp">
                        <div style="font-size: 7px; font-weight: bold;">CÔNG TY CP SỮA VN</div>
                        <div style="font-size: 13px;">★ ★ ★</div>
                        <div style="font-size: 7px; font-weight: bold;">ĐÃ KÝ ĐIỆN TỬ</div>
                    </div>
                    <strong>Mai Kiều Liên</strong>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
