@model IReadOnlyList<VinamilkHRM.Domain.Entities.Employees.Employee>
@{
    Layout = null;
    int stt = 1;
    decimal totalSalary = Model.Sum(e => e.BaseSalary);
    decimal totalAllowance = Model.Sum(e => e.Allowance);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BM01 - Báo cáo Trích ngang Nhân sự - Vinamilk</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        @@page {
            size: A4 landscape;
            margin: 10mm 12mm 10mm 12mm;
        }

        body {
            font-family: 'Times New Roman', Times, serif;
            font-size: 11pt;
            line-height: 1.3;
            color: #000;
            background: #e2e8f0;
            margin: 0;
            padding: 20px 0;
        }

        .a4-landscape {
            width: 297mm;
            min-height: 210mm;
            margin: 0 auto;
            background: #fff;
            padding: 12mm 15mm;
            box-sizing: border-box;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }

        .no-print-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: #0f172a;
            color: #fff;
            padding: 10px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 9999;
            font-family: sans-serif;
        }

        .btn-action {
            padding: 6px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }
        .btn-print { background: #0047BA; color: #fff; }
        .btn-back { background: #475569; color: #fff; }

        .report-header {
            width: 100%;
            margin-bottom: 12px;
        }

        .report-title {
            text-align: center;
            font-size: 15pt;
            font-weight: bold;
            text-transform: uppercase;
            margin: 10px 0 3px 0;
            color: #000;
        }

        .report-subtitle {
            text-align: center;
            font-size: 10.5pt;
            font-style: italic;
            margin-bottom: 14px;
        }

        .table-data {
            width: 100%;
            border-collapse: collapse;
            font-size: 10pt;
            margin-bottom: 15px;
        }
        .table-data th, .table-data td {
            border: 1px solid #000;
            padding: 4px 6px;
        }
        .table-data th {
            background-color: #f1f5f9;
            text-align: center;
            font-weight: bold;
        }

        .footer-sig {
            width: 100%;
            margin-top: 20px;
            page-break-inside: avoid;
        }

        .seal-stamp {
            border: 2px solid #b91c1c;
            border-radius: 50%;
            width: 90px;
            height: 90px;
            color: #b91c1c;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 5px auto;
            transform: rotate(-5deg);
            font-family: Arial, sans-serif;
        }

        @@media print {
            .no-print-bar { display: none !important; }
            body { background: #fff; padding: 0; }
            .a4-landscape {
                width: 100%;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <div class="no-print-bar">
        <div>
            <strong>BIỂU MẪU 01 (BM01)</strong> | Báo cáo Sơ yếu Lý lịch Trích ngang CBCNV Toàn tập đoàn Vinamilk
        </div>
        <div style="display: flex; gap: 10px;">
            <button onclick="window.print();" class="btn-action btn-print">
                <i class="bi bi-printer-fill"></i> In Bản Báo Cáo A4 Ngang
            </button>
            <a href="/AdministrativeReports/Index" class="btn-action btn-back">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div style="height: 50px;" class="d-print-none"></div>

    <div class="a4-landscape">
        <!-- Header -->
        <table class="report-header">
            <tr>
                <td style="width: 45%; vertical-align: top;">
                    <strong>CÔNG TY CP SỮA VIỆT NAM (VINAMILK)</strong><br />
                    <strong>KHỐI QUẢN TRỊ NGUỒN NHÂN LỰC (HRM)</strong><br />
                    Đơn vị: <strong>@ViewBag.CurrentUnitName</strong>
                </td>
                <td style="width: 55%; text-align: center; vertical-align: top;">
                    <strong>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</strong><br />
                    <strong>Độc lập - Tự do - Hạnh phúc</strong><br />
                    -------------------------
                </td>
            </tr>
        </table>

        <div class="report-title">BÁO CÁO TRÍCH NGANG NHÂN SỰ CÁN BỘ CÔNG NHÂN VIÊN</div>
        <div class="report-subtitle">(Kèm theo Quy chế Quản trị Nhân sự & Lưu trữ Hồ sơ Tập đoàn Vinamilk - Kỳ năm @DateTime.UtcNow.Year)</div>

        <!-- Bảng trích ngang -->
        <table class="table-data">
            <thead>
                <tr>
                    <th style="width: 3%;">STT</th>
                    <th style="width: 8%;">Mã NV</th>
                    <th style="width: 14%;">Họ và tên</th>
                    <th style="width: 8%;">Ngày sinh</th>
                    <th style="width: 5%;">Phái</th>
                    <th style="width: 9%;">Số CCCD</th>
                    <th style="width: 13%;">Đơn vị công tác</th>
                    <th style="width: 8%;">Khối NS</th>
                    <th style="width: 9%;">Lương cơ bản</th>
                    <th style="width: 7%;">Phụ cấp</th>
                    <th style="width: 5%;">Người PT</th>
                    <th style="width: 5%;">Phép năm</th>
                    <th style="width: 6%;">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model)
                {
                    <tr>
                        <td style="text-align: center;">@(stt++)</td>
                        <td style="text-align: center; font-weight: bold; color: #0047BA;">@emp.EmployeeCode</td>
                        <td><strong>@emp.FullName</strong></td>
                        <td style="text-align: center;">@emp.DateOfBirth.ToString("dd/MM/yyyy")</td>
                        <td style="text-align: center;">@(emp.Gender == VinamilkHRM.Domain.Enums.Gender.Male ? "Nam" : "Nữ")</td>
                        <td style="text-align: center;">@emp.CitizenId</td>
                        <td>@(emp.OrganizationalUnit?.UnitName ?? "Vinamilk")</td>
                        <td style="text-align: center;">@emp.EmployeeType</td>
                        <td style="text-align: right; font-weight: 600;">@emp.BaseSalary.ToString("N0")</td>
                        <td style="text-align: right;">@emp.Allowance.ToString("N0")</td>
                        <td style="text-align: center;">@emp.DependentCount</td>
                        <td style="text-align: center;">@emp.AnnualLeaveBalance</td>
                        <td style="text-align: center;">@(emp.IsActive ? "Chính thức" : "Đã nghỉ")</td>
                    </tr>
                }
                <tr style="background-color: #f8fafc; font-weight: bold;">
                    <td colspan="8" style="text-align: right;">TỔNG CỘNG (@Model.Count nhân sự):</td>
                    <td style="text-align: right; color: #0047BA;">@totalSalary.ToString("N0") đ</td>
                    <td style="text-align: right;">@totalAllowance.ToString("N0") đ</td>
                    <td colspan="3"></td>
                </tr>
            </tbody>
        </table>

        <!-- Chữ ký điện tử -->
        <table class="footer-sig">
            <tr>
                <td style="width: 33%; text-align: center; vertical-align: top;">
                    <strong>NGƯỜI LẬP BIỂU</strong><br />
                    <i>(Ký và ghi rõ họ tên)</i><br /><br /><br /><br />
                    <strong>Chuyên viên Nhân sự C&B</strong>
                </td>
                <td style="width: 33%; text-align: center; vertical-align: top;">
                    <strong>TRƯỞNG PHÒNG TỔ CHỨC CÁN BỘ</strong><br />
                    <i>(Ký duyệt thẩm định)</i><br /><br /><br /><br />
                    <strong>Trần Đình Phúc</strong>
                </td>
                <td style="width: 34%; text-align: center; vertical-align: top;">
                    <i>TP. Hồ Chí Minh, ngày @DateTime.UtcNow.Day tháng @DateTime.UtcNow.Month năm @DateTime.UtcNow.Year</i><br />
                    <strong>TM. HỘI ĐỒNG QUẢN TRỊ / BAN ĐIỀU HÀNH</strong><br />
                    <strong>GIÁM ĐỐC NHÂN SỰ TẬP ĐOÀN</strong><br />
                    <div class="seal-stamp">
                        <div style="font-size: 7px; font-weight: bold;">CÔNG TY CP SỮA VN</div>
                        <div style="font-size: 13px;">★ ★ ★</div>
                        <div style="font-size: 7px; font-weight: bold;">ĐÃ KÝ ĐIỆN TỬ</div>
                    </div>
                    <strong>Nguyễn Thị Thanh Huyền</strong>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
