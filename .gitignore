# =====================================================================
# VINAMILK HRM - ENTERPRISE .GITIGNORE
# =====================================================================

# 1. Environment and Secrets
.env
.env.*
!.env.example
cookies.txt
*.cookie
*.key
*.pem
*.crt
*.cert
*.pfx

# 2. Dependencies & Package Managers
vendor/
/vendor/
node_modules/
/node_modules/
npm-debug.log
yarn-error.log
phpunit.phar
composer.phar

# 3. Uploads & Temporary Media
uploads/
/uploads/
public/uploads/
/public/uploads/

# 4. Binary & Build Outputs (.NET / C# / Executables)
**/bin
**/bin/**
**/obj
**/obj/**
bin/
obj/
*.exe
*.dll
*.pdb
.vs/

# 5. Storage & Logs
/storage/*.key
/storage/logs/*
!/storage/logs/.gitignore
logs/
*.log

# 6. Database Dumps & Backups
*.dump
*.tar.gz
*.zip
/backup/
/backups/

# 7. IDE & OS Metadata
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
